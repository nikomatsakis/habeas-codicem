{
  "requirement": "The `[authoring]` table MUST serialize UserAuthoringConfig. Each\n`[authoring.configs.<name>]` table MUST serialize one AuthoringConfig, with\n`backend = \"bedrock\"` or `backend = \"ollama\"` and that variant's fields in the same\ntable. Backend-specific inference options MUST appear in its `options` subtable.\nWithin a present authoring section, `configs` MUST be present but MAY be empty;\nomitted `projects` and `options` tables MUST deserialize as empty maps.\nSerialization MUST follow the common rules in\n{cite}`requirements.configuration.serialization`.",
  "determination": true,
  "rationale": "The serde representations serialize authoring configs with a lowercase flattened backend tag and provider fields in the same table; configs is required and omitted projects/options become empty maps. Round-trip tests verify these semantics and preserve explicit versus omitted connection settings.",
  "inputs": [
    {
      "rust_file": "src/config.rs",
      "rust_item": "impl[UserConfig]/fn[to_toml]",
      "text": [
        "    // {impl}`requirements.configuration.serialization`",
        "    // {impl}`requirements.authoring.configuration_serialization`",
        "    pub fn to_toml(&self) -> io::Result<String> {",
        "        self.validate(Path::new(\"user configuration\"))?;",
        "        toml::to_string_pretty(self)",
        "            .map_err(|error| invalid(Path::new(\"user configuration\"), \"\", error))",
        "    }"
      ]
    },
    {
      "rust_file": "tests/configuration.rs",
      "rust_item": "fn[backend_configuration_round_trips_without_materializing_defaults]",
      "text": [
        "// {test}`requirements.authoring.configuration_structure`",
        "// {test}`requirements.authoring.configuration_serialization`",
        "// {test}`requirements.configuration.serialization`",
        "#[test]",
        "fn backend_configuration_round_trips_without_materializing_defaults() {",
        "    let source = r#\"",
        "version = 1",
        "[authoring]",
        "default = \"Cloud\"",
        "[authoring.configs.Cloud]",
        "backend = \"bedrock\"",
        "model = \"arn:aws:bedrock:us-west-2:123:inference-profile/exact-id\"",
        "aws_profile = \"research\"",
        "region = \"us-west-2\"",
        "[authoring.configs.Cloud.options]",
        "temperature = 0.2",
        "max_tokens = 777",
        "enabled = true",
        "labels = [\"a\", \"b\"]",
        "[authoring.configs.Cloud.options.custom]",
        "arbitrary = \"provider-defined\"",
        "[authoring.configs.local]",
        "backend = \"ollama\"",
        "model = \"tiny:latest\"",
        "\"#;",
        "    let path = Path::new(\"settings.toml\");",
        "    let config = UserConfig::parse(source, path).unwrap();",
        "    let authoring = config.authoring.as_ref().unwrap();",
        "    assert!(authoring.projects.is_empty());",
        "    let local = &authoring.configs[\"local\"].backend;",
        "    let BackendConfig::Ollama(ollama) = local else {",
        "        panic!(\"wrong backend\")",
        "    };",
        "    assert_eq!(ollama.endpoint(), \"http://localhost:11434\");",
        "    assert_eq!(ollama.endpoint, None);",
        "    assert!(ollama.options.is_empty());",
        "    assert_eq!(local.model_ref().model, \"tiny:latest\");",
        "    assert_eq!(local.model_ref().backend, BackendKind::Ollama);",
        "    let json = authoring.configs[\"Cloud\"].backend.options_json().unwrap();",
        "    assert_eq!(json[\"custom\"][\"arbitrary\"], \"provider-defined\");",
        "    assert_eq!(json[\"max_tokens\"], 777);",
        "    let serialized = config.to_toml().unwrap();",
        "    assert!(!serialized.contains(\"endpoint\"));",
        "    assert!(!serialized.contains(\"http://localhost\"));",
        "    assert_eq!(UserConfig::parse(&serialized, path).unwrap(), config);",
        "}"
      ]
    }
  ]
}
