        "    assert_eq!(",
        "        book[\"output\"][\"html\"][\"fold\"][\"enable\"].as_bool(),",
        "        Some(true)",
        "    );",
        "    assert_eq!(book.to_string().matches(\"enable\").count(), 1, \"{book}\");",
        "}"
