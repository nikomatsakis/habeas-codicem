    {
      "rust_file": "src/authoring/inputs.rs",
      "rust_item": "impl[AssessmentSources]/fn[prepare]",
      "text": [
        "    // {impl}`requirements.authoring.invocation`",
        "    // {impl}`requirements.authoring.mandatory_inputs`",
        "    // {impl}`requirements.authoring_input`",
        "    // {impl}`requirements.examples.authoring_inputs`",
        "    // {impl}`requirements.references.authoring_inputs`",
        "    // {impl}`requirements.definitions.authoring_inputs`",
        "    // {impl}`requirements.ci.authoring_inputs`",
        "    pub(crate) fn prepare(root: &Path, subject_name: &str) -> Result<Self, String> {",
        "        let root = fs::canonicalize(root).map_err(|error| format!(\"project root: {error}\"))?;",
        "        let definitions = load_definitions(&root).map_err(|error| error.to_string())?;",
        "        let subject = definitions",
        "            .get(subject_name)",
        "            .filter(|definition| definition.kind != DefinitionKind::Term)",
        "            .ok_or_else(|| format!(\"{subject_name}: no matching requirement or named example\"))?;",
        "        let mut selectors = vec![InputSelector::Requirements {",
        "            requirements: subject_name.to_owned(),",
        "        }];",
        "",
        "        for reference in crate::reference_roles(&subject.text, true) {",
        "            if reference.kind == ReferenceKind::Term {",
        "                continue;",
        "            }",
        "            if !definitions",
        "                .get(reference.name)",
        "                .is_some_and(|definition| definition.kind != DefinitionKind::Term)",
        "            {",
        "                return Err(format!(",
        "                    \"{subject_name}: referenced subject {} does not exist\",",
        "                    reference.name",
        "                ));",
        "            }",
        "            insert_selector(",
        "                &mut selectors,",
        "                InputSelector::Requirements {",
        "                    requirements: reference.name.to_owned(),",
        "                },",
        "            );",
        "        }",
        "",
        "        let mut errors = Vec::new();",
        "        let references = collect_references(&root, &mut errors);",
        "        if !errors.is_empty() {",
        "            return Err(errors.join(\"\\n\"));",
        "        }",
        "        for reference in references.iter().filter(|reference| {",
        "            reference.name == subject_name && reference.kind != ReferenceKind::Term",
        "        }) {",
        "            insert_selector(",
        "                &mut selectors,",
        "                reference_selector(&root, &definitions, reference)?,",
        "            );",
        "        }",
        "",
        "        let evidence_path = root.join(\"evidence\").join(format!(\"{subject_name}.json\"));",
        "        match fs::read_to_string(&evidence_path) {",
        "            Ok(content) => {",
        "                let evidence: Value = serde_json::from_str(&content)",
        "                    .map_err(|error| format!(\"{}: {error}\", evidence_path.display()))?;",
        "                let inputs = evidence",
        "                    .get(\"inputs\")",
        "                    .and_then(Value::as_array)",
        "                    .ok_or_else(|| {",
        "                        format!(",
        "                            \"{}: existing evidence inputs must be an array\",",
        "                            evidence_path.display()",
        "                        )",
        "                    })?;",
        "                for (index, input) in inputs.iter().enumerate() {",
        "                    let selector = InputSelector::from_input(input).ok_or_else(|| {",
        "                        format!(",
        "                            \"{}: inputs[{index}] has no resolvable selector\",",
        "                            evidence_path.display()",
        "                        )",
        "                    })?;",
        "                    insert_selector(&mut selectors, selector);",
        "                }",
        "            }",
        "            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}",
        "            Err(error) => return Err(format!(\"{}: {error}\", evidence_path.display())),",
        "        }",
        "",
        "        let mut mandatory = Vec::new();",
        "        for selector in selectors {",
        "            let resolved = selector.resolve(&root, &definitions)?;",
        "            mandatory.push(selector.to_input(&resolved));",
        "        }",
        "        let dependencies = definition_inputs(&root, &definitions, &mandatory, Some(&subject.text))?;",
        "        for input in dependencies {",
        "            if !mandatory.contains(&input) {",
        "                mandatory.push(input);",
        "            }",
        "        }",
        "        Ok(Self {",
        "            root,",
        "            subject_name: subject_name.to_owned(),",
        "            subject_kind: subject.kind,",
        "            subject_text: subject.text.clone(),",
        "            mandatory,",
        "            recorded: Vec::new(),",
        "        })",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/mod.rs",
      "rust_item": "fn[author_evidence]",
      "text": [
        "// {impl}`requirements.authoring.invocation`",
        "pub async fn author_evidence(",
        "    root: &Path,",
        "    subject: &str,",
        "    selection: Option<&str>,",
        ") -> io::Result<AuthoringOutcome> {",
        "    author_evidence_with_output(root, subject, selection, EvidenceOutput::File).await",
        "}"
      ]
    },
    {
      "rust_file": "src/authoring/mod.rs",
      "rust_item": "fn[configured_assessment]",
      "text": [
        "// {impl}`requirements.authoring.invocation`",
        "// {impl}`requirements.authoring.configuration_precedence`",
        "// {impl}`requirements.authoring.rig_configuration_mapping`",
        "// {impl}`requirements.authoring.usage_storage`",
        "async fn configured_assessment(",
        "    root: &Path,",
        "    subject: &str,",
        "    selection: Option<&str>,",
        "    output: EvidenceOutput,",
        "    usage: &mut UsageLog,",
        ") -> io::Result<AuthoringOutcome> {",
        "    let config = config::resolve_authoring(root, selection)?;",
        "    let model = config.model_ref();",
        "    let backend = match model.backend {",
        "        BackendKind::Bedrock => \"bedrock\",",
        "        BackendKind::Ollama => \"ollama\",",
        "    };",
        "    usage.record.backend = Some(backend.into());",
        "    usage.record.model = Some(model.model.clone());",
        "    let mut sources = AssessmentSources::prepare(root, subject).map_err(io::Error::other)?;",
        "    usage.record.subject_kind = Some(sources.subject_kind.noun().into());",
        "    usage.prepared(\"mandatory\", sources.mandatory_inputs());",
        "    usage.save()?;",
        "    let provider = RigProvider::connect(&config.backend)",
        "        .await",
        "        .map_err(|error| {",
        "            io::Error::other(format!(",
        "                \"{}: authoring.configs.{}: {error}\",",
        "                config.config_path.display(),",
        "                config.name",
        "            ))",
        "        })?;",
        "    let (determination, evidence_path) =",
        "        assess(&provider, root, &mut sources, output, usage).await?;",
        "    Ok(AuthoringOutcome {",
        "        subject: subject.into(),",
        "        backend: backend.into(),",
        "        model: model.model,",
        "        evidence_path,",
        "        usage_path: usage.path.clone(),",
        "        determination,",
        "    })",
        "}"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "fn[main]",
      "text": [
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    match Cli::parse().command {",
        "        // {impl}`requirements.cli.mdbook`",
        "        Command::Mdbook { command: None } => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { renderer }),",
        "        } => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }",
        "        // {impl}`requirements.cli.setup`",
        "        Command::Setup { path } => setup::run(path.as_deref()),",
        "        // {impl}`requirements.cli.status`",
        "        Command::Status { all, glob } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout().lock().write_all(",
        "                habeas::status_markdown_filtered(&root, all, glob.as_deref())?.as_bytes(),",
        "            )?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.info`",
        "        Command::Info { selector } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::info_markdown(&root, &selector)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.authoring.invocation`",
        "        Command::AuthorEvidence {",
        "            subject,",
        "            config,",
        "            stdout,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            let output = if stdout {",
        "                habeas::authoring::EvidenceOutput::Stdout",
        "            } else {",
        "                habeas::authoring::EvidenceOutput::File",
        "            };",
        "            let outcome = tokio::runtime::Runtime::new()?.block_on(",
        "                habeas::authoring::author_evidence_with_output(",
        "                    &root,",
        "                    &subject,",
        "                    config.as_deref(),",
        "                    output,",
        "                ),",
        "            )?;",
        "            let summary = format!(",
        "                \"{}: {} / {} — {}\",",
        "                outcome.subject,",
        "                outcome.backend,",
        "                outcome.model,",
        "                outcome.determination.kind(),",
        "            );",
        "            if let Some(path) = outcome.evidence_path {",
        "                println!(",
        "                    \"{summary}\\nEvidence: {}\\nUsage: {}\",",
        "                    path.display(),",
        "                    outcome.usage_path.display()",
        "                );",
        "            } else {",
        "                eprintln!(",
        "                    \"{summary}\\nEvidence: stdout\\nUsage: {}\",",
        "                    outcome.usage_path.display()",
        "                );",
        "            }",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.integration.symposium_setup_hook`",
        "        Command::Hook {",
        "            command: HookCommand::SessionStart,",
        "        } => hook::session_start(),",
        "        // {impl}`requirements.cli.add_input`",
        "        Command::AddInput {",
        "            for_requirement,",
        "            for_example,",
        "            for_rust_item,",
        "            file_range,",
        "            rust_item,",
        "            requirements,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            let target = if let Some(name) = for_requirement {",
        "                habeas::InputTarget::Requirement(name)",
        "            } else if let Some(name) = for_example {",
        "                habeas::InputTarget::Example(name)",
        "            } else {",
        "                let parts = for_rust_item.expect(\"clap requires a target\");",
        "                habeas::InputTarget::RustFunction {",
        "                    rust_file: parts[0].clone(),",
        "                    rust_item: parts[1].clone(),",
        "                }",
        "            };",
        "            let mode = if let Some(specification) = file_range {",
        "                habeas::InputMode::FileRange(specification)",
        "            } else if let Some(specification) = rust_item {",
        "                habeas::InputMode::RustItemsAtLine(specification)",
        "            } else {",
        "                habeas::InputMode::Requirements(requirements.expect(\"clap requires an input mode\"))",
        "            };",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::add_input(&root, target, mode)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "    }",
        "}"
      ]
    },
