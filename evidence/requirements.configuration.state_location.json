      "rust_file": "tests/configuration.rs",
      "rust_item": "fn[locations_use_absolute_xdg_values_and_platform_fallbacks]",
      "text": [
        "// {test}`requirements.configuration.user_location`",
        "// {test}`requirements.configuration.state_location`",
        "#[test]",
        "fn locations_use_absolute_xdg_values_and_platform_fallbacks() {",
        "    let dir = tempfile::tempdir().unwrap();",
        "    let home = dir.path().join(\"home\");",
        "    let config = dir.path().join(\"config\");",
        "    let state = dir.path().join(\"state\");",
        "    let vars = BTreeMap::from([",
        "        (\"HOME\", home.as_os_str().to_owned()),",
        "        (\"XDG_CONFIG_HOME\", config.as_os_str().to_owned()),",
        "        (\"XDG_STATE_HOME\", state.as_os_str().to_owned()),",
        "    ]);",
        "    let lookup = |name: &str| vars.get(name).cloned();",
        "    assert_eq!(",
        "        user_config_path_from(ConfigPlatform::Unix, lookup).unwrap(),",
        "        config.join(\"habeas/config.toml\")",
        "    );",
        "    assert_eq!(",
        "        state_root_from(ConfigPlatform::Unix, lookup).unwrap(),",
        "        state.join(\"habeas\")",
        "    );",
        "    for invalid_xdg in [\"\", \"relative\"] {",
        "        let lookup = |name: &str| {",
        "            Some(if name == \"HOME\" {",
        "                home.as_os_str().to_owned()",
        "            } else {",
        "                OsString::from(invalid_xdg)",
        "            })",
        "        };",
        "        assert_eq!(",
        "            user_config_path_from(ConfigPlatform::Unix, lookup).unwrap(),",
        "            home.join(\".config/habeas/config.toml\")",
        "        );",
        "        assert_eq!(",
        "            state_root_from(ConfigPlatform::Unix, lookup).unwrap(),",
        "            home.join(\".local/state/habeas\")",
        "        );",
        "    }",
        "    let windows = |name: &str| match name {",
        "        \"APPDATA\" => Some(config.as_os_str().to_owned()),",
        "        \"LOCALAPPDATA\" => Some(state.as_os_str().to_owned()),",
        "        _ => None,",
        "    };",
        "    assert_eq!(",
        "        user_config_path_from(ConfigPlatform::Windows, windows).unwrap(),",
        "        config.join(\"habeas/config.toml\")",
        "    );",
        "    assert_eq!(",
        "        state_root_from(ConfigPlatform::Windows, windows).unwrap(),",
        "        state.join(\"habeas/state\")",
        "    );",
        "    assert!(user_config_path_from(ConfigPlatform::Unix, |_| None).is_err());",
        "    assert!(state_root_from(ConfigPlatform::Windows, |_| None).is_err());",
        "}"
      ]
    },
    {
      "rust_file": "src/authoring/mod.rs",
      "rust_item": "fn[author_evidence_with_output]",
      "text": [
        "// {impl}`requirements.authoring.invocation`",
        "// {impl}`requirements.authoring.usage_storage`",
        "// {impl}`requirements.configuration.state_location`",
        "pub async fn author_evidence_with_output(",
        "    root: &Path,",
        "    subject: &str,",
        "    selection: Option<&str>,",
        "    output: EvidenceOutput,",
        ") -> io::Result<AuthoringOutcome> {",
        "    let root = fs::canonicalize(root)?;",
        "    let state = config::state_root()?;",
        "    fs::create_dir_all(&state)?;",
        "    if fs::canonicalize(&state)?.starts_with(&root) {",
        "        return Err(io::Error::other(",
        "            \"authoring usage state must be outside the project repository\",",
        "        ));",
        "    }",
        "    let mut usage = UsageLog::start(&state, &root, subject)?;",
        "    usage.record.evidence_output = match output {",
        "        EvidenceOutput::File => \"file\",",
        "        EvidenceOutput::Stdout => \"stdout\",",
        "    };",
        "    usage.save()?;",
        "    let result = tokio::select! {",
        "        result = configured_assessment(&root, subject, selection, output, &mut usage) => result,",
        "        signal = tokio::signal::ctrl_c() => {",
        "            match signal {",
        "                Ok(()) => Err(io::Error::new(io::ErrorKind::Interrupted, \"evidence authoring cancelled\")),",
        "                Err(error) => Err(error),",
        "            }",
        "        }",
        "    };",
        "    let outcome = match &result {",
        "        Ok(_) => \"completed\",",
        "        Err(error) if error.kind() == io::ErrorKind::Interrupted => \"cancelled\",",
        "        Err(_) => \"failed\",",
        "    };",
        "    usage.finish(outcome).map_err(|error| {",
        "        io::Error::other(format!(",
        "            \"cannot record usage at {} (evidence written: {}): {error}\",",
        "            usage.path.display(),",
        "            usage.record.evidence_written",
        "        ))",
        "    })?;",
        "    result.map_err(|error| {",
        "        io::Error::new(",
        "            error.kind(),",
        "            format!(\"{error}; usage: {}\", usage.path.display()),",
        "        )",
        "    })",
        "}"
      ]
    }
  ]
