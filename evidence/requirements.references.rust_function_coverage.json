      "rust_file": "src/rust_coverage.rs",
      "rust_item": "mod[tests]/fn[finds_uncited_functions_without_using_enclosing_or_string_references]",
      "text": [
        "    // {test}`requirements.references.rust_function_coverage`",
        "    #[test]",
        "    fn finds_uncited_functions_without_using_enclosing_or_string_references() {",
        "        let source = r##\"",
        "// @impl@`requirements.example`",
        "mod feature {",
        "    // @impl@`requirements.example`",
        "    impl Widget {",
        "        fn missing_method() {}",
        "    }",
        "",
        "    struct Widget;",
        "    impl Widget {",
        "        // @impl@`requirements.example`",
        "        fn cited_method() {}",
        "    }",
        "",
        "    fn containing_string() {",
        "        let _ = \"// @impl@`requirements.example`\";",
        "        let _ = r#\"/* @impl@`requirements.example` */\"#;",
        "        let _ = '/';",
        "    }",
        "",
        "    fn unknown_reference() {",
        "        // @impl@`requirements.unknown`",
        "    }",
        "",
        "    fn body_reference() {",
        "        /* @impl@`requirements.example` */",
        "    }",
        "",
        "    // @impl@`requirements.example`",
        "",
        "    fn distant_comment() {}",
