      "rust_file": "src/rust_coverage.rs",
      "rust_item": "fn[comments]",
      "text": [
        "// {impl}`requirements.references.rust_function_coverage`",
        "pub(crate) fn comments(source: &str) -> Vec<Range<usize>> {",
        "    let bytes = source.as_bytes();",
        "    let mut ranges = Vec::new();",
        "    let mut position = 0;",
        "    while position < bytes.len() {",
        "        match (bytes[position], bytes.get(position + 1)) {",
        "            (b'/', Some(b'/')) => {",
        "                let start = position;",
        "                position += 2;",
        "                while bytes.get(position).is_some_and(|byte| *byte != b'\\n') {",
        "                    position += 1;",
        "                }",
        "                ranges.push(start..position);",
        "            }",
        "            (b'/', Some(b'*')) => {",
        "                let start = position;",
        "                let mut depth = 1;",
        "                position += 2;",
        "                while position < bytes.len() && depth > 0 {",
        "                    match (bytes[position], bytes.get(position + 1)) {",
        "                        (b'/', Some(b'*')) => {",
        "                            depth += 1;",
        "                            position += 2;",
        "                        }",
        "                        (b'*', Some(b'/')) => {",
        "                            depth -= 1;",
        "                            position += 2;",
        "                        }",
        "                        _ => position += 1,",
        "                    }",
        "                }",
        "                ranges.push(start..position);",
        "            }",
        "            (b'r' | b'b' | b'c', _) => {",
        "                position = raw_string_end(bytes, position).unwrap_or(position + 1);",
        "            }",
        "            (b'\"', _) => position = quoted_end(bytes, position),",
        "            (b'\\'', _) => {",
        "                position = char_end(source, position).unwrap_or(position + 1);",
        "            }",
        "            _ => position += 1,",
        "        }",
        "    }",
        "    ranges",
        "}"
      ]
    },
