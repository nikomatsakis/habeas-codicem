      "rust_file": "src/rust_coverage.rs",
      "rust_item": "fn[quoted_end]",
      "text": [
        "// {impl}`requirements.references.rust_function_coverage`",
        "fn quoted_end(bytes: &[u8], start: usize) -> usize {",
        "    let mut position = start + 1;",
        "    while position < bytes.len() {",
        "        match bytes[position] {",
        "            b'\\\\' => position = (position + 2).min(bytes.len()),",
        "            b'\"' => return position + 1,",
        "            _ => position += 1,",
        "        }",
        "    }",
        "    bytes.len()",
        "}"
      ]
    },
    {
      "rust_file": "src/rust_coverage.rs",
      "rust_item": "fn[raw_string_end]",
      "text": [
        "// {impl}`requirements.references.rust_function_coverage`",
        "fn raw_string_end(bytes: &[u8], start: usize) -> Option<usize> {",
        "    let mut position = match bytes.get(start..) {",
        "        Some([b'r', ..]) => start + 1,",
        "        Some([b'b' | b'c', b'r', ..]) => start + 2,",
        "        _ => return None,",
        "    };",
        "    let mut hashes = 0;",
        "    while bytes.get(position) == Some(&b'#') {",
        "        hashes += 1;",
        "        position += 1;",
        "    }",
        "    if bytes.get(position) != Some(&b'\"') {",
        "        return None;",
        "    }",
        "    position += 1;",
        "    while position < bytes.len() {",
        "        if bytes[position] == b'\"'",
        "            && bytes",
        "                .get(position + 1..position + 1 + hashes)",
        "                .is_some_and(|suffix| suffix.iter().all(|byte| *byte == b'#'))",
        "        {",
        "            return Some(position + 1 + hashes);",
        "        }",
        "        position += 1;",
        "    }",
        "    Some(bytes.len())",
        "}"
      ]
    },
