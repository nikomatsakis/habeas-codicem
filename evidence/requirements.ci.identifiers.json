        "// {impl}`requirements.ci.identifiers`",
        "fn valid_name(name: &str) -> bool {",
        "    !name.is_empty()",
        "        && name.split('.').all(|part| {",
        "            !part.is_empty()",
        "                && part",
        "                    .bytes()",
        "                    .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))",
        "        })",
        "}",
        ""
      ]
