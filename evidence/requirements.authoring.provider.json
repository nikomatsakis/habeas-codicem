      "rust_item": "impl[Server]/fn[start]",
      "text": [
        "    // {test}`requirements.authoring.provider`",
        "    // {test}`requirements.authoring.rig_configuration_mapping`",
        "    fn start(responses: Vec<Value>) -> Self {",
        "        Self::start_with(responses, || {})",
        "    }"
      ]
