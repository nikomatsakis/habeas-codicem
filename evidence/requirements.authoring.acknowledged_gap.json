        "",
        "    let evidence: Value = serde_json::from_slice(&fs::read(&fixture.evidence).unwrap()).unwrap();",
        "    assert_eq!(evidence[\"determination\"], json!({\"FIXME\":[\"#125\"]}));",
        "    assert_eq!(evidence[\"requirement\"], REQUIREMENT);",
