        "    let output = Command::new(env!(\"CARGO_BIN_EXE_habeas\"))",
        "        .current_dir(&project)",
        "        .args([",
        "            \"author-evidence\",",
        "            SUBJECT,",
        "            \"--config\",",
        "            &selected.name,",
        "            \"--stdout\",",
        "        ])",
        "        .output()",
        "        .unwrap();",
        "    let stderr = String::from_utf8_lossy(&output.stderr);",
        "    report(&stderr);",
        "    assert!(",
        "        output.status.success(),",
        "        \"live Bedrock authoring failed: {stderr}\"",
