        "        fs::create_dir_all(directory).unwrap();",
        "    }",
        "    fs::write(",
        "        project.join(\"Cargo.toml\"),",
        "        \"[package]\\nname = 'live-fixture'\\nversion = '0.1.0'\\nedition = '2024'\\n\",",
