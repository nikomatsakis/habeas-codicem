        "                \"rationale\": \"checks_case sets up ready and asserts the result.\",",
        "                \"inputs\": [{",
        "                    \"file\": \"src/main.rs\",",
        "                    \"line_start\": 1,",
        "                    \"line_end\": 3,",
        "                    \"text\": test_source.lines().collect::<Vec<_>>()",
