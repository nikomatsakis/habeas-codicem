        "// {impl}`requirements.references.targets`",
        "pub(crate) fn collect_references(root: &Path, errors: &mut Vec<String>) -> Vec<SourceReference> {",
        "    let mut stack = vec![root.to_path_buf()];",
        "    let mut files = Vec::new();",
        "    while let Some(directory) = stack.pop() {",
        "        let entries = match fs::read_dir(&directory) {",
        "            Ok(entries) => entries,",
        "            Err(error) => {",
        "                errors.push(format!(",
        "                    \"{}: cannot scan references: {error}\",",
        "                    display_path(root, &directory)",
        "                ));",
        "                continue;",
        "            }",
        "        };",
        "        for entry in entries {",
        "            let entry = match entry {",
        "                Ok(entry) => entry,",
        "                Err(error) => {",
        "                    errors.push(format!(",
        "                        \"{}: cannot scan directory entry: {error}\",",
        "                        display_path(root, &directory)",
        "                    ));",
        "                    continue;",
        "                }",
        "            };",
        "            let path = entry.path();",
        "            let kind = match entry.file_type() {",
        "                Ok(kind) => kind,",
        "                Err(error) => {",
        "                    errors.push(format!(",
        "                        \"{}: cannot inspect reference source: {error}\",",
        "                        display_path(root, &path)",
        "                    ));",
        "                    continue;",
        "                }",
        "            };",
        "            if kind.is_dir() {",
        "                let excluded = directory == root",
        "                    && matches!(",
        "                        entry.file_name().to_str(),",
        "                        Some(\".git\" | \"target\" | \"book\" | \"evidence\")",
        "                    );",
        "                if !excluded {",
        "                    stack.push(path);",
        "                }",
        "            } else if kind.is_file() {",
        "                files.push(path);",
        "            }",
        "        }",
        "    }",
        "    files.sort();",
        "",
        "    let mut references = Vec::new();",
        "    for file in files {",
        "        let content = match fs::read_to_string(&file) {",
        "            Ok(content) => content,",
        "            Err(error) if error.kind() == io::ErrorKind::InvalidData => continue,",
        "            Err(error) => {",
        "                errors.push(format!(",
        "                    \"{}: cannot read reference source: {error}\",",
        "                    display_path(root, &file)",
        "                ));",
        "                continue;",
        "            }"
      ]
