        "// {impl}`requirements.configuration.user_location`",
        "// {impl}`requirements.configuration.state_location`",
        "fn absolute_directory(lookup: &impl Fn(&str) -> Option<OsString>, name: &str) -> Option<PathBuf> {",
        "    lookup(name)",
        "        .map(PathBuf::from)",
        "        .filter(|path| path.is_absolute())",
        "}"
      ]
