    {
      "rust_file": "src/authoring/tools.rs",
      "rust_item": "fn[project_path]",
      "text": [
        "// {impl}`requirements.authoring.file_discovery`",
        "// {impl}`requirements.authoring.text_search`",
        "// {impl}`requirements.ci.input_containment`",
        "fn project_path(root: &Path, relative: &str) -> Result<PathBuf, String> {",
        "    if relative.is_empty()",
        "        || !Path::new(relative)",
        "            .components()",
        "            .all(|part| matches!(part, Component::Normal(_) | Component::CurDir))",
        "    {",
        "        return Err(\"path must be relative to the project\".to_owned());",
        "    }",
        "    let path = fs::canonicalize(root.join(relative))",
        "        .map_err(|error| format!(\"cannot open {relative}: {error}\"))?;",
        "    if !path.starts_with(root) {",
        "        return Err(format!(\"{relative} resolves outside the project\"));",
        "    }",
        "    Ok(path)",
        "}"
      ]
    },
    {
      "rust_file": "src/authoring/tools.rs",
      "rust_item": "fn[relative_path]",
      "text": [
        "// {impl}`requirements.authoring.file_discovery`",
        "// {impl}`requirements.authoring.text_search`",
        "fn relative_path(root: &Path, path: &Path) -> Result<String, String> {",
        "    path.strip_prefix(root)",
        "        .map_err(|_| \"path is outside the project\".to_owned())?",
        "        .components()",
        "        .filter(|part| *part != Component::CurDir)",
        "        .collect::<PathBuf>()",
        "        .to_str()",
        "        .map(str::to_owned)",
        "        .ok_or_else(|| \"path is not UTF-8\".to_owned())",
        "}"
      ]
    },
    {
      "rust_file": "src/authoring/tools.rs",
      "rust_item": "mod[tests]/fn[search_merges_context_windows_and_respects_ignore_rules]",
      "text": [
        "    // {test}`requirements.authoring.text_search`",
        "    // {test}`requirements.authoring.additional_read`",
        "    #[test]",
        "    fn search_merges_context_windows_and_respects_ignore_rules() {",
        "        let root = project();",
        "        fs::create_dir(root.path().join(\".git\")).unwrap();",
        "        fs::write(root.path().join(\".gitignore\"), \"ignored.txt\\n\").unwrap();",
        "        fs::write(root.path().join(\"ignored.txt\"), \"needle\\n\").unwrap();",
        "        fs::write(root.path().join(\".hidden.txt\"), \"needle\\n\").unwrap();",
        "        let lines = (1..=20)",
        "            .map(|number| {",
        "                if number == 2 || number == 6 {",
        "                    \"needle\".to_owned()",
        "                } else {",
        "                    format!(\"line {number}\")",
        "                }",
        "            })",
        "            .collect::<Vec<_>>();",
        "        fs::write(root.path().join(\"sample.txt\"), lines.join(\"\\n\")).unwrap();",
        "        let sources = AssessmentSources::prepare(root.path(), \"requirements.ready\").unwrap();",
        "        let search = dispatch(&sources, \"ripgrep\", &json!({\"pattern\":\"needle\"})).unwrap();",
        "        assert_eq!(search.inputs.len(), 1);",
        "        assert_eq!(search.inputs[0][\"file\"], \"sample.txt\");",
        "        assert_eq!(search.inputs[0][\"line_start\"], 1);",
        "        assert_eq!(search.inputs[0][\"line_end\"], 11);",
        "        assert_eq!(search.inputs[0][\"text\"], json!(&lines[..11]));",
        "        let exact = dispatch(",
        "            &sources,",
        "            \"ripgrep\",",
        "            &json!({\"pattern\":\"needle\",\"path\":\"sample.txt\",\"context\":0}),",
        "        )",
        "        .unwrap();",
        "        assert_eq!(exact.inputs.len(), 2);",
        "        assert_eq!(exact.inputs[0][\"line_start\"], 2);",
        "        assert_eq!(exact.inputs[0][\"line_end\"], 2);",
        "        let absent = dispatch(&sources, \"ripgrep\", &json!({\"pattern\":\"NEEDLE\"})).unwrap();",
        "        assert_eq!(absent.result, json!({\"inputs\":[],\"definitions\":[]}));",
        "        assert!(dispatch(&sources, \"ripgrep\", &json!({\"pattern\":\"[\"})).is_err());",
        "        assert!(",
        "            dispatch(",
        "                &sources,",
        "                \"ripgrep\",",
        "                &json!({\"pattern\":\"needle\",\"context\":-1})",
        "            )",
        "            .is_err()",
        "        );",
        "        assert!(dispatch(&sources, \"list_files\", &json!({\"path\":\"../\"})).is_err());",
        "    }"
      ]
    }
  ],
  "requirement": "The harness MUST expose a `ripgrep` tool with this interface:\n\n```text\nripgrep({ pattern: String, path: String = \".\", context: Integer = 5 }) -> SearchResult\n\nSearchResult {\n    inputs: Array<FileRangeInput>,\n    definitions: Array<DefinitionInput>,\n}\n```\n\nThe tool MUST search the requested project-relative file or directory using\nripgrep's regular-expression syntax and default case-sensitive search and ignore\nrules. Its model-facing description MUST explain those conventions. `context`\nMUST be nonnegative and specify how many lines before and after each matching\nline to include, defaulting to five on each side. Windows MUST stop at file\nboundaries, and overlapping windows in the same file MUST be merged. Each\nresulting window MUST be returned as a file-range input with its source path,\ninclusive line range, and complete text under {cite}`requirements.ci.inputs`.\nSetting `context` to zero MUST return only matching lines.\nRequired terminology MUST be included under\n{cite}`requirements.definitions.authoring_inputs`. Returned source inputs supplied\nto the model MUST be recorded under {cite}`requirements.authoring.delivered_inputs`.\nNo matches MUST return empty arrays; invalid arguments or a failed search MUST\nreturn an explanatory tool error."
}
