        "// {impl}`requirements.authoring.text_search`",
        "fn string<'a>(args: &'a Map<String, Value>, key: &str) -> Result<&'a str, String> {",
        "    args.get(key)",
        "        .and_then(Value::as_str)",
        "        .ok_or_else(|| format!(\"{key} must be a string\"))",
        "}"
      ]
