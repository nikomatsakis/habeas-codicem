      ],
      "text": [
        ":::{req} source_addresses",
        "The source tools identify project files with project-relative `PathBuf` values.",
        "",
        "```rust,ignore",
        "let file = std::path::PathBuf::from(\"src/auth.rs\");",
        "```",
        "",
        "An item within that file uses the path and selector in `OutlineId` under",
        "{cite}`requirements.sdk.outlines.address_identity`.",
        ":::"
      ]
    },
    {
      "requirements": "requirements.sdk.outlines.address_identity",
      "matches": [
        "requirements.sdk.outlines.address_identity"
      ],
      "text": [
        ":::{req} address_identity",
        "`OutlineId` identifies a file and an item within it. Its path and selector",
        "alone determine its identity; equivalent addresses compare equally when",
        "reconstructed in another process. Constructing an address performs no file read.",
        "Selectors follow {cite}`requirements.references.outline_selectors`.",
        "",
        "```rust,ignore",
        "use std::path::PathBuf;",
        "",
        "// Defined in trust_but_verify::outline.",
        "#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]",
        "pub struct OutlineId {",
        "    pub path: PathBuf,",
        "    /// Item within the file; an empty selector selects its root.",
        "    pub selector: String,",
        "}",
        "```",
        ":::"
      ]
    },
