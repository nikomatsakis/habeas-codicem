        "    );",
        "    let index_href = chapter_href(detail_path, index_path, None);",
        "    render_detail_sections(",
        "        format!(",
        "            \"# `{name}`\\n\\n[Requirements index]({index_href}) · [View definition]({definition_href})\\n\\n\"",
        "        ),",
