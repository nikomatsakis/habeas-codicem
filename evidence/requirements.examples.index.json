        "// {impl}`requirements.examples.index`",
        "fn render_detail_page(",
        "    name: &str,",
        "    detail_path: &Path,",
        "    index_path: &Path,",
        "    definition: &Definition,",
        "    detail_evidence: DetailEvidence<'_>,",
