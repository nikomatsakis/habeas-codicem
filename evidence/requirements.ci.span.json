        "                    errors.push(format!(",
        "                        \"{label}:{}: {} {name} has an :{}: option without a file path\",",
        "                        option.line,",
        "                        block.kind.noun(),",
        "                        option.name",
        "                    ));",
        "                    continue;",
        "                }",
        "                anchors.push(Anchor {",
        "                    kind,",
        "                    file: option.value.clone(),",
        "                });",
        "            }",
