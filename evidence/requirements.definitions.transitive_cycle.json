      "rust_file": "tests/definitions.rs",
      "rust_item": "fn[function_attestations_capture_terms_without_counting_them_as_citations]",
      "text": [
        "// {test}`requirements.definitions.transitive_cycle`",
        "// {test}`requirements.definitions.dependencies`",
        "// {test}`requirements.definitions.references`",
        "#[test]",
        "fn function_attestations_capture_terms_without_counting_them_as_citations() {",
        "    let temp = fixture();",
        "    let root = temp.path();",
        "    fs::write(",
        "        root.join(\"src/lib.rs\"),",
        "        \"// IMPL`rules.ready`\\n// TERM`glossary.a`\\npub fn run() {}\\n\"",
        "            .replace(\"IMPL\", \"{impl}\")",
        "            .replace(\"TERM\", \"{term}\"),",
        "    )",
        "    .unwrap();",
        "    add_input(",
        "        root,",
        "        InputTarget::RustFunction {",
        "            rust_file: \"src/lib.rs\".into(),",
        "            rust_item: \"fn[run]\".into(),",
        "        },",
        "        InputMode::Requirements(\"rules.*\".into()),",
        "    )",
        "    .unwrap();",
        "    add_input(",
        "        root,",
        "        InputTarget::RustFunction {",
        "            rust_file: \"src/lib.rs\".into(),",
        "            rust_item: \"fn[run]\".into(),",
        "        },",
        "        InputMode::RustItemsAtLine(\"src/lib.rs:3\".into()),",
        "    )",
        "    .unwrap();",
        "    let path = root.join(\"evidence/rust/src/lib.rs.json\");",
        "    let mut sidecar: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();",
        "    let entry = &mut sidecar[\"functions\"][0];",
        "    assert_eq!(",
        "        entry[\"citations\"],",
        "        json!([{\"role\":\"impl\",\"name\":\"rules.ready\"}])",
        "    );",
        "    assert_eq!(entry[\"inputs\"].as_array().unwrap().len(), 4);",
        "    entry[\"determination\"] = json!(true);",
        "    fs::write(&path, sidecar.to_string()).unwrap();",
        "    capture(root);",
        "    add_input(",
        "        root,",
        "        InputTarget::Requirement(\"rules.ready\".into()),",
        "        InputMode::RustItemsAtLine(\"src/lib.rs:3\".into()),",
        "    )",
        "    .unwrap();",
        "    approve(&root.join(\"evidence/rules.ready.json\"));",
        "    assert!(validate_repository(root).unwrap().errors.is_empty());",
        "    let glossary = root.join(\"md/glossary.md\");",
        "    fs::write(",
        "        &glossary,",
        "        fs::read_to_string(&glossary)",
        "            .unwrap()",
        "            .replace(\":phrase: beta\", \":phrase: changed\"),",
        "    )",
        "    .unwrap();",
        "    let errors = validate_repository(root).unwrap().errors;",
        "    for label in [\"evidence/rules.ready.json\", \"evidence/rust/src/lib.rs.json\"] {",
        "        assert!(",
        "            errors.iter().any(|e| e.contains(label)",
        "                && e.contains(\"input text changed\")",
        "                && e.contains(\"glossary.b\")),",
        "            \"{errors:?}\"",
        "        );",
        "    }",
        "    fs::write(",
        "        root.join(\"src/lib.rs\"),",
        "        \"// TERM`glossary.a`\\npub fn run() {}\\n\".replace(\"TERM\", \"{term}\"),",
        "    )",
        "    .unwrap();",
        "    assert!(",
        "        validate_repository(root)",
        "            .unwrap()",
        "            .errors",
        "            .iter()",
        "            .any(|e| e.contains(\"run\") && e.contains(\"no requirement or example citation\"))",
        "    );",
        "}"
      ]
    }
  ],
  "example": "Requirement R references definition A. A references B, and B references A. R's evidence contains one definition input for A and one for B. A function attestation whose requirements input selects R also requires both inputs. Dependency collection terminates. Changing B's phrase or body invalidates both records' snapshots of B. {cite}`requirements.definitions.dependencies` {cite}`requirements.definitions.inputs`",
  "determination": true,
  "rationale": "cyclic_dependencies_are_captured_once_and_changes_require_review checks A/B cycles, exactly one input per term, mutation invalidation and refresh. function_attestations_capture_terms_without_counting_them_as_citations checks the same dependencies and mutation invalidation in function attestations."
