  "citations": [
    {
      "role": "cite",
      "name": "habeas:coverage",
      "commentary": "This storage-only domain verifies output decoding without reading or\n presenting node contents. A formatter call would be an unwanted graph\n access. Agent fixtures exercise formatting separately."
