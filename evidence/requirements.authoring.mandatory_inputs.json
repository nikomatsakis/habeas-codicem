        "// {impl}`requirements.authoring.mandatory_inputs`",
        "fn insert_selector(selectors: &mut Vec<InputSelector>, selector: InputSelector) {",
        "    if !selectors.contains(&selector) {",
        "        selectors.push(selector);",
        "    }",
        "}"
      ]
    },
