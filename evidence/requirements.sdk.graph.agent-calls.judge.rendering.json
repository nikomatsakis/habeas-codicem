      "text": [
        ":::{req} judge.rendering",
        "The SDK formats node inputs using `Contents::format_node_content`,",
        "defined by {cite}`requirements.sdk.graph.fingerprinting.fingerprint_content`:",
        "",
        "```rust,ignore",
        "// Method on Contents. Both arguments describe the already-read snapshot.",
        "/// Present these supplied contents as text for an agent.",
        "fn format_node_content(",
        "    &self,",
        "    node: &Self::NodeId,",
        "    contents: &Self::NodeContent,",
        ") -> Result<String, Self::Error>;",
        "```",
        "",
        "The formatter uses the supplied contents; their fingerprint describes the same",
        "read. For inputs queued on an ask builder, formatting errors return",
        "`ValidationError::Graph`. During a `read_node` tool call, a formatting error is",
        "returned to the agent as a tool error, so it can continue and recover.",
        "`NodeContent` and `NodeId` retain their application-defined types without",
        "serialization or display bounds.",
        ":::"
      ]
    },
    {
      "requirements": "requirements.sdk.graph.fingerprinting.fingerprint_content",
      "matches": [
        "requirements.sdk.graph.fingerprinting.fingerprint_content"
      ],
      "text": [
        ":::{req} fingerprint_content",
        "```rust,ignore",
        "pub trait Contents: Graph {",
        "    /// The application's representation of a node's contents.",
        "    type NodeContent: Send + Sync;",
        "",
        "    /// Fetch the contents of a node.",
        "    fn node_content(&self, node: &Self::NodeId) -> Result<Self::NodeContent, Self::Error>;",
        "",
        "    /// Describe the supplied observation, without rereading the node or",
        "    /// querying mutable external state.",
        "    ///",
        "    /// The same node and contents under the same rules give the same",
        "    /// fingerprint. Everything needed is in the identity, contents, or",
        "    /// configured rules. When the rules change, change the scheme.",
        "    fn fingerprint(",
        "        &self,",
        "        node: &Self::NodeId,",
        "        content: &Self::NodeContent,",
        "    ) -> Fingerprint;",
        "",
        "    /// Present these already-read contents as text for an agent.",
        "    /// Use the supplied contents so the text and fingerprint describe the same read.",
        "    fn format_node_content(",
        "        &self,",
        "        node: &Self::NodeId,",
        "        contents: &Self::NodeContent,",
        "    ) -> Result<String, Self::Error>;",
        "}",
        "```",
        ":::"
      ]
