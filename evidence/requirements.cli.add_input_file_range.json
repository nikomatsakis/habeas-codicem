    {
      "rust_file": "src/add_input.rs",
      "rust_item": "fn[selectors_for_mode]",
      "text": [
        "// {impl}`requirements.cli.add_input`",
        "// {impl}`requirements.cli.add_input_file_range`",
        "// {impl}`requirements.cli.add_input_rust_item`",
        "// {impl}`requirements.cli.add_input_requirements`",
        "// {impl}`requirements.configuration.evidence_paths`",
        "// {impl}`requirements.ci.schema`",
        "fn selectors_for_mode(root: &Path, mode: InputMode) -> io::Result<Vec<InputSelector>> {",
        "    match mode {",
        "        InputMode::FileRange(specification) => {",
        "            let (file, range) = specification.rsplit_once(':').ok_or_else(|| {",
        "                invalid_input(\"file range must have the form <file>:<start>-<end>\")",
        "            })?;",
        "            let (start, end) = range.split_once('-').ok_or_else(|| {",
        "                invalid_input(\"file range must have the form <file>:<start>-<end>\")",
        "            })?;",
        "            let line_start = start",
        "                .parse::<usize>()",
        "                .map_err(|_| invalid_input(\"file range start must be a positive integer\"))?;",
        "            let line_end = end",
        "                .parse::<usize>()",
        "                .map_err(|_| invalid_input(\"file range end must be a positive integer\"))?;",
        "            Ok(vec![InputSelector::FileRange {",
        "                file: file.to_owned(),",
        "                line_start,",
        "                line_end,",
        "            }])",
        "        }",
        "        InputMode::RustItemsAtLine(specification) => {",
        "            let (rust_file, line) = specification.rsplit_once(':').ok_or_else(|| {",
        "                invalid_input(\"Rust item location must have the form <rust-file>:<line>\")",
        "            })?;",
        "            let line = line",
        "                .parse::<usize>()",
        "                .map_err(|_| invalid_input(\"Rust item line must be a positive integer\"))?;",
        "            if !rust_file.ends_with(\".rs\") {",
        "                return Err(invalid_input(\"Rust item location requires a .rs file\"));",
        "            }",
        "            let (path, source) = read_project_file(root, rust_file).map_err(invalid_input)?;",
        "            let rust_file = path",
        "                .strip_prefix(root)",
        "                .unwrap_or(&path)",
        "                .to_str()",
        "                .ok_or_else(|| invalid_input(\"Rust file path must be UTF-8\"))?;",
        "            let items = parse_items(&source).map_err(|error| {",
        "                invalid_input(format!(\"{rust_file}: cannot parse Rust source: {error}\"))",
        "            })?;",
        "            let selected = items",
        "                .into_iter()",
        "                .filter(|item| item.declaration_line == line)",
        "                .map(|item| InputSelector::RustItem {",
        "                    rust_file: rust_file.to_owned(),",
        "                    rust_item: item.selector,",
        "                })",
        "                .collect::<Vec<_>>();",
        "            if selected.is_empty() {",
        "                return Err(invalid_input(format!(",
        "                    \"{rust_file}:{line}: no Rust item is declared on this line\"",
        "                )));",
        "            }",
        "            Ok(selected)",
        "        }",
        "        InputMode::Requirements(requirements) => {",
        "            Ok(vec![InputSelector::Requirements { requirements }])",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/add_input.rs",
      "rust_item": "fn[update_inputs]",
      "text": [
        "// {impl}`requirements.cli.add_input`",
        "// {impl}`requirements.definitions.capture`",
        "// {impl}`requirements.cli.add_input_requirements`",
        "// {impl}`requirements.definitions.dependencies`",
        "// {impl}`requirements.cli.add_input_file_range`",
        "fn update_inputs(",
        "    record: &mut Value,",
        "    inputs: Vec<(InputSelector, Value, Vec<String>)>,",
        "    root: &Path,",
        "    definitions: &BTreeMap<String, Declaration>,",
        "    subject: Option<&str>,",
        ") -> io::Result<(String, bool)> {",
        "    let Some(object) = record.as_object_mut() else {",
        "        return Err(invalid_input(\"evidence record must be a JSON object\"));",
        "    };",
        "    let Some(existing) = object.get_mut(\"inputs\").and_then(Value::as_array_mut) else {",
        "        return Err(invalid_input(\"evidence inputs must be an array\"));",
        "    };",
        "    let mut output = String::new();",
        "    let mut changed = false;",
        "    for (selector, input, matches) in inputs {",
        "        let position = existing",
        "            .iter()",
        "            .position(|old| InputSelector::from_input(old).as_ref() == Some(&selector));",
        "        let action = if let Some(position) = position {",
        "            if existing[position] == input {",
        "                \"unchanged\"",
        "            } else {",
        "                existing[position] = input;",
        "                changed = true;",
        "                \"refreshed\"",
        "            }",
        "        } else {",
        "            existing.push(input);",
        "            changed = true;",
        "            \"added\"",
        "        };",
        "        output.push_str(&format!(\"- {action}: {selector:?}\"));",
        "        if !matches.is_empty() {",
        "            output.push_str(&format!(\" matching {}\", matches.join(\", \")));",
        "        }",
        "        output.push('\\n');",
        "    }",
        "    let required =",
        "        crate::terms::dependencies(definitions, object, subject).map_err(invalid_input)?;",
        "    let existing = object",
        "        .get_mut(\"inputs\")",
        "        .and_then(Value::as_array_mut)",
        "        .unwrap();",
        "    for definition in required {",
        "        let selector = InputSelector::Definition {",
        "            definition: definition.clone(),",
        "        };",
        "        let resolved = selector.resolve(root, definitions).map_err(invalid_input)?;",
        "        let input = selector.to_input(&resolved);",
        "        let positions: Vec<_> = existing",
        "            .iter()",
        "            .enumerate()",
        "            .filter_map(|(i, old)| {",
        "                (old.get(\"definition\").and_then(Value::as_str) == Some(definition.as_str()))",
        "                    .then_some(i)",
        "            })",
        "            .collect();",
        "        if positions.len() != 1 || existing[positions[0]] != input {",
        "            existing.retain(|old| {",
        "                old.get(\"definition\").and_then(Value::as_str) != Some(definition.as_str())",
        "            });",
        "            existing.push(input);",
        "            changed = true;",
        "            output.push_str(&format!(\"- captured: definition {definition}\\n\"));",
        "        }",
        "    }",
        "    if changed {",
        "        object.insert(\"determination\".to_owned(), Value::Bool(false));",
        "        object.insert(",
        "            \"rationale\".to_owned(),",
        "            Value::String(",
        "                \"Review pending: reassess the changed input, all applicable definitions and citations, and the behavior they jointly specify.\".to_owned(),",
        "            ),",
        "        );",
        "    }",
        "    Ok((output, changed))",
        "}"
      ]
    },
    {
      "rust_file": "src/inputs.rs",
      "rust_item": "impl[InputSelector]/fn[resolve]",
      "text": [
        "    // {impl}`requirements.ci.inputs`",
        "    // {impl}`requirements.ci.rust_item_inputs`",
        "    // {impl}`requirements.ci.requirements_inputs`",
        "    // {impl}`requirements.definitions.inputs`",
        "    // {impl}`requirements.definitions.selection`",
        "    // {impl}`requirements.cli.add_input_file_range`",
        "    // {impl}`requirements.cli.add_input_requirements`",
        "    // {impl}`requirements.references.definition_globs`",
        "    pub(crate) fn resolve(",
        "        &self,",
        "        root: &Path,",
        "        definitions: &BTreeMap<String, Declaration>,",
        "    ) -> Result<ResolvedInput, String> {",
        "        match self {",
        "            Self::FileRange {",
        "                file,",
        "                line_start,",
        "                line_end,",
        "            } => {",
        "                let (_, content) = read_project_file(root, file)?;",
        "                let lines = raw_lines(&content);",
        "                if *line_start == 0 || *line_end < *line_start || *line_end > lines.len() {",
        "                    return Err(format!(",
        "                        \"{file}:{line_start}-{line_end} is not an inclusive range within the file's {} lines\",",
        "                        lines.len()",
        "                    ));",
        "                }",
        "                Ok(ResolvedInput {",
        "                    ranges: vec![SourceRange {",
        "                        file: file.clone(),",
        "                        line_start: *line_start,",
        "                        line_end: *line_end,",
        "                        name: None,",
        "                    }],",
        "                    text: lines[*line_start - 1..*line_end].to_vec(),",
        "                    matches: Vec::new(),",
        "                })",
        "            }",
        "            Self::RustItem {",
        "                rust_file,",
        "                rust_item,",
        "            } => {",
        "                if Path::new(rust_file)",
        "                    .extension()",
        "                    .is_none_or(|extension| extension != \"rs\")",
        "                {",
        "                    return Err(format!(\"{rust_file}: Rust-item input requires a .rs file\"));",
        "                }",
        "                let (_, content) = read_project_file(root, rust_file)?;",
        "                let items = parse_items(&content)",
        "                    .map_err(|error| format!(\"{rust_file}: cannot parse Rust source: {error}\"))?;",
        "                let mut matching = items.iter().filter(|item| item.selector == *rust_item);",
        "                let Some(item) = matching.next() else {",
        "                    return Err(format!(\"{rust_file}: no Rust item matches {rust_item:?}\"));",
        "                };",
        "                if matching.next().is_some() {",
        "                    return Err(format!(\"{rust_file}: Rust item {rust_item:?} is ambiguous\"));",
        "                }",
        "                Ok(ResolvedInput {",
        "                    ranges: vec![SourceRange {",
        "                        file: rust_file.clone(),",
        "                        line_start: item.line_start,",
        "                        line_end: item.line_end,",
        "                        name: None,",
        "                    }],",
        "                    text: item_lines(&content, item),",
        "                    matches: Vec::new(),",
        "                })",
        "            }",
        "            Self::Definition { definition } => {",
        "                let target = definitions",
        "                    .get(definition)",
        "                    .filter(|d| d.kind == crate::DefinitionKind::Term)",
        "                    .ok_or_else(|| format!(\"{definition}: no matching named definition\"))?;",
        "                check_project_file(root, &target.file)?;",
        "                Ok(ResolvedInput {",
        "                    ranges: vec![SourceRange {",
        "                        file: target.file.clone(),",
        "                        line_start: target.line_start,",
        "                        line_end: target.line_end,",
        "                        name: Some(definition.clone()),",
        "                    }],",
        "                    text: target.raw_lines.clone(),",
        "                    matches: Vec::new(),",
        "                })",
        "            }",
        "            Self::Requirements { requirements } => {",
        "                definition_glob::validate(requirements)?;",
        "                let mut ranges = Vec::new();",
        "                let mut text = Vec::new();",
        "                let mut matches = Vec::new();",
        "                for (name, definition) in definitions {",
        "                    if definition.kind == crate::DefinitionKind::Term",
        "                        || !definition_glob::matches(requirements, name)",
        "                    {",
        "                        continue;",
        "                    }",
        "                    check_project_file(root, &definition.file)?;",
        "                    if !text.is_empty() {",
        "                        text.push(String::new());",
        "                    }",
        "                    text.extend(definition.raw_lines.iter().cloned());",
        "                    ranges.push(SourceRange {",
        "                        file: definition.file.clone(),",
        "                        line_start: definition.line_start,",
        "                        line_end: definition.line_end,",
        "                        name: Some(name.clone()),",
        "                    });",
        "                    matches.push(name.clone());",
        "                }",
        "                if matches.is_empty() {",
        "                    return Err(format!(",
        "                        \"requirements glob {requirements:?} matches no requirement or example\"",
        "                    ));",
        "                }",
        "                Ok(ResolvedInput {",
        "                    ranges,",
        "                    text,",
        "                    matches,",
        "                })",
        "            }",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "tests/commands.rs",
      "rust_item": "fn[add_input_external_sources_respect_allow_and_disallow]",
      "text": [
        "// {test}`requirements.cli.add_input`",
        "// {test}`requirements.ci.input_containment`",
        "// {test}`requirements.cli.add_input_file_range`",
        "// {test}`requirements.cli.add_input_rust_item`",
        "// {test}`requirements.configuration.evidence_paths`",
        "// {test}`requirements.ci.schema`",
        "#[test]",
        "fn add_input_external_sources_respect_allow_and_disallow() {",
        "    let temp = fixture();",
        "    let external = TempDir::new().unwrap();",
        "    let source = external.path().join(\"source.rs\");",
        "    fs::write(&source, \"pub fn external() {}\\n\").unwrap();",
        "    let source = fs::canonicalize(source).unwrap();",
        "    let allowed = toml::Value::String(external.path().display().to_string());",
        "    let config = format!(\"version = 1\\n[evidence]\\nallow = [{allowed}]\\n\");",
        "    fs::write(temp.path().join(\"habeas.toml\"), &config).unwrap();",
        "    let evidence = temp.path().join(\"evidence/requirements.absent.json\");",
        "    for (mode, location) in [",
        "        (\"--file-range\", format!(\"{}:1-1\", source.display())),",
        "        (\"--rust-item\", format!(\"{}:1\", source.display())),",
        "    ] {",
        "        let output = habeas(",
        "            temp.path(),",
        "            &[",
        "                \"add-input\",",
        "                \"--for-requirement\",",
        "                \"requirements.absent\",",
        "                mode,",
        "                &location,",
        "            ],",
        "        );",
        "        assert!(output.status.success(), \"{output:?}\");",
        "    }",
        "    let contents = fs::read(&evidence).unwrap();",
        "    let record: serde_json::Value = serde_json::from_slice(&contents).unwrap();",
        "    assert_eq!(",
        "        record[\"inputs\"],",
        "        json!([",
        "            {\"file\": source, \"line_start\": 1, \"line_end\": 1, \"text\": [\"pub fn external() {}\"]},",
        "            {\"rust_file\": source, \"rust_item\": \"fn[external]\", \"text\": [\"pub fn external() {}\"]},",
        "        ])",
        "    );",
        "",
        "    fs::write(",
        "        temp.path().join(\"habeas.toml\"),",
        "        format!(\"{config}disallow = [{allowed}]\\n\"),",
        "    )",
        "    .unwrap();",
        "    for (mode, location) in [",
        "        (\"--file-range\", format!(\"{}:1-1\", source.display())),",
        "        (\"--rust-item\", format!(\"{}:1\", source.display())),",
        "    ] {",
        "        let output = habeas(",
        "            temp.path(),",
        "            &[",
        "                \"add-input\",",
        "                \"--for-requirement\",",
        "                \"requirements.absent\",",
        "                mode,",
        "                &location,",
        "            ],",
        "        );",
        "        assert!(!output.status.success(), \"{output:?}\");",
        "        let error = String::from_utf8_lossy(&output.stderr);",
        "        assert!(error.contains(\"disallowed\"), \"{error}\");",
        "        assert!(!error.contains(\"panicked\"), \"{error}\");",
        "        assert_eq!(fs::read(&evidence).unwrap(), contents);",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "tests/commands.rs",
      "rust_item": "fn[add_input_modes_capture_raw_sources_and_refresh_idempotently]",
      "text": [
        "// {test}`requirements.cli.add_input`",
        "// {test}`requirements.cli.info`",
        "// {test}`requirements.cli.add_input_file_range`",
        "// {test}`requirements.cli.add_input_rust_item`",
        "// {test}`requirements.cli.add_input_requirements`",
        "// {test}`requirements.references.selector_same_line`",
        "// {test}`requirements.references.selector_raw_lines`",
        "#[test]",
        "fn add_input_modes_capture_raw_sources_and_refresh_idempotently() {",
        "    let temp = TempDir::new().unwrap();",
        "    fs::create_dir_all(temp.path().join(\"md\")).unwrap();",
        "    fs::create_dir_all(temp.path().join(\"src\")).unwrap();",
        "    fs::write(",
        "        temp.path().join(\"Cargo.toml\"),",
        "        \"[package]\\nname = \\\"fixture\\\"\\n\",",
        "    )",
        "    .unwrap();",
        "    fs::write(temp.path().join(\"book.toml\"), \"[book]\\nsrc = \\\"md\\\"\\n\").unwrap();",
        "    fs::write(",
        "        temp.path().join(\"md/rules.md\"),",
        "        \":::{req} ready\\nReady.\\n:::\\n\\n:::{example} case\\nGiven ready, it works. CITE`rules.ready`\\n:::\\n\".replace(\"CITE\", \"{cite}\"),",
        "    )",
        "    .unwrap();",
        "    fs::write(",
        "        temp.path().join(\"src/main.rs\"),",
        "        \"/// user docs\\n#[allow(dead_code)]\\n// IMPL`rules.ready`\\nfn main() { fn nested() {} }\\n\"",
        "            .replace(\"IMPL\", \"{impl}\"),",
        "    )",
        "    .unwrap();",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--file-range\",",
        "            \"src/main.rs:1-2\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--rust-item\",",
        "            \"src/main.rs:4\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let stdout = String::from_utf8(output.stdout).unwrap();",
        "    assert!(stdout.contains(\"fn[main]\"), \"{stdout}\");",
        "    assert!(stdout.contains(\"fn[main]/fn[nested]\"), \"{stdout}\");",
        "    let requirement_path = temp.path().join(\"evidence/rules.ready.json\");",
        "    let first = fs::read(&requirement_path).unwrap();",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--rust-item\",",
        "            \"src/main.rs:4\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    assert!(String::from_utf8_lossy(&output.stdout).contains(\"unchanged\"));",
        "    assert_eq!(fs::read(&requirement_path).unwrap(), first);",
        "    let requirement: serde_json::Value = serde_json::from_slice(&first).unwrap();",
        "    assert_eq!(requirement[\"inputs\"].as_array().unwrap().len(), 3);",
        "    assert_eq!(",
        "        requirement[\"inputs\"][1][\"text\"],",
        "        json!([",
        "            \"/// user docs\",",
        "            \"#[allow(dead_code)]\",",
        "            \"// IMPL`rules.ready`\".replace(\"IMPL\", \"{impl}\"),",
        "            \"fn main() { fn nested() {} }\"",
        "        ])",
        "    );",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-example\",",
        "            \"rules.case\",",
        "            \"--requirements\",",
        "            \"rules.*\",",
        "        ],",
