      "text": [
        "    // {impl}`requirements.cli.add_input`",
        "    // {impl}`requirements.definitions.inputs`",
        "    pub(crate) fn to_input(&self, resolved: &ResolvedInput) -> Value {",
        "        match self {",
        "            Self::FileRange {",
        "                file,",
        "                line_start,",
        "                line_end,",
        "            } => json!({",
        "                \"file\": file,",
        "                \"line_start\": line_start,",
        "                \"line_end\": line_end,",
        "                \"text\": resolved.text,",
        "            }),",
        "            Self::RustItem {",
        "                rust_file,",
        "                rust_item,",
        "            } => json!({",
        "                \"rust_file\": rust_file,",
        "                \"rust_item\": rust_item,",
        "                \"text\": resolved.text,",
        "            }),",
        "            Self::Definition { definition } => {",
        "                json!({ \"definition\": definition, \"text\": resolved.text })",
        "            }",
        "            Self::Requirements { requirements } => json!({",
        "                \"requirements\": requirements,",
        "                \"matches\": resolved.matches,",
        "                \"text\": resolved.text,",
        "            }),",
        "        }",
        "    }"
      ]
