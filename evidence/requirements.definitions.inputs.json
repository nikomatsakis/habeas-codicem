    {
      "rust_file": "src/inputs.rs",
      "rust_item": "impl[InputSelector]/fn[resolve]",
      "text": [
        "    // {impl}`requirements.ci.inputs`",
        "    // {impl}`requirements.ci.rust_item_inputs`",
        "    // {impl}`requirements.ci.requirements_inputs`",
        "    // {impl}`requirements.definitions.inputs`",
        "    // {impl}`requirements.definitions.selection`",
        "    pub(crate) fn resolve(",
        "        &self,",
        "        root: &Path,",
        "        definitions: &BTreeMap<String, Declaration>,",
        "    ) -> Result<ResolvedInput, String> {",
        "        match self {",
        "            Self::FileRange {",
        "                file,",
        "                line_start,",
        "                line_end,",
        "            } => {",
        "                let (_, content) = read_project_file(root, file)?;",
        "                let lines = raw_lines(&content);",
        "                if *line_start == 0 || *line_end < *line_start || *line_end > lines.len() {",
        "                    return Err(format!(",
        "                        \"{file}:{line_start}-{line_end} is not an inclusive range within the file's {} lines\",",
        "                        lines.len()",
        "                    ));",
        "                }",
        "                Ok(ResolvedInput {",
        "                    ranges: vec![SourceRange {",
        "                        file: file.clone(),",
        "                        line_start: *line_start,",
        "                        line_end: *line_end,",
        "                        name: None,",
        "                    }],",
        "                    text: lines[*line_start - 1..*line_end].to_vec(),",
        "                    matches: Vec::new(),",
        "                })",
        "            }",
        "            Self::RustItem {",
        "                rust_file,",
        "                rust_item,",
        "            } => {",
        "                if Path::new(rust_file)",
        "                    .extension()",
        "                    .is_none_or(|extension| extension != \"rs\")",
        "                {",
        "                    return Err(format!(\"{rust_file}: Rust-item input requires a .rs file\"));",
        "                }",
        "                let (_, content) = read_project_file(root, rust_file)?;",
        "                let items = parse_items(&content)",
        "                    .map_err(|error| format!(\"{rust_file}: cannot parse Rust source: {error}\"))?;",
        "                let mut matching = items.iter().filter(|item| item.selector == *rust_item);",
        "                let Some(item) = matching.next() else {",
        "                    return Err(format!(\"{rust_file}: no Rust item matches {rust_item:?}\"));",
        "                };",
        "                if matching.next().is_some() {",
        "                    return Err(format!(\"{rust_file}: Rust item {rust_item:?} is ambiguous\"));",
        "                }",
        "                Ok(ResolvedInput {",
        "                    ranges: vec![SourceRange {",
        "                        file: rust_file.clone(),",
        "                        line_start: item.line_start,",
        "                        line_end: item.line_end,",
        "                        name: None,",
        "                    }],",
        "                    text: item_lines(&content, item),",
        "                    matches: Vec::new(),",
        "                })",
        "            }",
        "            Self::Definition { definition } => {",
        "                let target = definitions",
        "                    .get(definition)",
        "                    .filter(|d| d.kind == crate::DefinitionKind::Term)",
        "                    .ok_or_else(|| format!(\"{definition}: no matching named definition\"))?;",
        "                check_project_file(root, &target.file)?;",
        "                Ok(ResolvedInput {",
        "                    ranges: vec![SourceRange {",
        "                        file: target.file.clone(),",
        "                        line_start: target.line_start,",
        "                        line_end: target.line_end,",
        "                        name: Some(definition.clone()),",
        "                    }],",
        "                    text: target.raw_lines.clone(),",
        "                    matches: Vec::new(),",
        "                })",
        "            }",
        "            Self::Requirements { requirements } => {",
        "                definition_glob::validate(requirements)?;",
        "                let mut ranges = Vec::new();",
        "                let mut text = Vec::new();",
        "                let mut matches = Vec::new();",
        "                for (name, definition) in definitions {",
        "                    if definition.kind == crate::DefinitionKind::Term",
        "                        || !definition_glob::matches(requirements, name)",
        "                    {",
        "                        continue;",
        "                    }",
        "                    check_project_file(root, &definition.file)?;",
        "                    if !text.is_empty() {",
        "                        text.push(String::new());",
        "                    }",
        "                    text.extend(definition.raw_lines.iter().cloned());",
        "                    ranges.push(SourceRange {",
        "                        file: definition.file.clone(),",
        "                        line_start: definition.line_start,",
        "                        line_end: definition.line_end,",
        "                        name: Some(name.clone()),",
        "                    });",
        "                    matches.push(name.clone());",
        "                }",
        "                if matches.is_empty() {",
        "                    return Err(format!(",
        "                        \"requirements glob {requirements:?} matches no requirement or example\"",
        "                    ));",
        "                }",
        "                Ok(ResolvedInput {",
        "                    ranges,",
        "                    text,",
        "                    matches,",
        "                })",
        "            }",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "tests/definitions.rs",
      "rust_item": "fn[cyclic_dependencies_are_captured_once_and_changes_require_review]",
      "text": [
        "// {test}`requirements.definitions.transitive_cycle`",
        "// {test}`requirements.definitions.reassessment`",
        "// {test}`requirements.definitions.dependencies`",
        "// {test}`requirements.definitions.inputs`",
        "// {test}`requirements.definitions.capture`",
        "#[test]",
        "fn cyclic_dependencies_are_captured_once_and_changes_require_review() {",
        "    let temp = fixture();",
        "    let root = temp.path();",
        "    capture(root);",
        "    let path = root.join(\"evidence/rules.ready.json\");",
        "    approve(&path);",
        "    let record: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();",
        "    assert_eq!(record[\"inputs\"].as_array().unwrap().len(), 3);",
        "    assert!(validate_repository(root).unwrap().errors.is_empty());",
        "    let before = fs::read(&path).unwrap();",
        "    capture(root);",
        "    assert_eq!(before, fs::read(&path).unwrap());",
        "",
        "    let glossary = root.join(\"md/glossary.md\");",
        "    let original = fs::read_to_string(&glossary).unwrap();",
        "    fs::write(&glossary, format!(\"\\n\\n{original}\")).unwrap();",
        "    assert!(validate_repository(root).unwrap().errors.is_empty());",
        "    for changed in [",
        "        original.replace(\":phrase: beta\", \":phrase: new beta\"),",
        "        original",
        "            .replace(\"See TERM\", \"Read TERM\")",
        "            .replace(\"See {term}\", \"Read {term}\"),",
        "    ] {",
        "        fs::write(&glossary, changed).unwrap();",
        "        let report = validate_repository(root).unwrap();",
        "        assert!(",
        "            report",
        "                .errors",
        "                .iter()",
        "                .any(|e| e.contains(\"input text changed\") && e.contains(\"glossary.\")),",
        "            \"{:?}\",",
        "            report.errors",
        "        );",
        "        assert_eq!(before, fs::read(&path).unwrap());",
        "    }",
        "    capture(root);",
        "    let refreshed: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();",
        "    assert_eq!(refreshed[\"determination\"], false);",
        "    assert_eq!(refreshed[\"inputs\"].as_array().unwrap().len(), 3);",
        "    approve(&path);",
        "    assert!(validate_repository(root).unwrap().errors.is_empty());",
        "",
        "    let mut missing = refreshed.clone();",
        "    missing[\"inputs\"]",
        "        .as_array_mut()",
        "        .unwrap()",
        "        .retain(|i| i.get(\"definition\") != Some(&json!(\"glossary.b\")));",
        "    fs::write(&path, missing.to_string()).unwrap();",
        "    assert!(",
        "        validate_repository(root)",
        "            .unwrap()",
        "            .errors",
        "            .iter()",
        "            .any(|e| e.contains(\"glossary.b, found 0\"))",
        "    );",
        "    let mut duplicate = refreshed;",
        "    let input = duplicate[\"inputs\"][1].clone();",
        "    duplicate[\"inputs\"].as_array_mut().unwrap().push(input);",
        "    fs::write(&path, duplicate.to_string()).unwrap();",
        "    assert!(",
        "        validate_repository(root)",
        "            .unwrap()",
        "            .errors",
        "            .iter()",
        "            .any(|e| e.contains(\"found 2\"))",
        "    );",
        "    capture(root);",
        "    let repaired: Value = serde_json::from_str(&fs::read_to_string(path).unwrap()).unwrap();",
        "    assert_eq!(repaired[\"inputs\"].as_array().unwrap().len(), 3);",
        "}"
      ]
    },
    {
      "rust_file": "tests/definitions.rs",
      "rust_item": "fn[definition_schema_deletion_and_literal_references_are_checked]",
      "text": [
        "// {test}`requirements.definitions.inputs`",
        "// {test}`requirements.definitions.references`",
        "// {test}`requirements.definitions.dependencies`",
        "#[test]",
        "fn definition_schema_deletion_and_literal_references_are_checked() {",
        "    let temp = fixture();",
        "    let root = temp.path();",
        "    capture(root);",
        "    let path = root.join(\"evidence/rules.ready.json\");",
        "    approve(&path);",
        "    let original: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();",
        "    let mut invalid = original.clone();",
        "    invalid[\"inputs\"][1][\"unexpected\"] = json!(true);",
        "    fs::write(&path, invalid.to_string()).unwrap();",
        "    assert!(",
        "        validate_repository(root)",
        "            .unwrap()",
        "            .errors",
        "            .iter()",
        "            .any(|e| e.contains(\"unexpected field\"))",
        "    );",
        "    fs::write(&path, original.to_string()).unwrap();",
        "    fs::remove_file(root.join(\"md/glossary.md\")).unwrap();",
        "    assert!(",
        "        validate_repository(root)",
        "            .unwrap()",
        "            .errors",
        "            .iter()",
        "            .any(|e| e.contains(\"glossary.a\") && e.contains(\"no matching named definition\"))",
        "    );",
        "",
        "    let temp = fixture();",
        "    let root = temp.path();",
        "    let body =",
        "        \"Literal `TERM`missing.name``.\\n\\n```text\\nTERM`missing.name`\\n```\\n\\n\\\\TERM`missing.name`\"",
        "            .replace(\"TERM\", \"{term}\");",
        "    fs::write(",
        "        root.join(\"md/rules.md\"),",
        "        format!(\":::{{req}} ready\\n{body}\\n:::\\n\"),",
        "    )",
        "    .unwrap();",
        "    capture(root);",
        "    approve(&root.join(\"evidence/rules.ready.json\"));",
        "    let report = validate_repository(root).unwrap();",
        "    assert!(report.errors.is_empty(), \"{:?}\", report.errors);",
        "    let record: Value =",
        "        serde_json::from_str(&fs::read_to_string(root.join(\"evidence/rules.ready.json\")).unwrap())",
        "            .unwrap();",
        "    assert_eq!(record[\"inputs\"].as_array().unwrap().len(), 1);",
        "}"
      ]
    }
