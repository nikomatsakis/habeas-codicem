        "                .and_then(|value| value.get(\"determination\").and_then(Value::as_bool))",
        "                == Some(true)",
        "        {",
        "            errors.push(format!(",
        "                \"{}: example {name} has a true determination but no {{test}} reference\",",
        "                display_path(root, &evidence_file)",
