        "        let inputs = evidence_input_ranges(root, &evidence_file, definitions);",
        "        for reference in references {",
        "            if !inputs.iter().any(|input| {",
        "                input.file == reference.file",
        "                    && input.line_start <= reference.line",
        "                    && reference.line <= input.line_end",
        "            }) {",
