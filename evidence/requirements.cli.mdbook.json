        "            .source_path",
        "            .as_deref()",
        "            .or(chapter.path.as_deref())",
        "            .map(chapter_namespace)",
        "            .unwrap_or_default();",
        "        chapter.content = replace_definitions(",
        "            &chapter.content,",
        "            &namespace,",
        "            chapter.path.as_deref(),",
        "            index.as_ref(),",
        "        );",
        "        if let Some(path) = chapter.path.as_deref() {",
