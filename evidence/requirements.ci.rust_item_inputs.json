      "text": [
        "// {impl}`requirements.ci.rust_item_inputs`",
        "pub(crate) fn item_lines(source: &str, item: &RustItem) -> Vec<String> {",
        "    source",
        "        .lines()",
        "        .map(|line| line.strip_suffix('\\r').unwrap_or(line))",
        "        .skip(item.line_start - 1)",
        "        .take(item.line_end - item.line_start + 1)",
        "        .map(str::to_owned)",
        "        .collect()",
        "}"
      ]
    },
