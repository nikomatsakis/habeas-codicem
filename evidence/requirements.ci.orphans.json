{
  "requirement": "Every JSON file under `evidence/` MUST correspond to a declared requirement. Habeas MUST report JSON evidence files whose names have no matching requirement.",
  "determination": true,
  "rationale": "The validator compares each JSON filename with the declared requirement map and reports unmatched files.",
  "inputs": [
    {
      "file": "src/evidence.rs",
      "line_start": 51,
      "line_end": 72,
      "text": [
        "    // {impl}`requirements.ci.orphans`",
        "    for file in &evidence_files {",
        "        let relative = file",
        "            .strip_prefix(&evidence_root)",
        "            .expect(\"evidence file is inside evidence directory\");",
        "        let label = display_path(&root, file);",
        "        let name = if relative.components().count() == 1 {",
        "            relative",
        "                .file_name()",
        "                .and_then(|part| part.to_str())",
        "                .and_then(|part| part.strip_suffix(\".json\"))",
        "        } else {",
        "            None",
        "        };",
        "        let expected = name.and_then(|name| requirements.get(name));",
        "",
        "        if let Some(name) = name.filter(|_| expected.is_some()) {",
        "            present.insert(name.to_owned());",
        "        } else {",
        "            errors.push(format!(\"{label}: no matching requirement\"));",
        "        }",
        "        validate_evidence_file(&root, file, expected, &mut errors);"
      ]
    }
  ]
}
