{
  "requirement": "The `habeas` CLI MUST use `clap` to define and parse its commands and options.",
  "determination": true,
  "rationale": "Cargo.toml declares clap with derive support. The CLI derives clap parsers for commands and options and calls Cli::parse(); the CLI and setup integration tests pass.",
  "inputs": [
    {
      "file": "Cargo.toml",
      "line_start": 13,
      "line_end": 19,
      "text": [
        "[dependencies]",
        "clap = { version = \"4.6.7\", features = [\"derive\"] }",
        "mdbook-preprocessor = \"=0.5.3\"",
        "pulldown-cmark = \"=0.11.3\"",
        "regex = \"1.13.1\"",
        "serde_json = \"1\"",
        "toml_edit = \"0.25.17\""
      ]
    },
    {
      "file": "src/main.rs",
      "line_start": 1,
      "line_end": 47,
      "text": [
        "use clap::{Parser, Subcommand};",
        "use std::error::Error;",
        "use std::io;",
        "use std::io::Write;",
        "use std::path::PathBuf;",
        "",
        "mod agents;",
        "mod setup;",
        "",
        "// {impl}`requirements.cli.clap`",
        "#[derive(Parser)]",
        "#[command(name = \"habeas\")]",
        "struct Cli {",
        "    #[command(subcommand)]",
        "    command: Command,",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum Command {",
        "    Mdbook {",
        "        #[command(subcommand)]",
        "        command: Option<MdbookCommand>,",
        "    },",
        "    Setup {",
        "        #[arg(long, value_name = \"crate-dir\")]",
        "        path: Option<PathBuf>,",
        "        #[arg(long)]",
        "        install_skills: bool,",
        "    },",
        "    Agents,",
        "    Status {",
        "        #[arg(long)]",
        "        all: bool,",
        "    },",
        "    Info {",
        "        selector: String,",
        "    },",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum MdbookCommand {",
        "    Supports { renderer: String },",
        "}",
        "",
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    match Cli::parse().command {"
      ]
    }
  ]
}
