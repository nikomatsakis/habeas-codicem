{
  "requirement": "The `habeas` CLI MUST use `clap` to define and parse its commands and options.",
  "determination": true,
  "rationale": "Cargo.toml declares clap with derive support. The CLI derives clap parsers for commands and options and calls Cli::parse(); the CLI and setup integration tests pass.",
  "inputs": [
    {
      "file": "Cargo.toml",
      "line_start": 1,
      "line_end": 56,
      "text": [
        "[package]",
        "name = \"habeas\"",
        "version = \"0.2.0\"",
        "authors = [\"Niko Matsakis\"]",
        "edition = \"2024\"",
        "description = \"Requirement evidence for mdBook and Cargo projects\"",
        "license = \"MIT OR Apache-2.0\"",
        "repository = \"https://github.com/nikomatsakis/habeas-codicem\"",
        "readme = \"README.md\"",
        "keywords = [\"requirements\", \"traceability\", \"evidence\", \"mdbook\"]",
        "categories = [\"development-tools\", \"command-line-utilities\"]",
        "",
        "# {impl}`requirements.integration.symposium`",
        "[package.metadata.symposium]",
        "name = \"habeas\"",
        "",
        "[package.metadata.symposium.defaults]",
        "skills = false",
        "",
        "[[package.metadata.symposium.skills]]",
        "source.path = \"assets/skills\"",
        "",
        "# {impl}`requirements.integration.symposium_cli`",
        "[[package.metadata.symposium.installations]]",
        "name = \"habeas\"",
        "source = \"cargo\"",
        "crate = \"habeas\"",
        "executable = \"habeas\"",
        "global = true",
        "",
        "# {impl}`requirements.integration.symposium_setup_hook`",
        "[[package.metadata.symposium.hooks]]",
        "name = \"habeas-setup-check\"",
        "event = \"SessionStart\"",
        "format = \"symposium\"",
        "command = \"habeas\"",
        "args = [\"hook\", \"session-start\"]",
        "",
        "[dependencies]",
        "aws-config = \"=1.8.13\"",
        "aws-sdk-bedrockruntime = \"1.153\"",
        "clap = { version = \"4.6.7\", features = [\"derive\"] }",
        "mdbook-preprocessor = \"=0.5.3\"",
        "proc-macro2 = { version = \"1.0.107\", features = [\"span-locations\"] }",
        "pulldown-cmark = \"=0.11.3\"",
        "rig-bedrock = \"0.44\"",
        "rig-core = { version = \"0.44\", features = [\"reqwest\"] }",
        "serde = { version = \"1.0.229\", features = [\"derive\"] }",
        "serde_json = \"1\"",
        "syn = { version = \"2.0.119\", features = [\"full\", \"visit\"] }",
        "tokio = { version = \"1.54.1\", features = [\"rt-multi-thread\", \"signal\", \"macros\"] }",
        "toml = \"1.2.0\"",
        "toml_edit = \"0.25.17\"",
        "",
        "[dev-dependencies]",
        "tempfile = \"3.27.0\""
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "use#1",
      "text": [
        "use clap::{ArgGroup, Parser, Subcommand};"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "use#2",
      "text": [
        "use std::error::Error;"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "use#3",
      "text": [
        "use std::io;"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "use#4",
      "text": [
        "use std::io::Write;"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "use#5",
      "text": [
        "use std::path::PathBuf;"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "mod[hook]",
      "text": [
        "mod hook;"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "mod[setup]",
      "text": [
        "mod setup;"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "struct[Cli]",
      "text": [
        "// {impl}`requirements.cli.clap`",
        "#[derive(Parser)]",
        "#[command(name = \"habeas\")]",
        "struct Cli {",
        "    #[command(subcommand)]",
        "    command: Command,",
        "}"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "enum[Command]",
      "text": [
        "#[derive(Subcommand)]",
        "enum Command {",
        "    Mdbook {",
        "        #[command(subcommand)]",
        "        command: Option<MdbookCommand>,",
        "    },",
        "    Setup {",
        "        #[arg(long, value_name = \"crate-dir\")]",
        "        path: Option<PathBuf>,",
        "    },",
        "    Status {",
        "        #[arg(long)]",
        "        all: bool,",
        "        glob: Option<String>,",
        "    },",
        "    Info {",
        "        selector: String,",
        "    },",
        "    AuthorEvidence {",
        "        subject: String,",
        "        #[arg(long)]",
        "        config: Option<String>,",
        "        /// Write evidence JSON to stdout instead of updating its file.",
        "        #[arg(long)]",
        "        stdout: bool,",
        "    },",
        "    #[command(hide = true)]",
        "    Hook {",
        "        #[command(subcommand)]",
        "        command: HookCommand,",
        "    },",
        "    #[command(",
        "        group(ArgGroup::new(\"target\").required(true).multiple(false).args([\"for_requirement\", \"for_example\", \"for_rust_item\"])),",
        "        group(ArgGroup::new(\"mode\").required(true).multiple(false).args([\"file_range\", \"rust_item\", \"requirements\"]))",
        "    )]",
        "    AddInput {",
        "        #[arg(long)]",
        "        for_requirement: Option<String>,",
        "        #[arg(long)]",
        "        for_example: Option<String>,",
        "        #[arg(long, num_args = 2, value_names = [\"rust_file\", \"rust_item\"])]",
        "        for_rust_item: Option<Vec<String>>,",
        "        #[arg(long)]",
        "        file_range: Option<String>,",
        "        #[arg(long)]",
        "        rust_item: Option<String>,",
        "        #[arg(long)]",
        "        requirements: Option<String>,",
        "    },",
        "}"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "fn[main]",
      "text": [
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    match Cli::parse().command {",
        "        // {impl}`requirements.cli.mdbook`",
        "        Command::Mdbook { command: None } => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { renderer }),",
        "        } => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }",
        "        // {impl}`requirements.cli.setup`",
        "        Command::Setup { path } => setup::run(path.as_deref()),",
        "        // {impl}`requirements.cli.status`",
        "        Command::Status { all, glob } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout().lock().write_all(",
        "                habeas::status_markdown_filtered(&root, all, glob.as_deref())?.as_bytes(),",
        "            )?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.info`",
        "        Command::Info { selector } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::info_markdown(&root, &selector)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.authoring.invocation`",
        "        Command::AuthorEvidence {",
        "            subject,",
        "            config,",
        "            stdout,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            let output = if stdout {",
        "                habeas::authoring::EvidenceOutput::Stdout",
        "            } else {",
        "                habeas::authoring::EvidenceOutput::File",
        "            };",
        "            let outcome = tokio::runtime::Runtime::new()?.block_on(",
        "                habeas::authoring::author_evidence_with_output(",
        "                    &root,",
        "                    &subject,",
        "                    config.as_deref(),",
        "                    output,",
        "                ),",
        "            )?;",
        "            let summary = format!(",
        "                \"{}: {} / {} — {}\",",
        "                outcome.subject,",
        "                outcome.backend,",
        "                outcome.model,",
        "                outcome.determination.kind(),",
        "            );",
        "            if let Some(path) = outcome.evidence_path {",
        "                println!(",
        "                    \"{summary}\\nEvidence: {}\\nUsage: {}\",",
        "                    path.display(),",
        "                    outcome.usage_path.display()",
        "                );",
        "            } else {",
        "                eprintln!(",
        "                    \"{summary}\\nEvidence: stdout\\nUsage: {}\",",
        "                    outcome.usage_path.display()",
        "                );",
        "            }",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.integration.symposium_setup_hook`",
        "        Command::Hook {",
        "            command: HookCommand::SessionStart,",
        "        } => hook::session_start(),",
        "        // {impl}`requirements.cli.add_input`",
        "        Command::AddInput {",
        "            for_requirement,",
        "            for_example,",
        "            for_rust_item,",
        "            file_range,",
        "            rust_item,",
        "            requirements,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            let target = if let Some(name) = for_requirement {",
        "                habeas::InputTarget::Requirement(name)",
        "            } else if let Some(name) = for_example {",
        "                habeas::InputTarget::Example(name)",
        "            } else {",
        "                let parts = for_rust_item.expect(\"clap requires a target\");",
        "                habeas::InputTarget::RustFunction {",
        "                    rust_file: parts[0].clone(),",
        "                    rust_item: parts[1].clone(),",
        "                }",
        "            };",
        "            let mode = if let Some(specification) = file_range {",
        "                habeas::InputMode::FileRange(specification)",
        "            } else if let Some(specification) = rust_item {",
        "                habeas::InputMode::RustItemsAtLine(specification)",
        "            } else {",
        "                habeas::InputMode::Requirements(requirements.expect(\"clap requires an input mode\"))",
        "            };",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::add_input(&root, target, mode)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "    }",
        "}"
      ]
    }
  ]
}
