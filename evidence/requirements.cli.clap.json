{
  "requirement": "The `habeas` CLI MUST use `clap` to define and parse its commands and options.",
  "determination": true,
  "rationale": "**Implementation**\n\n- `Cargo.toml` depends on `clap = { version = \"4.6.7\", features = [\"derive\"] }`.\n- `src/main.rs` imports `clap::{ArgGroup, Parser, Subcommand}`.\n- `struct Cli` is annotated `// {impl}`requirements.cli.clap``. It uses `#[derive(Parser)]` and `#[command(name = \"habeas\")]`, with a `#[command(subcommand)]` field.\n- `enum Command`, `MdbookCommand` and `HookCommand` use `#[derive(Subcommand)]`. Options are declared with `#[arg(...)]`. `ArgGroup`s enforce required and mutually exclusive targets for `author` and `add-input`.\n- `main()` is also annotated `{impl}` and calls `Cli::parse()`.\n- A search of `src` found no `std::env::args` or `args_os` use, so there is no hand-rolled argument parsing alongside clap.\n\n**Tests**\n\n- No test is tagged `{test}`requirements.cli.clap``. That is acceptable. The requirement is structural (\"MUST use clap\"), and a test would only restate the derive.\n- Several integration tests exercise clap's behavior through the real binary.\n  - `tests/cli.rs` checks that an unknown command, an unknown option, and `setup --install-skills` fail with a clap-style `Usage: habeas` message.\n  - It also checks that `mdbook supports` parses its renderer argument.\n  - `tests/authoring_cli.rs` and `tests/commands.rs` run `author` with `--stdout` and the `status` command through the same parser.\n\nThe requirement is met.",
  "inputs": [
    {
      "requirements": "requirements.cli.clap",
      "matches": [
        "requirements.cli.clap"
      ],
      "text": [
        ":::{req} clap",
        "The `habeas` CLI MUST use `clap` to define and parse its commands and options.",
        ":::"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "struct[Cli]",
      "text": [
        "// {impl}`requirements.cli.clap`",
        "#[derive(Parser)]",
        "#[command(name = \"habeas\")]",
        "struct Cli {",
        "    #[command(subcommand)]",
        "    command: Command,",
        "}"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "fn[main]",
      "text": [
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    let cli = Cli::parse();",
        "    // {impl}`requirements.configuration.workspace_location`",
        "    // {impl}`requirements.configuration.workspace_structure`",
        "    // {impl}`requirements.configuration.loading`",
        "    if !matches!(",
        "        cli.command,",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { .. })",
        "        }",
        "    ) {",
        "        habeas::config::load_workspace_evidence(&std::env::current_dir()?)?;",
        "    }",
        "    match cli.command {",
        "        // {impl}`requirements.cli.mdbook`",
        "        Command::Mdbook { command: None } => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { renderer }),",
        "        } => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }",
        "        // {impl}`requirements.cli.setup`",
        "        Command::Setup { path } => setup::run(path.as_deref()),",
        "        // {impl}`requirements.cli.status`",
        "        // {impl}`requirements.cli.fixme_summary`",
        "        Command::Status { all, glob, verbose } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout().lock().write_all(",
        "                habeas::status_markdown_with_options(&root, all, glob.as_deref(), verbose)?",
        "                    .as_bytes(),",
        "            )?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.info`",
        "        Command::Info { selector } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::info_markdown(&root, &selector)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.authoring.invocation`",
        "        // {impl}`requirements.authoring.batch`",
        "        // {impl}`requirements.authoring.concurrency`",
        "        // {impl}`requirements.authoring.reporting`",
        "        Command::Author {",
        "            subject,",
        "            all,",
        "            config,",
        "            stdout,",
        "            verbose,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            // Tokio's fixed worker pool is shared by all async assessments.",
        "            let runtime = tokio::runtime::Runtime::new()?;",
        "            if all {",
        "                let outcome = runtime.block_on(habeas::authoring::author_all_with_options(",
        "                    &root,",
        "                    config.as_deref(),",
        "                    habeas::authoring::AuthoringOptions { verbose },",
        "                ))?;",
        "                println!(",
        "                    \"{} authored; {} unchanged; {} failed\",",
        "                    outcome.completed.len(),",
        "                    outcome.unchanged,",
        "                    outcome.failures.len()",
        "                );",
        "                if !outcome.failures.is_empty() {",
        "                    return Err(io::Error::other(",
        "                        \"evidence authoring failed for one or more subjects; see diagnostics above\",",
        "                    )",
        "                    .into());",
        "                }",
        "                return Ok(());",
        "            }",
        "            let output = if stdout {",
        "                habeas::authoring::EvidenceOutput::Stdout",
        "            } else {",
        "                habeas::authoring::EvidenceOutput::File",
        "            };",
        "            let outcome = runtime.block_on(habeas::authoring::author_evidence_with_output(",
        "                &root,",
        "                &subject.expect(\"clap requires a subject or --all\"),",
        "                config.as_deref(),",
        "                output,",
        "            ))?;",
        "            let mut summary = format!(",
        "                \"{}: {} / {}\",",
        "                outcome.subject, outcome.backend, outcome.model,",
        "            );",
        "            if matches!(outcome.determination, habeas::judgment::Judgment::Fixme(_)) {",
        "                summary.push_str(\" — FIXME\");",
        "            }",
        "            if matches!(outcome.determination, habeas::judgment::Judgment::False) {",
        "                eprintln!(\"{}: false\", outcome.subject);",
        "                if verbose {",
        "                    eprintln!(\"{}\", outcome.rationale);",
        "                }",
        "            }",
        "            if let Some(path) = outcome.evidence_path {",
        "                println!(",
        "                    \"{summary}\\nEvidence: {}\\nUsage: {}\",",
        "                    path.display(),",
        "                    outcome.usage_path.display()",
        "                );",
        "            } else {",
        "                eprintln!(",
        "                    \"{summary}\\nEvidence: stdout\\nUsage: {}\",",
        "                    outcome.usage_path.display()",
        "                );",
        "            }",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.integration.symposium_setup_hook`",
        "        Command::Hook {",
        "            command: HookCommand::SessionStart,",
        "        } => hook::session_start(),",
        "        // {impl}`requirements.cli.add_input`",
        "        Command::AddInput {",
        "            for_requirement,",
        "            for_example,",
        "            for_rust_item,",
        "            file_range,",
        "            rust_item,",
        "            requirements,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            let target = if let Some(name) = for_requirement {",
        "                habeas::InputTarget::Requirement(name)",
        "            } else if let Some(name) = for_example {",
        "                habeas::InputTarget::Example(name)",
        "            } else {",
        "                let parts = for_rust_item.expect(\"clap requires a target\");",
        "                habeas::InputTarget::RustFunction {",
        "                    rust_file: parts[0].clone(),",
        "                    rust_item: parts[1].clone(),",
        "                }",
        "            };",
        "            let mode = if let Some(specification) = file_range {",
        "                habeas::InputMode::FileRange(specification)",
        "            } else if let Some(specification) = rust_item {",
        "                habeas::InputMode::RustItemsAtLine(specification)",
        "            } else {",
        "                habeas::InputMode::Requirements(requirements.expect(\"clap requires an input mode\"))",
        "            };",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::add_input(&root, target, mode)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "    }",
        "}"
      ]
    },
