        "    // {impl}`requirements.ci.outcomes`",
        "    // {impl}`requirements.authoring.persistence`",
        "    pub fn to_value(&self) -> Value {",
        "        match self {",
        "            Self::True => Value::Bool(true),",
        "            Self::False => Value::Bool(false),",
        "            Self::Fixme(entries) => json!({ \"FIXME\": entries }),",
        "        }",
        "    }"
