        "// {impl}`requirements.index.detail_format`",
        "fn code_language(file: Option<&str>) -> &'static str {",
        "    match file",
        "        .and_then(|file| Path::new(file).extension())",
        "        .and_then(|extension| extension.to_str())",
        "    {",
        "        Some(\"rs\") => \"rust,noplayground\",",
        "        Some(\"md\") => \"markdown\",",
        "        Some(\"json\") => \"json\",",
        "        Some(\"toml\") => \"ini\",",
        "        Some(\"java\") => \"java\",",
        "        Some(\"js\" | \"jsx\" | \"mjs\" | \"cjs\") => \"javascript\",",
        "        Some(\"ts\" | \"tsx\" | \"mts\" | \"cts\") => \"typescript\",",
        "        Some(\"py\") => \"python\",",
        "        _ => \"plaintext\",",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/index.rs",
      "rust_item": "fn[push_code_block]",
      "text": [
        "// {impl}`requirements.index.detail_format`",
        "fn push_code_block(content: &mut String, text: &str, language: &str) {",
        "    let longest = text",
        "        .split(|character| character != '`')",
        "        .map(str::len)",
        "        .max()",
        "        .unwrap_or(0);",
        "    let fence = \"`\".repeat(longest.max(2) + 1);",
        "    content.push_str(&fence);",
        "    content.push_str(language);",
        "    content.push('\\n');",
        "    content.push_str(text);",
        "    content.push('\\n');",
        "    content.push_str(&fence);",
        "    content.push('\\n');",
        "}"
      ]
    },
