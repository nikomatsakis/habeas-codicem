{
  "requirement": "The Habeas Codicem project MUST keep its mdBook Markdown in `md/` and Rust source in `src/`, and its own book MUST use the Habeas preprocessor.",
  "determination": true,
  "rationale": "book.toml points to md and registers the Habeas preprocessor; the book chapters and Rust library reside in the required directories.",
  "inputs": [
    {
      "file": "book.toml",
      "line_start": 1,
      "line_end": 18,
      "text": [
        "[book]",
        "title = \"Habeas Codicem\"",
        "language = \"en\"",
        "src = \"md\"",
        "",
        "[preprocessor.habeas]",
        "command = \"cargo habeas mdbook\"",
        "renderers = [\"html\"]",
        "",
        "[output.html]",
        "additional-css = [\"md/habeas.css\"]",
        "site-url = \"/habeas-codicem/\"",
        "git-repository-url = \"https://github.com/nikomatsakis/habeas-codicem\"",
        "edit-url-template = \"https://github.com/nikomatsakis/habeas-codicem/edit/main/{path}\"",
        "",
        "[output.html.fold]",
        "enable = true",
        "level = 0"
      ]
    },
    {
      "file": "md/SUMMARY.md",
      "line_start": 1,
      "line_end": 24,
      "text": [
        "# Summary",
        "",
        "- [Intro](./intro.md)",
        "- [Getting started](./getting_started.md)",
        "",
        "# Reference",
        "",
        "- [How it works](./reference.md)",
        "",
        "# Appendix",
        "",
        "- [Requirements](./requirements.md)",
        "  - [CI and evidence validation](./requirements/ci.md)",
        "  - [Configuration](./requirements/configuration.md)",
        "  - [Authoring evidence](./requirements/authoring.md)",
        "  - [Command-line interface](./requirements/cli.md)",
        "  - [References and Rust items](./requirements/references.md)",
        "  - [Named examples](./requirements/examples.md)",
        "  - [Named definitions](./requirements/definitions.md)",
        "  - [Book rendering](./requirements/index/README.md)",
        "  - [Installation](./requirements/install.md)",
        "  - [Project integration](./requirements/integration.md)",
        "  - [Project layout](./requirements/layout.md)",
        "- [Requirements index](./requirements-index.md)"
      ]
    },
    {
      "file": "md/requirements.md",
      "line_start": 1,
      "line_end": 3,
      "text": [
        "# Requirements",
        "",
        "Capitalized requirement terms in this chapter use the meanings defined by BCP 14 ([RFC 2119](https://www.rfc-editor.org/rfc/rfc2119) and [RFC 8174](https://www.rfc-editor.org/rfc/rfc8174))."
      ]
    }
  ]
}
