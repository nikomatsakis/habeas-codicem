        "// {impl}`requirements.ci.book_source`",
        "// {impl}`requirements.configuration.loading`",
        "// {impl}`requirements.ci.diagnostics`",
        "fn book_source_dir(root: &Path, errors: &mut Vec<String>) -> PathBuf {",
        "    let path = root.join(\"book.toml\");",
        "    let source = match fs::read_to_string(&path) {",
        "        Ok(content) => match content.parse::<DocumentMut>() {",
        "            Ok(book) => {",
        "                let table = match book.get(\"book\") {",
        "                    Some(item) => match item.as_table_like() {",
        "                        Some(table) => Some(table),",
        "                        None => {",
        "                            errors.push(\"book.toml: book must be a table\".to_owned());",
        "                            return root.join(\"md\");",
        "                        }",
        "                    },",
        "                    None => None,",
        "                };",
        "                match table.and_then(|table| table.get(\"src\")) {",
        "                    Some(item) => match item.as_str() {",
        "                        Some(source) => source.to_owned(),",
        "                        None => {",
        "                            errors.push(\"book.toml: book.src must be a string\".to_owned());",
        "                            return root.join(\"md\");",
        "                        }",
        "                    },",
        "                    None => \"src\".to_owned(),",
        "                }",
        "            }",
        "            Err(error) => {",
        "                errors.push(format!(\"book.toml: invalid TOML: {error}\"));",
        "                return root.join(\"md\");",
        "            }",
        "        },",
        "        Err(error) => {",
        "            errors.push(format!(",
        "                \"book.toml: cannot read book configuration: {error}\"",
        "            ));",
        "            return root.join(\"md\");",
        "        }",
        "    };",
        "    let relative = Path::new(&source);",
        "    if source.is_empty()",
        "        || !relative",
        "            .components()",
        "            .all(|part| matches!(part, Component::Normal(_) | Component::CurDir))",
        "    {",
        "        errors.push(\"book.toml: book.src must be a directory inside the repository\".to_owned());",
        "        return root.join(\"md\");",
        "    }",
        "    root.join(relative)",
        "}",
        "",
        "// {impl}`requirements.ci.definition_errors`",
        "// {impl}`requirements.ci.identifiers`",
        "// {impl}`requirements.examples.definition`",
        "// {impl}`requirements.definitions.declaration`",
        "fn collect_definitions(",
        "    root: &Path,",
        "    md_root: &Path,",
        "    errors: &mut Vec<String>,",
        ") -> BTreeMap<String, Declaration> {",
        "    let mut definitions = BTreeMap::new();",
        "",
        "    for file in files_with_extension(root, md_root, \"md\", errors) {",
        "        let relative = file",
        "            .strip_prefix(md_root)",
        "            .expect(\"chapter file is inside md directory\");",
        "        if relative == Path::new(\"SUMMARY.md\") {",
        "            continue;",
        "        }",
        "",
        "        let label = display_path(root, &file);",
        "        let content = match fs::read_to_string(&file) {",
        "            Ok(content) => content,",
        "            Err(error) => {",
        "                errors.push(format!(\"{label}: cannot read chapter: {error}\"));",
        "                continue;",
        "            }",
        "        };",
        "        let namespace = chapter_namespace(relative);",
        "        for block in definition_blocks(&content) {",
        "            let line = content[..block.start]",
        "                .bytes()",
        "                .filter(|byte| *byte == b'\\n')",
        "                .count()",
        "                + 1;",
        "            let source = format!(\"{label}:{line}\");",
        "            let name = full_requirement_name(&namespace, &block.name);",
        "            if !valid_name(&name) {",
        "                errors.push(format!(",
        "                    \"{source}: invalid {} name {name:?}\",",
        "                    block.kind.noun()",
        "                ));",
        "                continue;",
        "            }",
        "",
        "            if !block.closed {",
        "                errors.push(format!(",
        "                    \"{source}: {} {name} is missing a closing colon fence\",",
        "                    block.kind.noun()",
        "                ));",
        "            }",
        "            // {impl}`requirements.ci.span`",
        "            let text = content[block.body_start..block.body_end].trim().to_owned();",
        "            if text.is_empty() {",
        "                errors.push(format!(",
        "                    \"{source}: {} {name} has no text\",",
        "                    block.kind.noun()",
        "                ));",
        "            }",
        "",
        "            if block.kind == DefinitionKind::Term",
        "                && let Err(error) = crate::terms::declaration(&text)",
        "            {",
        "                errors.push(format!(\"{source}: definition {name}: {error}\"));",
        "            }",
        "            match definitions.entry(name.clone()) {",
        "                Entry::Vacant(slot) => {",
        "                    let raw_lines = content[block.start..block.end]",
        "                        .lines()",
        "                        .map(|line| line.strip_suffix('\\r').unwrap_or(line).to_owned())",
        "                        .collect::<Vec<_>>();",
        "                    slot.insert(Declaration {",
        "                        kind: block.kind,",
        "                        text,",
        "                        source,",
        "                        file: label.clone(),",
        "                        line_start: line,"
      ]
    },
    {
      "file": "src/lib.rs",
      "line_start": 386,
      "line_end": 566,
      "text": [
        "            result.push_str(&content[reference.start..reference.end]);",
        "        }",
        "        cursor = reference.end;",
        "    }",
        "",
        "    result.push_str(&content[cursor..]);",
        "    result",
        "}",
        "",
        "// {impl}`requirements.references.book_badges`",
        "// {impl}`requirements.references.safe_badges`",
        "pub(crate) fn shield_badge(label: &str, message: &str, color: &str) -> String {",
        "    let url = format!(",
        "        \"https://img.shields.io/badge/{}-{}-{color}?style=flat-square&labelColor=555\",",
        "        shield_path_component(label),",
        "        shield_path_component(message)",
        "    );",
        "    format!(",
        "        \"<img class=\\\"habeas-shield\\\" src=\\\"{}\\\" alt=\\\"{} {}\\\" loading=\\\"lazy\\\">\",",
        "        escape_html(&url),",
        "        escape_html(label),",
        "        escape_html(message)",
        "    )",
        "}",
        "",
        "// {impl}`requirements.references.safe_badges`",
        "fn shield_path_component(value: &str) -> String {",
        "    let mut encoded = String::with_capacity(value.len());",
        "    for byte in value.bytes() {",
        "        match byte {",
        "            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'.' => encoded.push(char::from(byte)),",
        "            b' ' => encoded.push('_'),",
        "            b'_' => encoded.push_str(\"__\"),",
        "            b'-' => encoded.push_str(\"--\"),",
        "            _ => encoded.push_str(&format!(\"%{byte:02X}\")),",
        "        }",
        "    }",
        "    encoded",
        "}",
        "",
        "// {impl}`requirements.index.navigation`",
        "pub(crate) fn chapter_href(current: &Path, target: &Path, anchor: Option<&str>) -> String {",
        "    let current_dir = current",
        "        .parent()",
        "        .into_iter()",
        "        .flat_map(Path::components)",
        "        .filter_map(|component| match component {",
        "            Component::Normal(part) => Some(part.to_string_lossy().into_owned()),",
        "            _ => None,",
        "        })",
        "        .collect::<Vec<_>>();",
        "    let target_html = target",
        "        .with_extension(\"html\")",
        "        .components()",
        "        .filter_map(|component| match component {",
        "            Component::Normal(part) => Some(part.to_string_lossy().into_owned()),",
        "            _ => None,",
        "        })",
        "        .collect::<Vec<_>>();",
        "    let shared = current_dir",
        "        .iter()",
        "        .zip(&target_html)",
        "        .take_while(|(left, right)| left == right)",
        "        .count();",
        "    let mut href = \"../\".repeat(current_dir.len() - shared);",
        "    href.push_str(&target_html[shared..].join(\"/\"));",
        "    if let Some(anchor) = anchor {",
        "        href.push('#');",
        "        href.push_str(anchor);",
        "    }",
        "    // mdBook interprets \".md\" inside a generated URL as a chapter suffix.",
        "    href.replace(\".md\", \"%2Emd\")",
        "}",
        "",
        "// {impl}`requirements.ci.identifiers`",
        "// {impl}`requirements.ci.coverage`",
        "fn full_requirement_name(namespace: &str, name: &str) -> String {",
        "    if namespace.is_empty() {",
        "        name.to_owned()",
        "    } else {",
        "        format!(\"{namespace}.{name}\")",
        "    }",
        "}",
        "",
        "// {impl}`requirements.ci.span`",
        "// {impl}`requirements.ci.identifiers`",
        "// {impl}`requirements.references.markdown_literals`",
        "// {impl}`requirements.examples.definition`",
        "// {impl}`requirements.definitions.declaration`",
        "// {impl}`requirements.ci.fence_lengths`",
        "pub(crate) fn definition_blocks(content: &str) -> Vec<DefinitionBlock> {",
        "    let code_ranges = Parser::new(content)",
        "        .into_offset_iter()",
        "        .filter_map(|(event, range)| {",
        "            matches!(event, Event::Start(Tag::CodeBlock(_))).then_some(range)",
        "        })",
        "        .collect::<Vec<_>>();",
        "    let mut lines = Vec::new();",
        "    let mut position = 0;",
        "    for segment in content.split_inclusive('\\n') {",
        "        let end = position + segment.len();",
        "        lines.push((",
        "            position,",
        "            end,",
        "            segment.trim_end_matches('\\n').trim_end_matches('\\r'),",
        "        ));",
        "        position = end;",
        "    }",
        "",
        "    let mut blocks = Vec::new();",
        "    let mut index = 0;",
        "    while index < lines.len() {",
        "        let (start, body_start, line) = lines[index];",
        "        let Some((suffix, fence_length)) = colon_fence(line) else {",
        "            index += 1;",
        "            continue;",
        "        };",
        "        let (kind, rest) = if let Some(rest) = suffix.strip_prefix(\"{req}\") {",
        "            (DefinitionKind::Requirement, rest)",
        "        } else if let Some(rest) = suffix.strip_prefix(\"{example}\") {",
        "            (DefinitionKind::Example, rest)",
        "        } else if let Some(rest) = suffix.strip_prefix(\"{definition}\") {",
        "            (DefinitionKind::Term, rest)",
        "        } else {",
        "            index += 1;",
        "            continue;",
        "        };",
        "        if overlaps_protected(start, body_start, &code_ranges)",
        "            || !rest.chars().next().is_some_and(char::is_whitespace)",
        "            || !valid_name(rest.trim())",
        "        {",
        "            index += 1;",
        "            continue;",
        "        }",
        "        let name = rest.trim();",
        "",
        "        let close_index = (index + 1..lines.len()).find(|&candidate| {",
        "            !overlaps_protected(lines[candidate].0, lines[candidate].1, &code_ranges)",
        "                && colon_fence(lines[candidate].2).is_some_and(|(suffix, count)| {",
        "                    count >= fence_length && suffix.trim().is_empty()",
        "                })",
        "        });",
        "        let (end, body_end, closed) = if let Some(close_index) = close_index {",
        "            (lines[close_index].1, lines[close_index].0, true)",
        "        } else {",
        "            (content.len(), content.len(), false)",
        "        };",
        "        blocks.push(DefinitionBlock {",
        "            start,",
        "            end,",
        "            body_start,",
        "            body_end,",
        "            name: name.to_owned(),",
        "            kind,",
        "            closed,",
        "        });",
        "        index += 1;",
        "    }",
        "    blocks",
        "}",
        "",
        "// {impl}`requirements.ci.span`",
        "// {impl}`requirements.ci.fence_lengths`",
        "fn colon_fence(line: &str) -> Option<(&str, usize)> {",
        "    let trimmed = line.trim_start_matches(' ');",
        "    if line.len() - trimmed.len() > 3 {",
        "        return None;",
        "    }",
        "    let length = trimmed.bytes().take_while(|byte| *byte == b':').count();",
        "    (length >= 3).then_some((&trimmed[length..], length))",
        "}",
        "",
        "// {impl}`requirements.references.markdown_literals`",
        "fn overlaps_protected(start: usize, end: usize, ranges: &[Range<usize>]) -> bool {",
        "    ranges",
        "        .iter()",
        "        .any(|range| start < range.end && range.start < end)",
        "}",
        "",
        "// {impl}`requirements.references.targets`",
        "// {impl}`requirements.ci.identifiers`"
      ]
    }
  ]
}
