  "inputs": [
    {
      "rust_file": "tests/definitions.rs",
      "rust_item": "fn[phrases_are_plain_links_and_markdown_literals_are_preserved]",
      "text": [
        "// {test}`requirements.definitions.phrase_rendering`",
        "// {test}`requirements.definitions.references`",
        "#[test]",
        "fn phrases_are_plain_links_and_markdown_literals_are_preserved() {",
        "    let mut book = Book::new();",
        "    book.push_item(Chapter::new(",
        "        \"Glossary\",",
        "        \":::{definition} a\\n:phrase: *alpha* & <beta>\\n\\nThe body.\\n:::\\n\".into(),",
        "        \"glossary.md\",",
        "        Vec::new(),",
        "    ));",
        "    let source = \"Use TERM`glossary.a`.\\n\\n`TERM`glossary.a``\\n\\n```text\\nTERM`glossary.a`\\n```\\n\\n\\\\TERM`glossary.a`\".replace(\"TERM\", \"{term}\");",
        "    book.push_item(Chapter::new(\"Guide\", source, \"guide/deep.md\", Vec::new()));",
        "    habeas::preprocess_book(&mut book, Path::new(\".\")).unwrap();",
        "    let chapters: Vec<_> = book.chapters().collect();",
        "    assert!(",
        "        chapters[0]",
        "            .content",
        "            .contains(\"id=\\\"habeas-definition-glossary.a\\\"\")",
        "    );",
        "    assert!(!chapters[0].content.contains(\":phrase:\"));",
        "    assert!(!chapters[1].content.contains(\"shields.io\"));",
        "    assert_eq!(",
        "        chapters[1]",
        "            .content",
        "            .matches(\"href=\\\"../glossary.html#habeas-definition-glossary.a\\\"\")",
        "            .count(),",
        "        1",
        "    );",
        "    assert!(",
        "        chapters[1]",
        "            .content",
        "            .contains(\"&#42;alpha&#42; &amp; &lt;beta&gt;\")",
        "    );",
        "}"
      ]
    }
  ],
  "example": "A definition named `glossary.first_parent_history` declares the phrase \"first-parent history\". A term reference to that name renders the phrase as an ordinary hyperlink to the declaration, without displaying the identifier or a badge. {cite}`requirements.definitions.references`",
  "determination": true,
  "rationale": "phrases_are_plain_links_and_markdown_literals_are_preserved checks the declaration anchor, cross-chapter href, escaped plain phrase, absence of badge images, and preserved literal examples."
