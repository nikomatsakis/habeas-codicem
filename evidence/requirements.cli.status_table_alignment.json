{
  "requirement": "When `habeas status` or `habeas status --all` displays a Markdown table, it MUST left-align and space-pad the Definition and Evidence columns so every row, including the header and separator row, has its `|` column delimiters in the same positions. Column widths MUST be determined by the widest displayed cell in each column.",
  "determination": true,
  "rationale": "The shared table renderer calculates both column widths and pads every row including the header and separator. The alignment test verifies delimiter positions and widths.",
  "inputs": [
    {
      "file": "tests/commands.rs",
      "line_start": 286,
      "line_end": 331,
      "text": [
        "// {test}`requirements.cli.status_table_alignment`",
        "#[test]",
        "fn status_tables_align_each_column_to_its_widest_cell() {",
        "    let temp = fixture();",
        "    for args in [[\"status\"].as_slice(), [\"status\", \"--all\"].as_slice()] {",
        "        let output = habeas(temp.path(), args);",
        "        assert!(output.status.success(), \"{args:?}: {output:?}\");",
        "        let text = String::from_utf8(output.stdout).unwrap();",
        "        let table = text",
        "            .lines()",
        "            .skip_while(|line| !line.starts_with(\"| \"))",
        "            .take_while(|line| line.starts_with(\"| \"))",
        "            .collect::<Vec<_>>();",
        "        assert!(table.len() > 2, \"{text}\");",
        "        let pipes = table[0]",
        "            .match_indices('|')",
        "            .map(|(index, _)| index)",
        "            .collect::<Vec<_>>();",
        "        assert_eq!(pipes.len(), 3, \"{text}\");",
        "        for line in &table {",
        "            let actual = line",
        "                .match_indices('|')",
        "                .map(|(index, _)| index)",
        "                .collect::<Vec<_>>();",
        "            assert_eq!(actual, pipes, \"{text}\");",
        "            for cell in line.split('|').skip(1).take(2) {",
        "                assert!(cell.starts_with(' ') && cell.ends_with(' '), \"{text}\");",
        "                assert!(!cell[1..].starts_with(' '), \"{text}\");",
        "            }",
        "        }",
        "        for column in 0..2 {",
        "            let content_width = table",
        "                .iter()",
        "                .map(|line| line.split('|').nth(column + 1).unwrap().trim().len())",
        "                .max()",
        "                .unwrap();",
        "            assert_eq!(",
        "                pipes[column + 1] - pipes[column] - 3,",
        "                content_width,",
        "                \"{text}\"",
        "            );",
        "        }",
        "        assert_eq!(table[1].split('|').nth(1).unwrap().trim(), \"---\");",
        "        assert_eq!(table[1].split('|').nth(2).unwrap().trim(), \"---\");",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/markdown.rs",
      "rust_item": "fn[render_evidence_table]",
      "text": [
        "// {impl}`requirements.cli.status_table_alignment`",
        "// {impl}`requirements.cli.shared_status_rendering`",
        "pub(crate) fn render_evidence_table(rows: &[(String, &str)]) -> String {",
        "    let definition_width = rows",
        "        .iter()",
        "        .map(|(definition, _)| definition.len())",
        "        .max()",
        "        .unwrap_or_default()",
        "        .max(\"Definition\".len());",
        "    let evidence_width = rows",
        "        .iter()",
        "        .map(|(_, evidence)| evidence.len())",
        "        .max()",
        "        .unwrap_or_default()",
        "        .max(\"Evidence\".len());",
        "    let mut table = String::new();",
        "    for (definition, evidence) in [(\"Definition\", \"Evidence\"), (\"---\", \"---\")] {",
        "        table.push_str(&format!(",
        "            \"| {definition:<definition_width$} | {evidence:<evidence_width$} |\\n\"",
        "        ));",
        "    }",
        "    for (definition, evidence) in rows {",
        "        table.push_str(&format!(",
        "            \"| {definition:<definition_width$} | {evidence:<evidence_width$} |\\n\"",
        "        ));",
        "    }",
        "    table",
        "}"
      ]
    },
    {
      "rust_file": "tests/commands.rs",
      "rust_item": "fn[status_tables_align_each_column_to_its_widest_cell]",
      "text": [
