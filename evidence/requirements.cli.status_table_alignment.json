        "    let mut findings = String::new();",
        "    let mut fixmes = FixmeSummary::default();",
        "    let mut associated_errors = BTreeSet::new();",
        "",
        "    for (name, definition) in &inspection.definitions {",
        "        if definition.kind == crate::DefinitionKind::Term {",
        "            continue;",
        "        }",
