        "    let inspection = inspect_repository(root)?;",
        "    if let Some(glob) = glob {",
        "        definition_glob::validate(glob)",
        "            .map_err(|error| io::Error::new(io::ErrorKind::InvalidInput, error))?;",
        "        if !inspection.definitions.iter().any(|(name, d)| {",
