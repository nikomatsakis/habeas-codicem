{
  "requirement": "When `habeas status` or `habeas status --all` displays a Markdown table, it MUST left-align and space-pad the Requirement and Evidence columns so every row, including the header and separator row, has its `|` column delimiters in the same positions. Column widths MUST be determined by the widest displayed cell in each column.",
  "determination": true,
  "rationale": "The status renderer measures both displayed columns, left-aligns and pads the header, separator, and requirement rows, and uses the same path for default and --all output. The focused CLI test checks delimiter alignment, left alignment, and widths against displayed cell contents in both modes.",
  "inputs": [
    {
      "file": "src/commands.rs",
      "line_start": 19,
      "line_end": 44,
      "text": [
        "    for name in inspection.requirements.keys() {",
        "        let evidence = LoadedDetailEvidence::load(root, name, &inspection.report);",
        "        for error in evidence.errors() {",
        "            associated_errors.insert(error.clone());",
        "        }",
        "        if !all && evidence.state() == EvidenceState::Valid {",
        "            continue;",
        "        }",
        "",
        "        rows.push((format!(\"`{name}`\"), evidence.state().label()));",
        "        if !evidence.errors().is_empty() {",
        "            findings.push_str(&format!(\"\\n### `{name}`\\n\\n<pre><code>\"));",
        "            findings.push_str(&escape_html(&evidence.errors().join(\"\\n\\n\")));",
        "            findings.push_str(\"</code></pre>\\n\");",
        "        }",
        "    }",
        "",
        "    if rows.is_empty() {",
        "        output.push_str(if all {",
        "            \"No requirements found.\\n\"",
        "        } else {",
        "            \"All requirements have valid evidence.\\n\"",
        "        });",
        "    } else {",
        "        output.push_str(&render_status_table(&rows));",
        "    }"
      ]
    },
    {
      "file": "src/commands.rs",
      "line_start": 70,
      "line_end": 96,
      "text": [
        "// {impl}`requirements.cli.status_table_alignment`",
        "fn render_status_table(rows: &[(String, &'static str)]) -> String {",
        "    let requirement_width = rows",
        "        .iter()",
        "        .map(|(requirement, _)| requirement.len())",
        "        .max()",
        "        .unwrap_or_default()",
        "        .max(\"Requirement\".len());",
        "    let evidence_width = rows",
        "        .iter()",
        "        .map(|(_, evidence)| evidence.len())",
        "        .max()",
        "        .unwrap_or_default()",
        "        .max(\"Evidence\".len());",
        "    let mut table = String::new();",
        "    for (requirement, evidence) in [(\"Requirement\", \"Evidence\"), (\"---\", \"---\")] {",
        "        table.push_str(&format!(",
        "            \"| {requirement:<requirement_width$} | {evidence:<evidence_width$} |\\n\"",
        "        ));",
        "    }",
        "    for (requirement, evidence) in rows {",
        "        table.push_str(&format!(",
        "            \"| {requirement:<requirement_width$} | {evidence:<evidence_width$} |\\n\"",
        "        ));",
        "    }",
        "    table",
        "}"
      ]
    },
    {
      "file": "tests/commands.rs",
      "line_start": 238,
      "line_end": 283,
      "text": [
        "// {test}`requirements.cli.status_table_alignment`",
        "#[test]",
        "fn status_tables_align_each_column_to_its_widest_cell() {",
        "    let temp = fixture();",
        "    for args in [[\"status\"].as_slice(), [\"status\", \"--all\"].as_slice()] {",
        "        let output = habeas(temp.path(), args);",
        "        assert!(output.status.success(), \"{args:?}: {output:?}\");",
        "        let text = String::from_utf8(output.stdout).unwrap();",
        "        let table = text",
        "            .lines()",
        "            .skip_while(|line| !line.starts_with(\"| \"))",
        "            .take_while(|line| line.starts_with(\"| \"))",
        "            .collect::<Vec<_>>();",
        "        assert!(table.len() > 2, \"{text}\");",
        "        let pipes = table[0]",
        "            .match_indices('|')",
        "            .map(|(index, _)| index)",
        "            .collect::<Vec<_>>();",
        "        assert_eq!(pipes.len(), 3, \"{text}\");",
        "        for line in &table {",
        "            let actual = line",
        "                .match_indices('|')",
        "                .map(|(index, _)| index)",
        "                .collect::<Vec<_>>();",
        "            assert_eq!(actual, pipes, \"{text}\");",
        "            for cell in line.split('|').skip(1).take(2) {",
        "                assert!(cell.starts_with(' ') && cell.ends_with(' '), \"{text}\");",
        "                assert!(!cell[1..].starts_with(' '), \"{text}\");",
        "            }",
        "        }",
        "        for column in 0..2 {",
        "            let content_width = table",
        "                .iter()",
        "                .map(|line| line.split('|').nth(column + 1).unwrap().trim().len())",
        "                .max()",
        "                .unwrap();",
        "            assert_eq!(",
        "                pipes[column + 1] - pipes[column] - 3,",
        "                content_width,",
        "                \"{text}\"",
        "            );",
        "        }",
        "        assert_eq!(table[1].split('|').nth(1).unwrap().trim(), \"---\");",
        "        assert_eq!(table[1].split('|').nth(2).unwrap().trim(), \"---\");",
        "    }",
        "}"
      ]
    }
  ]
}
