{
  "example": "A current evidence record has `{\"FIXME\": [\"#125\"]}` and passes CI. A source comment\nwithin one of its recorded file-range inputs then changes. CI rejects the record\nbecause the recorded text no longer matches, even though its determination is\nstill FIXME. Validation reports the changed input without running a model or\nreassessing the documented gap.\n{cite}`requirements.ci.determination`\n{cite}`requirements.ci.inputs`",
  "determination": true,
  "rationale": "The outcome test starts from accepted FIXME evidence, changes a recorded source line, and checks the changed-input error and Invalid status. Adding an uncovered reference also fails without any model request.",
  "inputs": [
    {
      "rust_file": "tests/outcomes.rs",
      "rust_item": "fn[fixme_does_not_hide_stale_inputs_or_uncovered_references]",
      "text": [
        "// {test}`requirements.ci.inputs`",
        "// {test}`requirements.ci.fixme_stale_input`",
        "// {test}`requirements.index.state`",
        "#[test]",
        "fn fixme_does_not_hide_stale_inputs_or_uncovered_references() {",
        "    let temp = fixture();",
        "    fs::write(temp.path().join(\"observed.txt\"), \"changed source\\n\").unwrap();",
        "    let report = habeas::validate_repository(temp.path()).unwrap();",
        "    assert!(",
        "        report",
        "            .errors",
        "            .iter()",
        "            .any(|error| error.contains(\"input text changed\"))",
        "    );",
        "    let status = habeas::status_markdown(temp.path(), false).unwrap();",
        "    let row = status",
        "        .lines()",
        "        .find(|line| line.starts_with(\"| `requirements.timeout`\"))",
        "        .unwrap();",
        "    assert!(row.contains(\"Invalid\"), \"{row}\");",
        "    fs::write(",
        "        temp.path().join(\"other.txt\"),",
        "        \"CITE`requirements.timeout`\".replace(\"CITE\", \"{cite}\"),",
        "    )",
        "    .unwrap();",
        "    let report = habeas::validate_repository(temp.path()).unwrap();",
        "    assert!(",
        "        report",
        "            .errors",
        "            .iter()",
        "            .any(|error| error.contains(\"no input covers\"))",
        "    );",
        "}"
      ]
    }
  ]
}
