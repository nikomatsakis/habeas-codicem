{
  "requirement": "When given `--path <crate-dir>` and no existing Habeas dev dependency, `habeas setup` MUST add that local crate as the dev dependency. Repeating setup MUST NOT add a duplicate Habeas dependency.",
  "determination": true,
  "rationale": "Setup invokes cargo add with --path when the dev dependency is absent, and skips the add when it is already present. The integration test runs path setup repeatedly and checks the resulting manifest.",
  "inputs": [
    {
      "file": "src/setup.rs",
      "line_start": 125,
      "line_end": 146,
      "text": [
        "    // {impl}`requirements.cli.setup_local_path`",
        "    let has_dev_dependency = has_habeas_dev_dependency(&manifest);",
        "    if !has_dev_dependency {",
        "        let mut command = Command::new(\"cargo\");",
        "        command",
        "            .arg(\"add\")",
        "            .arg(\"--dev\")",
        "            .arg(\"habeas\")",
        "            .arg(\"--manifest-path\")",
        "            .arg(&manifest_path);",
        "        if let Some(local_crate) = local_crate {",
        "            command.arg(\"--path\").arg(fs::canonicalize(local_crate)?);",
        "        }",
        "        let output = command.current_dir(&root).output()?;",
        "        if !output.status.success() {",
        "            return Err(format!(",
        "                \"cargo add habeas --dev failed:\\n{}\",",
        "                String::from_utf8_lossy(&output.stderr)",
        "            )",
        "            .into());",
        "        }",
        "    }"
      ]
    },
    {
      "file": "tests/setup.rs",
      "line_start": 72,
      "line_end": 100,
      "text": [
        "// {test}`requirements.cli.setup`",
        "// {test}`requirements.cli.setup_css`",
        "// {test}`requirements.cli.setup_local_path`",
        "#[test]",
        "fn setup_is_repeatable() {",
        "    let temp = fixture();",
        "    let project = temp.path();",
        "    let local_crate = env!(\"CARGO_MANIFEST_DIR\");",
        "",
        "    run(project, &[\"setup\", \"--path\", local_crate]);",
        "    assert!(!project.join(\".agents/skills\").exists());",
        "    run(project, &[\"setup\", \"--path\", local_crate]);",
        "",
        "    let cargo = fs::read_to_string(project.join(\"Cargo.toml\")).unwrap();",
        "    assert!(cargo.contains(\"[dev-dependencies]\"));",
        "    assert!(cargo.contains(\"habeas\"));",
        "    assert!(cargo.contains(\"path = \"));",
        "    let book = fs::read_to_string(project.join(\"book.toml\")).unwrap();",
        "    assert!(book.contains(\"command = \\\"habeas mdbook\\\"\"));",
        "    assert!(book.contains(\"md/habeas.css\"));",
        "    assert!(book.contains(\"md/custom.css\"));",
        "    assert_eq!(book.matches(\"md/habeas.css\").count(), 1);",
        "    assert_eq!(",
        "        fs::read_to_string(project.join(\"tests/habeas.rs\")).unwrap(),",
        "        \"#[test]\\nfn habeas() {\\n    habeas::validate();\\n}\\n\"",
        "    );",
        "    assert!(project.join(\"md/habeas.css\").is_file());",
        "    assert!(!project.join(\".agents/skills\").exists());",
        "}"
      ]
    }
  ]
}
