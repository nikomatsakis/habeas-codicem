        "fn has_habeas_dev_dependency(manifest: &DocumentMut) -> bool {",
        "    manifest",
        "        .get(\"dev-dependencies\")",
        "        .and_then(Item::as_table_like)",
        "        .and_then(|table| table.get(\"habeas\"))",
        "        .is_some()",
        "}"
