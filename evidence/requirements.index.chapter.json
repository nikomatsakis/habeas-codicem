        "            (\"absent\", \"Absent MUST work.\"),",
        "            (\"uncovered\", \"Uncovered MUST work.\"),",
        "        ];",
        "        let mut source = String::from(\"# Requirements\\n\\n\");",
        "        for (name, body) in requirements {",
        "            source.push_str(&format!(\":::{{req}} {name}\\n{body}\\n:::\\n\\n\"));",
