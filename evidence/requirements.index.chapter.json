        "                    .join(format!(\"evidence/requirements.core.{name}.json\")),",
        "                json!({",
        "                    \"requirement\": body,",
        "                    \"determination\": determination,",
        "                    \"rationale\": \"The fixture records the evidence state.\",",
        "                    \"inputs\": []",
        "                })",
        "                .to_string(),",
        "            )",
        "            .unwrap();",
        "        }",
        "",
        "        let mut book = Book::new();",
        "        let mut definition_chapter =",
