        "        fs::write(temp.path().join(\"book.toml\"), \"[book]\\nsrc = \\\"md\\\"\\n\").unwrap();",
        "        let requirements = [",
        "            (\"ready\", \"Ready MUST work.\"),",
        "            (\"pending\", \"Pending MUST work.\"),",
