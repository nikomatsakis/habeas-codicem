        "            parent_names.push(chapter.name.clone());",
        "            let first_number = chapter",
        "                .sub_items",
        "                .iter()",
        "                .filter_map(|item| match item {",
        "                    BookItem::Chapter(child) => child.number.as_ref()?.last().copied(),",
        "                    _ => None,",
