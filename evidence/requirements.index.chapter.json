        "    // {test}`requirements.index.chapter`",
        "    #[test]",
        "    fn repeated_index_markers_fail_with_a_clear_error() {",
        "        let mut book = Book::new();",
        "        for path in [\"one.md\", \"two.md\"] {",
        "            book.push_item(Chapter::new(",
        "                \"Index\",",
        "                \":::{requirements-index}\\n:::\\n\".to_owned(),",
        "                path,",
