        "            [\"// {\", \"impl}`requirements.core.uncovered`\\n\"].concat(),",
        "        )",
        "        .unwrap();",
        "        for (name, body, determination) in [",
        "            (\"ready\", \"Ready MUST work.\", true),",
        "            (\"pending\", \"Pending MUST work.\", false),",
        "            (\"changed\", \"Old requirement.\", true),",
        "            (\"uncovered\", \"Uncovered MUST work.\", true),",
        "        ] {",
        "            fs::write(",
