        "// {impl}`requirements.ci.rust_item_inputs`",
        "// {impl}`requirements.ci.requirements_inputs`",
        "pub(crate) struct ResolvedInput {",
        "    pub(crate) ranges: Vec<SourceRange>,",
        "    pub(crate) text: Vec<String>,",
        "    pub(crate) matches: Vec<String>,",
        "}"
      ]
