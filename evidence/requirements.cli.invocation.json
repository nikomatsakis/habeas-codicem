{
  "requirement": "`habeas mdbook supports html` MUST succeed, and a support query for another renderer MUST fail. An unknown command or invalid setup option combination MUST fail with a usage message.",
  "determination": true,
  "rationale": "The CLI branches explicitly on renderer support and rejects unsupported renderers and invalid arguments with usage. The integration test exercises supported, unsupported, unknown, and invalid-option invocations.",
  "inputs": [
    {
      "file": "src/main.rs",
      "line_start": 8,
      "line_end": 50,
      "text": [
        "const USAGE: &str =",
        "    \"usage: habeas <mdbook | setup [--path <crate-dir>] [--install-skills] | agents>\";",
        "",
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    let args: Vec<String> = std::env::args().skip(1).collect();",
        "    match args.as_slice() {",
        "        // {impl}`requirements.cli.mdbook`",
        "        [command] if command == \"mdbook\" => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        [command, supports, renderer] if command == \"mdbook\" && supports == \"supports\" => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }",
        "        // {impl}`requirements.cli.setup`",
        "        [command, options @ ..] if command == \"setup\" => {",
        "            let (local_crate, install_skills) = match options {",
        "                [] => (None, false),",
        "                [flag] if flag == \"--install-skills\" => (None, true),",
        "                [flag, path] if flag == \"--path\" => (Some(Path::new(path)), false),",
        "                [flag, path, install] if flag == \"--path\" && install == \"--install-skills\" => {",
        "                    (Some(Path::new(path)), true)",
        "                }",
        "                [install, flag, path] if install == \"--install-skills\" && flag == \"--path\" => {",
        "                    (Some(Path::new(path)), true)",
        "                }",
        "                _ => return Err(USAGE.into()),",
        "            };",
        "            setup::run(local_crate, install_skills)",
        "        }",
        "        // {impl}`requirements.cli.agents`",
        "        [command] if command == \"agents\" => agents::run(),",
        "        // {impl}`requirements.cli.invocation`",
        "        _ => Err(USAGE.into()),",
        "    }",
        "}"
      ]
    },
    {
      "file": "tests/cli.rs",
      "line_start": 3,
      "line_end": 24,
      "text": [
        "// {test}`requirements.cli.invocation`",
        "#[test]",
        "fn renderer_support_and_invalid_commands() {",
        "    let binary = env!(\"CARGO_BIN_EXE_habeas\");",
        "    let supported = Command::new(binary)",
        "        .args([\"mdbook\", \"supports\", \"html\"])",
        "        .output()",
        "        .unwrap();",
        "    assert!(supported.status.success());",
        "",
        "    let unsupported = Command::new(binary)",
        "        .args([\"mdbook\", \"supports\", \"epub\"])",
        "        .output()",
        "        .unwrap();",
        "    assert!(!unsupported.status.success());",
        "",
        "    for args in [[\"unknown\"].as_slice(), [\"setup\", \"--wrong\"].as_slice()] {",
        "        let output = Command::new(binary).args(args).output().unwrap();",
        "        assert!(!output.status.success());",
        "        assert!(String::from_utf8_lossy(&output.stderr).contains(\"usage: habeas\"));",
        "    }",
        "}"
      ]
    }
  ]
}
