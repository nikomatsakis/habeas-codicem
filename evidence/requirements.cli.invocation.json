        "// {impl}`requirements.cli.clap`",
        "#[derive(Parser)]",
        "#[command(name = \"habeas\")]",
        "struct Cli {",
        "    #[command(subcommand)]",
        "    command: Command,",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum Command {",
        "    Mdbook {",
        "        #[command(subcommand)]",
        "        command: Option<MdbookCommand>,",
        "    },",
        "    Setup {",
        "        #[arg(long, value_name = \"crate-dir\")]",
        "        path: Option<PathBuf>,",
        "    },",
        "    Status {",
        "        #[arg(long)]",
        "        all: bool,",
        "    },",
        "    Info {",
        "        selector: String,",
        "    },",
        "    #[command(hide = true)]",
        "    Hook {",
        "        #[command(subcommand)]",
        "        command: HookCommand,",
        "    },",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum MdbookCommand {",
        "    Supports { renderer: String },",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum HookCommand {",
        "    SessionStart,",
        "}",
        "",
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    match Cli::parse().command {",
        "        // {impl}`requirements.cli.mdbook`",
        "        Command::Mdbook { command: None } => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { renderer }),",
        "        } => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }"
      ]
    },
