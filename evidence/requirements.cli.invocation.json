{
  "requirement": "`habeas mdbook supports html` MUST succeed, and a support query for another renderer MUST fail. An unknown command or invalid setup option combination MUST fail with a usage message.",
  "determination": true,
  "rationale": "Clap parses the command tree and prints usage for unknown commands or invalid setup options. The mdbook support branch accepts html and exits unsuccessfully for other renderers. The integration test exercises those invocations.",
  "inputs": [
    {
      "file": "src/main.rs",
      "line_start": 9,
      "line_end": 65,
      "text": [
        "// {impl}`requirements.cli.clap`",
        "#[derive(Parser)]",
        "#[command(name = \"habeas\")]",
        "struct Cli {",
        "    #[command(subcommand)]",
        "    command: Command,",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum Command {",
        "    Mdbook {",
        "        #[command(subcommand)]",
        "        command: Option<MdbookCommand>,",
        "    },",
        "    Setup {",
        "        #[arg(long, value_name = \"crate-dir\")]",
        "        path: Option<PathBuf>,",
        "        #[arg(long)]",
        "        install_skills: bool,",
        "    },",
        "    Agents,",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum MdbookCommand {",
        "    Supports { renderer: String },",
        "}",
        "",
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    match Cli::parse().command {",
        "        // {impl}`requirements.cli.mdbook`",
        "        Command::Mdbook { command: None } => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { renderer }),",
        "        } => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }",
        "        // {impl}`requirements.cli.setup`",
        "        Command::Setup {",
        "            path,",
        "            install_skills,",
        "        } => setup::run(path.as_deref(), install_skills),",
        "        // {impl}`requirements.cli.agents`",
        "        Command::Agents => agents::run(),",
        "    }",
        "}"
      ]
    },
    {
      "file": "tests/cli.rs",
      "line_start": 3,
      "line_end": 24,
      "text": [
        "// {test}`requirements.cli.invocation`",
        "#[test]",
        "fn renderer_support_and_invalid_commands() {",
        "    let binary = env!(\"CARGO_BIN_EXE_habeas\");",
        "    let supported = Command::new(binary)",
        "        .args([\"mdbook\", \"supports\", \"html\"])",
        "        .output()",
        "        .unwrap();",
        "    assert!(supported.status.success());",
        "",
        "    let unsupported = Command::new(binary)",
        "        .args([\"mdbook\", \"supports\", \"epub\"])",
        "        .output()",
        "        .unwrap();",
        "    assert!(!unsupported.status.success());",
        "",
        "    for args in [[\"unknown\"].as_slice(), [\"setup\", \"--wrong\"].as_slice()] {",
        "        let output = Command::new(binary).args(args).output().unwrap();",
        "        assert!(!output.status.success());",
        "        assert!(String::from_utf8_lossy(&output.stderr).contains(\"Usage: habeas\"));",
        "    }",
        "}"
      ]
    }
  ]
}
