        "        requirements: Option<String>,",
        "    },",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum MdbookCommand {",
        "    Supports { renderer: String },",
        "}",
        "",
        "#[derive(Subcommand)]",
        "enum HookCommand {",
        "    SessionStart,",
        "}",
