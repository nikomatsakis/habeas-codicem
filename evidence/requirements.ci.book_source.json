{
  "requirement": "Validation MUST read the mdBook source directory from `[book].src` in `book.toml`, using `src` when the setting is absent. It MUST report an unreadable or malformed book configuration and reject an empty, absolute, or parent-traversing source path.",
  "determination": true,
  "rationale": "The validator reads book.toml, defaults the source to src, rejects unsafe source paths, and reports unreadable or malformed configuration. The validation fixture uses a nondefault md source directory.",
  "inputs": [
    {
      "file": "src/evidence.rs",
      "line_start": 97,
      "line_end": 125,
      "text": [
        "// {impl}`requirements.ci.book_source`",
        "fn book_source_dir(root: &Path, errors: &mut Vec<String>) -> PathBuf {",
        "    let path = root.join(\"book.toml\");",
        "    let source = match fs::read_to_string(&path) {",
        "        Ok(content) => match content.parse::<DocumentMut>() {",
        "            Ok(book) => book[\"book\"][\"src\"].as_str().unwrap_or(\"src\").to_owned(),",
        "            Err(error) => {",
        "                errors.push(format!(\"book.toml: invalid TOML: {error}\"));",
        "                return root.join(\"md\");",
        "            }",
        "        },",
        "        Err(error) => {",
        "            errors.push(format!(",
        "                \"book.toml: cannot read book configuration: {error}\"",
        "            ));",
        "            return root.join(\"md\");",
        "        }",
        "    };",
        "    let relative = Path::new(&source);",
        "    if source.is_empty()",
        "        || !relative",
        "            .components()",
        "            .all(|part| matches!(part, Component::Normal(_) | Component::CurDir))",
        "    {",
        "        errors.push(\"book.toml: book.src must be a directory inside the repository\".to_owned());",
        "        return root.join(\"md\");",
        "    }",
        "    root.join(relative)",
        "}"
      ]
    },
    {
      "file": "src/evidence.rs",
      "line_start": 763,
      "line_end": 795,
      "text": [
