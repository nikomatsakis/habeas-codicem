        "// {test}`requirements.authoring.submission`",
        "fn call(id: &str, name: &str, arguments: Value) -> Value {",
        "    json!({\"id\":id,\"type\":\"function\",\"function\":{\"name\":name,\"arguments\":arguments}})",
        "}"
