      "text": [
        "    // {impl}`requirements.authoring.delivered_inputs`",
        "    pub(crate) fn record_inputs(&mut self, inputs: &[Value]) {",
        "        for input in inputs {",
        "            if !self.recorded.contains(input) {",
        "                self.recorded.push(input.clone());",
        "            }",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/mod.rs",
      "rust_item": "fn[assess]",
      "text": [
        "// {impl}`requirements.authoring.submission`",
        "// {impl}`requirements.authoring.initial_prompt`",
        "// {impl}`requirements.authoring.delivered_inputs`",
        "// {impl}`requirements.authoring.persistence`",
        "// {impl}`requirements.authoring.usage_inputs`",
        "// {impl}`requirements.authoring.usage_requests`",
        "async fn assess(",
        "    provider: &impl CompletionProvider,",
        "    root: &Path,",
        "    sources: &mut AssessmentSources,",
        "    usage: &mut UsageLog,",
        ") -> io::Result<(Judgment, PathBuf)> {",
        "    let mut request = CompletionRequest::new(initial_prompt(sources)?);",
        "    request.tools = tool_definitions()?;",
        "    let mut pending = sources.mandatory_inputs().to_vec();",
        "    loop {",
        "        let index = usage.begin_request()?;",
        "        let started = Instant::now();",
        "        let response = provider.complete(request.clone()).await;",
        "        usage.end_request(",
        "            index,",
        "            started.elapsed().as_millis(),",
        "            response.as_ref().ok().map(|r| &r.usage),",
        "        )?;",
        "        let response = response?;",
        "        sources.record_inputs(&pending);",
        "        pending.clear();",
        "        if let Some(error) = turn_failure(",
        "            &response.choice,",
        "            Some(&response.stop()),",
        "            response.finish_reason().as_ref(),",
        "        ) {",
        "            return Err(io::Error::other(error));",
        "        }",
        "        let calls: Vec<_> = response.tool_calls().cloned().collect();",
        "        let submissions: Vec<_> = calls",
        "            .iter()",
        "            .filter(|call| call.function.name.as_str() == \"submit_judgment\")",
        "            .collect();",
        "        if !submissions.is_empty() {",
        "            for call in &calls {",
        "                if call.function.name.as_str() != \"submit_judgment\" {",
        "                    usage.skipped_tool(call.function.name.as_str());",
        "                }",
        "            }",
        "            if submissions.len() != 1 {",
        "                for _ in &submissions {",
        "                    usage.tool(\"submit_judgment\", true);",
        "                }",
        "                return Err(io::Error::other(",
        "                    \"submit_judgment must be invoked exactly once; multiple submissions received\",",
        "                ));",
        "            }",
        "            let result = submission(&Value::Object(submissions[0].function.arguments.clone()));",
        "            usage.tool(\"submit_judgment\", result.is_err());",
        "            let (judgment, rationale) = result?;",
        "            usage.record.determination = Some(judgment.kind().into());",
        "            usage.save()?;",
        "            let evidence_path = root",
        "                .join(\"evidence\")",
        "                .join(format!(\"{}.json\", sources.subject_name));",
        "            let evidence = json!({sources.subject_kind.noun(): sources.subject_text,",
        "                \"determination\": judgment.to_value(), \"rationale\": rationale, \"inputs\": sources.recorded_inputs()});",
        "            fs::create_dir_all(evidence_path.parent().expect(\"evidence parent\"))?;",
        "            fs::write(",
        "                &evidence_path,",
        "                format!(\"{}\\n\", serde_json::to_string_pretty(&evidence)?),",
        "            )?;",
        "            usage.record.evidence_written = true;",
        "            usage.save()?;",
        "            return Ok((judgment, evidence_path));",
        "        }",
        "        if calls.is_empty() {",
        "            return Err(io::Error::other(",
        "                \"model finished without invoking submit_judgment\",",
        "            ));",
        "        }",
        "        request.chat_history.push(",
        "            response",
        "                .message()",
        "                .ok_or_else(|| io::Error::other(\"model returned an empty response\"))?,",
        "        );",
        "        let mut results = Vec::new();",
        "        for call in calls {",
        "            match tools::dispatch(",
        "                sources,",
        "                call.function.name.as_str(),",
        "                &Value::Object(call.function.arguments.clone()),",
        "            ) {",
        "                Ok(delivery) => {",
        "                    usage.tool(call.function.name.as_str(), false);",
        "                    usage.prepared(call.function.name.as_str(), &delivery.inputs);",
        "                    pending.extend(delivery.inputs);",
        "                    results.push(",
        "                        call.result(vec![ToolResultContent::text(delivery.result.to_string())]),",
        "                    );",
        "                }",
        "                Err(error) => {",
        "                    usage.tool(call.function.name.as_str(), true);",
        "                    results.push(call.error_result(vec![ToolResultContent::text(error)]));",
        "                }",
        "            }",
        "        }",
        "        usage.save()?;",
        "        request.chat_history.push(Message::tool_results(results));",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/authoring/tools.rs",
      "rust_item": "mod[tests]/fn[reading_records_only_delivered_sources_and_their_terms]",
      "text": [
        "    // {test}`requirements.authoring.additional_read`",
        "    // {test}`requirements.authoring.source_tools`",
        "    // {test}`requirements.authoring.file_discovery`",
        "    // {test}`requirements.authoring.delivered_inputs`",
        "    // {test}`requirements.definitions.authoring_inputs`",
        "    #[test]",
        "    fn reading_records_only_delivered_sources_and_their_terms() {",
        "        let root = project();",
        "        fs::write(",
        "            root.path().join(\"md/terms.md\"),",
        "            \":::{definition} value\\n:phrase: value\\nA useful value.\\n:::\\n\",",
        "        )",
        "        .unwrap();",
        "        fs::write(",
        "            root.path().join(\"src/lib.rs\"),",
        "            format!(\"// {}\\nfn work() {{}}\\n\", role(\"term\", \"terms.value\")),",
        "        )",
        "        .unwrap();",
        "        let mut sources = AssessmentSources::prepare(root.path(), \"requirements.ready\").unwrap();",
        "        let listing = dispatch(&sources, \"list_files\", &json!({\"path\":\"src\"})).unwrap();",
        "        assert_eq!(listing.result, json!([{\"path\":\"src/lib.rs\",\"kind\":\"file\"}]));",
        "        assert!(listing.inputs.is_empty());",
        "        let read = dispatch(",
        "            &sources,",
        "            \"habeas\",",
        "            &json!({\"rust_file\":\"src/lib.rs\",\"rust_item\":\"fn[work]\"}),",
        "        )",
        "        .unwrap();",
        "        assert_eq!(read.inputs.len(), 2);",
        "        assert_eq!(read.result[\"definitions\"][0][\"definition\"], \"terms.value\");",
        "        assert!(sources.recorded_inputs().is_empty());",
        "        sources.record_inputs(&read.inputs);",
        "        sources.record_inputs(&read.inputs);",
        "        assert_eq!(sources.recorded_inputs().len(), 2);",
        "        let eof = dispatch(",
        "            &sources,",
        "            \"habeas\",",
        "            &json!({\"file\":\"src/lib.rs\",\"line_start\":2}),",
        "        )",
        "        .unwrap();",
        "        assert_eq!(eof.result[\"input\"][\"line_end\"], 2);",
        "        assert_eq!(eof.result[\"input\"][\"text\"], json!([\"fn work() {}\"]));",
        "        assert!(",
        "            dispatch(",
        "                &sources,",
        "                \"habeas\",",
        "                &json!({\"file\":\"src/lib.rs\",\"line_start\":0})",
        "            )",
        "            .is_err()",
        "        );",
        "        assert!(",
        "            dispatch(",
        "                &sources,",
        "                \"habeas\",",
        "                &json!({\"file\":\"src/lib.rs\",\"line_start\":1,\"definition\":\"terms.value\"})",
        "            )",
        "            .is_err()",
        "        );",
        "        assert!(",
        "            dispatch(",
        "                &sources,",
        "                \"habeas\",",
        "                &json!({\"requirements\":\"requirements.*\"})",
        "            )",
        "            .is_ok()",
        "        );",
        "        assert!(dispatch(&sources, \"habeas\", &json!({\"definition\":\"terms.value\"})).is_ok());",
        "    }"
      ]
    },
    {
      "rust_file": "tests/authoring_cli.rs",
      "rust_item": "fn[ollama_cli_delivers_sources_records_fixme_and_keeps_usage_content_free]",
      "text": [
        "// {test}`requirements.authoring.complete_initial_bundle`",
        "// {test}`requirements.authoring.additional_read`",
        "// {test}`requirements.authoring.acknowledged_gap`",
        "// {test}`requirements.authoring.configuration_precedence`",
        "// {test}`requirements.authoring.rig_configuration_mapping`",
        "// {test}`requirements.authoring.configuration_storage`",
        "// {test}`requirements.authoring.initial_prompt`",
        "// {test}`requirements.ci.review_criteria`",
        "// {test}`requirements.authoring.delivered_inputs`",
        "// {test}`requirements.authoring.usage_storage`",
        "// {test}`requirements.authoring.usage_inputs`",
        "// {test}`requirements.authoring.usage_requests`",
        "#[test]",
        "fn ollama_cli_delivers_sources_records_fixme_and_keeps_usage_content_free() {",
        "    let server = Server::start(vec![",
        "        reply(vec![",
        "            call(\"list\", \"list_files\", json!({})),",
        "            call(",
        "                \"search\",",
        "                \"ripgrep\",",
        "                json!({\"path\":\"extra.txt\",\"pattern\":\"needle\"}),",
        "            ),",
        "            call(",
        "                \"read\",",
        "                \"habeas\",",
        "                json!({\"file\":\"extra.txt\",\"line_start\":10}),",
        "            ),",
        "            call(",
        "                \"repeat\",",
        "                \"habeas\",",
        "                json!({\"file\":\"extra.txt\",\"line_start\":10}),",
        "            ),",
        "            call(",
        "                \"missing\",",
        "                \"habeas\",",
        "                json!({\"file\":\"absent.txt\",\"line_start\":1}),",
        "            ),",
        "        ]),",
        "        reply(vec![call(",
        "            \"submit\",",
        "            \"submit_judgment\",",
        "            json!({",
        "            \"determination\":{\"FIXME\":[\"#125\"]},\"rationale\":\"SECRET_RATIONALE: src/lib.rs:2 documents the gap.\"}),",
        "        )]),",
        "    ]);",
        "    let fixture = Fixture::new(&server.endpoint);",
        "    let output = fixture.run(&[\"author-evidence\", SUBJECT]);",
        "    assert!(",
        "        output.status.success(),",
        "        \"{}\",",
        "        String::from_utf8_lossy(&output.stderr)",
        "    );",
        "    let requests = server.finish();",
        "    assert_eq!(requests.len(), 2);",
        "    for request in &requests {",
        "        assert!(request.headers.starts_with(\"POST /api/chat HTTP/1.1\\r\\n\"));",
        "        assert!(request.headers.to_ascii_lowercase().contains(&format!(",
        "            \"authorization: bearer {}\",",
        "            AUTH.to_ascii_lowercase()",
        "        )));",
        "        assert_eq!(request.body[\"model\"], MODEL);",
        "        assert_eq!(request.body[\"options\"][\"temperature\"], 0.25);",
        "        assert_eq!(request.body[\"options\"][\"num_ctx\"], 4096);",
        "        assert_eq!(request.body[\"think\"], false);",
        "        assert_eq!(request.body[\"stream\"], false);",
        "    }",
        "    let prompt = requests[0].body[\"messages\"][0][\"content\"].as_str().unwrap();",
        "    for text in [",
        "        \"Bring your expert judgment\",",
        "        REQUIREMENT,",
        "        \"SECRET_DEFINITION_TEXT\",",
        "        \"fn ready()\",",
        "        \"fn ready_test()\",",
        "        \"submit_judgment exactly once\",",
        "    ] {",
        "        assert!(prompt.contains(text), \"prompt missing {text}\");",
        "    }",
        "    assert!(!prompt.contains(\"OLD_RATIONALE_MUST_NOT_REACH_MODEL\"));",
        "    let mut tools = requests[0].body[\"tools\"]",
        "        .as_array()",
        "        .unwrap()",
        "        .iter()",
        "        .map(|tool| tool[\"function\"][\"name\"].as_str().unwrap())",
        "        .collect::<Vec<_>>();",
        "    tools.sort();",
        "    assert_eq!(",
        "        tools,",
        "        [\"habeas\", \"list_files\", \"ripgrep\", \"submit_judgment\"]",
        "    );",
        "    let results = requests[1].body[\"messages\"]",
        "        .as_array()",
        "        .unwrap()",
        "        .iter()",
        "        .filter(|message| message[\"role\"] == \"tool\")",
        "        .collect::<Vec<_>>();",
        "    assert_eq!(results.len(), 5);",
        "    assert!(results.iter().any(|message| {",
        "        message[\"content\"]",
        "            .as_str()",
        "            .unwrap()",
        "            .contains(\"SECRET_SOURCE_PAYLOAD\")",
        "    }));",
        "    assert!(",
        "        results",
        "            .iter()",
        "            .any(|message| message[\"content\"].as_str().unwrap().contains(\"absent.txt\"))",
        "    );",
        "",
        "    let evidence: Value = serde_json::from_slice(&fs::read(&fixture.evidence).unwrap()).unwrap();",
        "    assert_eq!(evidence[\"determination\"], json!({\"FIXME\":[\"#125\"]}));",
        "    assert_eq!(evidence[\"requirement\"], REQUIREMENT);",
        "    let inputs = evidence[\"inputs\"].as_array().unwrap();",
        "    assert!(",
        "        inputs",
        "            .iter()",
        "            .any(|input| input[\"definition\"] == \"terms.readiness\")",
        "    );",
        "    let extra = inputs",
        "        .iter()",
        "        .filter(|input| input[\"file\"] == \"extra.txt\")",
        "        .collect::<Vec<_>>();",
        "    assert_eq!(",
        "        extra.len(),",
        "        2,",
        "        \"repeated delivery is deduplicated in evidence\"",
        "    );",
        "    assert!(",
        "        extra",
        "            .iter()",
        "            .any(|input| input[\"line_start\"] == 1 && input[\"line_end\"] == 11)",
        "    );",
        "    assert!(",
        "        extra",
        "            .iter()",
        "            .any(|input| input[\"line_start\"] == 10 && input[\"line_end\"] == 12)",
        "    );",
        "    assert!(",
        "        !inputs",
        "            .iter()",
        "            .any(|input| input[\"file\"] == \"absent.txt\" || input[\"file\"] == \".\")",
        "    );",
        "",
        "    let usage = fixture.usage();",
        "    assert_eq!(usage[\"outcome\"], \"completed\");",
        "    assert_eq!(usage[\"determination\"], \"FIXME\");",
        "    assert_eq!(usage[\"evidence_written\"], true);",
        "    assert_eq!(usage[\"request_count\"], 2);",
        "    assert_eq!(usage[\"tool_call_count\"], 6);",
        "    assert_eq!(usage[\"tool_calls\"][\"habeas\"], 3);",
        "    assert_eq!(usage[\"tool_failures\"][\"habeas\"], 1);",
        "    assert_eq!(usage[\"tokens\"][\"input\"], 22);",
        "    assert_eq!(usage[\"tokens\"][\"output\"], 14);",
        "    assert_eq!(usage[\"tokens\"][\"complete\"], true);",
        "    assert!(",
        "        usage[\"inputs\"]",
        "            .as_array()",
        "            .unwrap()",
        "            .iter()",
        "            .any(|input| input[\"origin\"] == \"habeas\"",
        "                && input[\"unique\"] == false",
        "                && input[\"sent_in_request\"] == 1)",
        "    );",
        "    assert!(",
        "        usage[\"inputs\"]",
        "            .as_array()",
        "            .unwrap()",
        "            .iter()",
        "            .any(|input| input[\"origin\"] == \"mandatory\"",
        "                && input[\"kind\"] == \"definition\"",
        "                && input[\"bytes\"].as_u64().unwrap() > 0)",
        "    );",
        "    let serialized = usage.to_string();",
        "    for secret in [",
        "        \"SECRET_REQUIREMENT_TEXT\",",
        "        \"SECRET_DEFINITION_TEXT\",",
        "        \"SECRET_SOURCE_PAYLOAD\",",
        "        \"SECRET_RATIONALE\",",
        "        AUTH,",
        "        \"#125\",",
        "    ] {",
        "        assert!(",
        "            !serialized.contains(secret),",
        "            \"usage contains source or credential content: {secret}\"",
        "        );",
        "    }",
        "    let stdout = String::from_utf8_lossy(&output.stdout);",
        "    assert!(stdout.contains(MODEL) && stdout.contains(\"Evidence:\") && stdout.contains(\"Usage:\"));",
        "}"
      ]
    }
  ]
}
