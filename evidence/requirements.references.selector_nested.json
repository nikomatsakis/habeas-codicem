{
  "example": "In `src/lib.rs`, `fn outer() { fn inner() {} }` gives the selectors `fn[outer]` and `fn[outer]/fn[inner]`. {cite}`requirements.references.rust_item_selectors`",
  "determination": true,
  "rationale": "The selector unit test parses a local module and a nested function, then asserts `mod[local]/fn[run]` and `fn[outer]/fn[inner]`. These assertions check file-local syntactic ancestry rather than module resolution.",
  "inputs": [
    {
      "rust_file": "src/rust_items.rs",
      "rust_item": "mod[tests]/fn[selectors_name_syntactic_ancestry_and_duplicates]",
      "text": [
        "    // {test}`requirements.references.rust_item_selectors`",
        "    // {test}`requirements.references.selector_nested`",
        "    // {test}`requirements.references.selector_impl_and_trait`",
        "    // {test}`requirements.references.selector_inline_and_foreign`",
        "    // {test}`requirements.references.selector_duplicate_names`",
        "    // {test}`requirements.references.selector_use`",
        "    #[test]",
        "    fn selectors_name_syntactic_ancestry_and_duplicates() {",
        "        let source = r#\"",
        "use alpha::A;",
        "use beta::B;",
        "mod local { fn run() {} }",
        "mod external;",
        "struct Thing;",
        "impl Thing { fn run() {} }",
        "impl Trait for Thing { fn run() {} }",
        "impl [u8; 4] { fn edge() {} }",
        "trait Trait { fn read(&self); }",
        "extern \"C\" { fn puts(); }",
        "fn outer() { fn inner() {} }",
        "#[cfg(a)] fn repeated() {}",
        "#[cfg(b)] fn repeated() {}",
        "\"#;",
        "        let selectors = parse_items(source)",
        "            .unwrap()",
        "            .into_iter()",
        "            .map(|item| item.selector)",
        "            .collect::<Vec<_>>();",
        "        for selector in [",
        "            \"use#1\",",
        "            \"use#2\",",
        "            \"mod[local]/fn[run]\",",
        "            \"mod[external]\",",
        "            \"struct[Thing]\",",
        "            \"impl[Thing]/fn[run]\",",
        "            \"impl[Thing/Trait]/fn[run]\",",
        "            \"impl[%5Bu8;%204%5D]/fn[edge]\",",
        "            \"trait[Trait]/fn[read]\",",
        "            \"extern[C]/fn[puts]\",",
        "            \"fn[outer]/fn[inner]\",",
        "            \"fn[repeated]#1\",",
        "            \"fn[repeated]#2\",",
        "        ] {",
        "            assert!(",
        "                selectors.contains(&selector.to_owned()),",
        "                \"{selector}: {selectors:?}\"",
        "            );",
        "        }",
        "    }"
      ]
    }
  ]
}
