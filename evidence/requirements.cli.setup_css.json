        "fn css_relative(source_path: &Path) -> String {",
        "    source_path",
        "        .join(\"habeas.css\")",
        "        .components()",
        "        .filter_map(|part| match part {",
        "            Component::Normal(name) => Some(name.to_string_lossy().into_owned()),",
