        "        \"#[test]\\nfn habeas() {\\n    habeas::validate();\\n}\\n\"",
        "    );",
        "    assert!(project.join(\"md/habeas.css\").is_file());",
        "    assert!(!project.join(\".agents/skills\").exists());",
        "}"
