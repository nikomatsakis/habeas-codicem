        "    assert!(cargo.contains(\"[dev-dependencies]\"));",
        "    assert!(cargo.contains(\"habeas\"));",
        "    assert!(cargo.contains(\"path = \"));",
        "    let book = fs::read_to_string(project.join(\"book.toml\")).unwrap();",
        "    assert!(book.contains(\"command = \\\"habeas mdbook\\\"\"));",
