{
  "requirement": "GitHub Actions MUST run `cargo test --locked --workspace` and `mdbook test` for pull requests and pushes to `main`. After those checks pass on `main`, it MUST build the book and deploy the generated `book/` directory to GitHub Pages. The book MUST set `output.html.site-url` to `/habeas-codicem/` for project-site hosting.",
  "determination": true,
  "rationale": "The GitHub Actions workflow runs the Cargo and mdBook checks, builds the book, and runs the isolated Symposium session-start smoke test before deployment.",
  "inputs": [
    {
      "file": ".github/workflows/ci.yml",
      "line_start": 1,
      "line_end": 61,
      "text": [
        "name: CI",
        "",
        "on:",
        "  push:",
        "    branches: [main]",
        "  pull_request:",
        "",
        "jobs:",
        "  test-and-build:",
        "    runs-on: ubuntu-latest",
        "    permissions:",
        "      contents: read",
        "      pages: read",
        "    steps:",
        "      - uses: actions/checkout@v6",
        "      - name: Install mdBook",
        "        run: cargo install mdbook --locked --version 0.5.4 --no-default-features --features search",
        "      - name: Cargo tests",
        "        run: cargo test --locked --workspace",
        "      - name: mdBook tests",
        "        run: mdbook test",
        "      - name: Build mdBook",
        "        run: mdbook build",
        "      - name: Configure Pages",
        "        if: github.event_name == 'push'",
        "        uses: actions/configure-pages@v5",
        "      - name: Upload Pages artifact",
        "        if: github.event_name == 'push'",
        "        uses: actions/upload-pages-artifact@v4",
        "        with:",
        "          path: book",
        "",
        "  symposium-hook:",
        "    runs-on: ubuntu-latest",
        "    permissions:",
        "      contents: read",
        "    steps:",
        "      - uses: actions/checkout@v6",
        "      - name: Install Symposium",
        "        run: cargo install symposium --locked --version 0.5.1",
        "      - name: Test Habeas session-start hook",
        "        run: python3 tests/symposium_hook_smoke.py",
        "",
        "  deploy:",
        "    if: github.event_name == 'push' && github.ref == 'refs/heads/main'",
        "    needs: [test-and-build, symposium-hook]",
        "    runs-on: ubuntu-latest",
        "    permissions:",
        "      contents: read",
        "      pages: write",
        "      id-token: write",
        "    concurrency:",
        "      group: pages",
        "      cancel-in-progress: false",
        "    environment:",
        "      name: github-pages",
        "      url: ${{ steps.deployment.outputs.page_url }}",
        "    steps:",
        "      - name: Deploy to GitHub Pages",
        "        id: deployment",
        "        uses: actions/deploy-pages@v4"
      ]
    },
    {
      "file": "book.toml",
      "line_start": 1,
      "line_end": 18,
      "text": [
        "[book]",
        "title = \"Habeas Codicem\"",
        "language = \"en\"",
        "src = \"md\"",
        "",
        "[preprocessor.habeas]",
        "command = \"cargo habeas mdbook\"",
        "renderers = [\"html\"]",
        "",
        "[output.html]",
        "additional-css = [\"md/habeas.css\"]",
        "site-url = \"/habeas-codicem/\"",
        "git-repository-url = \"https://github.com/nikomatsakis/habeas-codicem\"",
        "edit-url-template = \"https://github.com/nikomatsakis/habeas-codicem/edit/main/{path}\"",
        "",
        "[output.html.fold]",
        "enable = true",
        "level = 0"
      ]
    }
  ]
}
