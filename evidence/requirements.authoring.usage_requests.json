{
  "requirement": "Usage MUST record each provider request's outcome and available input/output\ntoken counts, including retries, with cached or reasoning-token counts when\nprovided. Missing measurements MUST be recorded as unavailable, not zero.\nRun totals MUST include request and tool-call counts by tool, elapsed time, and\navailable token usage, identifying incomplete totals without double counting\nprovider counters that overlap.",
  "determination": true,
  "rationale": "The harness records each provider attempt, elapsed time, tool counts, and optional Rig token counters; absent counters remain null and incomplete totals remain marked incomplete. AWS internal retries are disabled so hidden attempts cannot escape accounting. Usage tests cover missing counters, cache/reasoning subsets, failures/cancellation, and aggregate counts; local adapters verify returned provider usage.",
  "inputs": [
    {
      "rust_file": "src/authoring/mod.rs",
      "rust_item": "fn[assess]",
      "text": [
        "// {impl}`requirements.authoring.submission`",
        "// {impl}`requirements.authoring.initial_prompt`",
        "// {impl}`requirements.authoring.delivered_inputs`",
        "// {impl}`requirements.authoring.persistence`",
        "// {impl}`requirements.authoring.usage_inputs`",
        "// {impl}`requirements.authoring.usage_requests`",
        "async fn assess(",
        "    provider: &impl CompletionProvider,",
        "    root: &Path,",
        "    sources: &mut AssessmentSources,",
        "    output: EvidenceOutput,",
        "    usage: &mut UsageLog,",
        ") -> io::Result<(Judgment, Option<PathBuf>)> {",
        "    let mut request = CompletionRequest::new(initial_prompt(sources)?);",
        "    request.tools = tool_definitions()?;",
        "    let mut pending = sources.mandatory_inputs().to_vec();",
        "    loop {",
        "        let index = usage.begin_request()?;",
        "        let started = Instant::now();",
        "        let response = provider.complete(request.clone()).await;",
        "        usage.end_request(",
        "            index,",
        "            started.elapsed().as_millis(),",
        "            response.as_ref().ok().map(|r| &r.usage),",
        "        )?;",
        "        let response = response?;",
        "        sources.record_inputs(&pending);",
        "        pending.clear();",
        "        if let Some(error) = turn_failure(",
        "            &response.choice,",
        "            Some(&response.stop()),",
        "            response.finish_reason().as_ref(),",
        "        ) {",
        "            return Err(io::Error::other(error));",
        "        }",
        "        let calls: Vec<_> = response.tool_calls().cloned().collect();",
        "        let submissions: Vec<_> = calls",
        "            .iter()",
        "            .filter(|call| call.function.name.as_str() == \"submit_judgment\")",
        "            .collect();",
        "        if !submissions.is_empty() {",
        "            for call in &calls {",
        "                if call.function.name.as_str() != \"submit_judgment\" {",
        "                    usage.skipped_tool(call.function.name.as_str());",
        "                }",
        "            }",
        "            if submissions.len() != 1 {",
        "                for _ in &submissions {",
        "                    usage.tool(\"submit_judgment\", true);",
        "                }",
        "                return Err(io::Error::other(",
        "                    \"submit_judgment must be invoked exactly once; multiple submissions received\",",
        "                ));",
        "            }",
        "            let result = submission(&Value::Object(submissions[0].function.arguments.clone()));",
        "            usage.tool(\"submit_judgment\", result.is_err());",
        "            let (judgment, rationale) = result?;",
        "            usage.record.determination = Some(judgment.kind().into());",
        "            usage.save()?;",
        "            let evidence = json!({sources.subject_kind.noun(): sources.subject_text,",
        "                \"determination\": judgment.to_value(), \"rationale\": rationale, \"inputs\": sources.recorded_inputs()});",
        "            let json = format!(\"{}\\n\", serde_json::to_string_pretty(&evidence)?);",
        "            let evidence_path = match output {",
        "                EvidenceOutput::File => {",
        "                    let path = root",
        "                        .join(\"evidence\")",
        "                        .join(format!(\"{}.json\", sources.subject_name));",
        "                    fs::create_dir_all(path.parent().expect(\"evidence parent\"))?;",
        "                    fs::write(&path, json)?;",
        "                    Some(path)",
        "                }",
        "                EvidenceOutput::Stdout => {",
        "                    let mut stdout = io::stdout().lock();",
        "                    stdout.write_all(json.as_bytes())?;",
        "                    stdout.flush()?;",
        "                    None",
        "                }",
        "            };",
        "            usage.record.evidence_written = true;",
        "            usage.save()?;",
        "            return Ok((judgment, evidence_path));",
        "        }",
        "        if calls.is_empty() {",
        "            return Err(io::Error::other(",
        "                \"model finished without invoking submit_judgment\",",
        "            ));",
        "        }",
        "        request.chat_history.push(",
        "            response",
        "                .message()",
        "                .ok_or_else(|| io::Error::other(\"model returned an empty response\"))?,",
        "        );",
        "        let mut results = Vec::new();",
        "        for call in calls {",
        "            match tools::dispatch(",
        "                sources,",
        "                call.function.name.as_str(),",
        "                &Value::Object(call.function.arguments.clone()),",
        "            ) {",
        "                Ok(delivery) => {",
        "                    usage.tool(call.function.name.as_str(), false);",
        "                    usage.prepared(call.function.name.as_str(), &delivery.inputs);",
        "                    pending.extend(delivery.inputs);",
        "                    results.push(",
        "                        call.result(vec![ToolResultContent::text(delivery.result.to_string())]),",
        "                    );",
        "                }",
        "                Err(error) => {",
        "                    usage.tool(call.function.name.as_str(), true);",
        "                    results.push(call.error_result(vec![ToolResultContent::text(error)]));",
        "                }",
        "            }",
        "        }",
        "        usage.save()?;",
        "        request.chat_history.push(Message::tool_results(results));",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/authoring/providers.rs",
      "rust_item": "impl[RigProvider]/fn[connect]",
      "text": [
        "    // {impl}`requirements.authoring.provider`",
        "    // {impl}`requirements.authoring.rig_configuration_mapping`",
        "    // {impl}`requirements.authoring.configuration_precedence`",
        "    // {impl}`requirements.authoring.usage_requests`",
        "    pub(super) async fn connect(config: &BackendConfig) -> io::Result<Self> {",
        "        let model = match config {",
        "            BackendConfig::Bedrock(config) => {",
        "                // Keep each provider attempt visible to the usage ledger. An SDK",
        "                // retry would otherwise be hidden inside one recorded request.",
        "                let mut loader = aws_config::defaults(aws_config::BehaviorVersion::latest())",
        "                    .retry_config(aws_config::retry::RetryConfig::disabled());",
        "                if let Some(profile) = &config.aws_profile {",
        "                    loader = loader.profile_name(profile);",
        "                }",
        "                if let Some(region) = &config.region {",
        "                    loader = loader.region(aws_config::Region::new(region.clone()));",
        "                }",
        "                let sdk = aws_sdk_bedrockruntime::Client::new(&loader.load().await);",
        "                rig_bedrock::client::BedrockRuntime::from(sdk)",
        "                    .completion(&config.model)",
        "                    .erase()",
        "            }",
        "            BackendConfig::Ollama(config) => {",
        "                let mut provider = rig_core::providers::ollama::OllamaConfig::new()",
        "                    .with_base_url(config.endpoint());",
        "                if let Some(key) = config.api_key()? {",
        "                    provider = provider.with_api_key(key);",
        "                }",
        "                provider.client().native_completion(&config.model).erase()",
        "            }",
        "        };",
        "        Ok(Self {",
        "            model,",
        "            options: config.options_json()?,",
        "            bedrock: matches!(config, BackendConfig::Bedrock(_)),",
        "        })",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[UsageLog]/fn[begin_request]",
      "text": [
        "    // {impl}`requirements.authoring.usage_inputs`",
        "    // {impl}`requirements.authoring.usage_requests`",
        "    pub(super) fn begin_request(&mut self) -> io::Result<usize> {",
        "        let index = self.record.requests.len();",
        "        for input in &mut self.record.inputs {",
        "            if input.submitted_in_request.is_none() {",
        "                input.submitted_in_request = Some(index);",
        "            }",
        "        }",
        "        self.record.requests.push(RequestUsage {",
        "            outcome: \"unfinished\".into(),",
        "            elapsed_ms: 0,",
        "            tokens: TokenCounts::default(),",
        "        });",
        "        self.record.request_count = self.record.requests.len();",
        "        self.record.tokens = TokenCounts::sum(&self.record.requests);",
        "        self.record.elapsed_ms = self.started.elapsed().as_millis();",
        "        self.active_request = Some((index, Instant::now()));",
        "        self.save()?;",
        "        Ok(index)",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[UsageLog]/fn[end_request]",
      "text": [
        "    // {impl}`requirements.authoring.usage_requests`",
        "    pub(super) fn end_request(",
        "        &mut self,",
        "        index: usize,",
        "        elapsed: u128,",
        "        usage: Option<&Usage>,",
        "    ) -> io::Result<()> {",
        "        let tokens = usage.map(TokenCounts::from_usage).unwrap_or_default();",
        "        if usage.is_some() {",
        "            for input in &mut self.record.inputs {",
        "                if input.sent_in_request.is_none() && input.submitted_in_request.is_some() {",
        "                    input.sent_in_request = Some(index);",
        "                }",
        "            }",
        "        }",
        "        self.record.requests[index] = RequestUsage {",
        "            outcome: if usage.is_some() {",
        "                \"completed\"",
        "            } else {",
        "                \"failed\"",
        "            }",
        "            .into(),",
        "            elapsed_ms: elapsed,",
        "            tokens,",
        "        };",
        "        self.record.tokens = TokenCounts::sum(&self.record.requests);",
        "        self.active_request = None;",
        "        self.record.elapsed_ms = self.started.elapsed().as_millis();",
        "        self.save()",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[UsageLog]/fn[tool]",
      "text": [
        "    // {impl}`requirements.authoring.usage_requests`",
        "    // {impl}`requirements.authoring.usage_inputs`",
        "    pub(super) fn tool(&mut self, name: &str, failed: bool) {",
        "        let name = tool_name(name);",
        "        *self.record.tool_calls.entry(name.to_owned()).or_default() += 1;",
        "        self.record.tool_call_count += 1;",
        "        if failed {",
        "            *self",
        "                .record",
        "                .tool_failures",
        "                .entry(name.to_owned())",
        "                .or_default() += 1;",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[UsageLog]/fn[skipped_tool]",
      "text": [
        "    // {impl}`requirements.authoring.usage_requests`",
        "    // {impl}`requirements.authoring.usage_inputs`",
        "    pub(super) fn skipped_tool(&mut self, name: &str) {",
        "        let name = tool_name(name);",
        "        *self.record.tool_calls.entry(name.to_owned()).or_default() += 1;",
        "        *self.record.tool_skipped.entry(name.to_owned()).or_default() += 1;",
        "        self.record.tool_call_count += 1;",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[TokenCounts]/fn[from_usage]",
      "text": [
        "    // {impl}`requirements.authoring.usage_requests`",
        "    fn from_usage(usage: &Usage) -> Self {",
        "        Self {",
        "            input: usage.input_tokens,",
        "            output: usage.output_tokens,",
        "            cached_input: usage.cached_input_tokens,",
        "            cache_creation_input: usage.cache_creation_input_tokens,",
        "            reasoning: usage.reasoning_tokens,",
        "            complete: usage.input_tokens.is_some() && usage.output_tokens.is_some(),",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[TokenCounts]/fn[sum]",
      "text": [
        "    // {impl}`requirements.authoring.usage_requests`",
        "    fn sum(requests: &[RequestUsage]) -> Self {",
        "        if requests.is_empty() {",
        "            return Self::default();",
        "        }",
        "        // Cache and reasoning counters are subsets, never added to token totals.",
        "        // Keep measured subtotals when another request has no measurement.",
        "        let (input, _) = Self::sum_counter(requests, |tokens| tokens.input);",
        "        let (output, _) = Self::sum_counter(requests, |tokens| tokens.output);",
        "        let (cached_input, cached_complete) =",
        "            Self::sum_counter(requests, |tokens| tokens.cached_input);",
        "        let (cache_creation_input, creation_complete) =",
        "            Self::sum_counter(requests, |tokens| tokens.cache_creation_input);",
        "        let (reasoning, reasoning_complete) =",
        "            Self::sum_counter(requests, |tokens| tokens.reasoning);",
        "        Self {",
        "            input,",
        "            output,",
        "            cached_input,",
        "            cache_creation_input,",
        "            reasoning,",
        "            complete: requests.iter().all(|r| r.tokens.complete)",
        "                && cached_complete",
        "                && creation_complete",
        "                && reasoning_complete,",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "impl[TokenCounts]/fn[sum_counter]",
      "text": [
        "    // {impl}`requirements.authoring.usage_requests`",
        "    fn sum_counter(",
        "        requests: &[RequestUsage],",
        "        counter: fn(&Self) -> Option<u64>,",
        "    ) -> (Option<u64>, bool) {",
        "        let mut measured = 0;",
        "        let mut total = 0;",
        "        for request in requests {",
        "            if let Some(value) = counter(&request.tokens) {",
        "                measured += 1;",
        "                total += value;",
        "            }",
        "        }",
        "        (",
        "            (measured > 0).then_some(total),",
        "            measured == 0 || measured == requests.len(),",
        "        )",
        "    }"
      ]
    },
    {
      "rust_file": "src/authoring/usage.rs",
      "rust_item": "fn[tool_name]",
      "text": [
        "// {impl}`requirements.authoring.usage_requests`",
        "// {impl}`requirements.authoring.usage_storage`",
        "fn tool_name(name: &str) -> &str {",
        "    match name {",
        "        \"habeas\" | \"ripgrep\" | \"list_files\" | \"submit_judgment\" => name,",
        "        _ => \"unknown\",",
        "    }",
        "}"
      ]
    },
