  "requirement": "```rust,ignore\nimpl Sources {\n    // ...\n\n    /// Search source structure.\n    pub async fn search_structure(\n        &self,\n        query: &StructuralQuery,\n    ) -> Result<StructuralMatches, SourceError>;\n\n    // ...\n}\n```",
