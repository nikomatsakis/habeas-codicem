        "    // {test}`requirements.references.selector_duplicate_names`",
        "    // {test}`requirements.references.selector_use`",
        "    #[test]",
        "    fn selectors_name_syntactic_ancestry_and_duplicates() {",
        "        let source = r#\"",
        "use alpha::A;",
        "use beta::B;",
        "mod local { fn run() {} }",
        "mod external;",
        "struct Thing;",
        "impl Thing { fn run() {} }",
        "impl Trait for Thing { fn run() {} }",
        "impl [u8; 4] { fn edge() {} }",
        "trait Trait { fn read(&self); }",
        "extern \"C\" { fn puts(); }",
        "fn outer() { fn inner() {} }",
        "#[cfg(a)] fn repeated() {}",
        "#[cfg(b)] fn repeated() {}",
        "\"#;",
        "        let selectors = parse_items(source)",
        "            .unwrap()",
        "            .into_iter()",
        "            .map(|item| item.selector)",
        "            .collect::<Vec<_>>();",
        "        for selector in [",
        "            \"use#1\",",
        "            \"use#2\",",
        "            \"mod[local]/fn[run]\",",
        "            \"mod[external]\",",
        "            \"struct[Thing]\",",
        "            \"impl[Thing]/fn[run]\",",
        "            \"impl[Thing/Trait]/fn[run]\",",
        "            \"impl[%5Bu8;%204%5D]/fn[edge]\",",
        "            \"trait[Trait]/fn[read]\",",
        "            \"extern[C]/fn[puts]\",",
        "            \"fn[outer]/fn[inner]\",",
        "            \"fn[repeated]#1\",",
        "            \"fn[repeated]#2\",",
        "        ] {",
        "            assert!(",
        "                selectors.contains(&selector.to_owned()),",
        "                \"{selector}: {selectors:?}\"",
        "            );",
        "        }",
        "    }"
      ]
    },
