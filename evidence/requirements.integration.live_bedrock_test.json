        "// {test}`requirements.integration.live_bedrock_test`",
        "fn report(message: impl std::fmt::Display) {",
        "    // Direct stderr writes remain visible when libtest captures passing tests.",
        "    let _ = writeln!(io::stderr().lock(), \"{message}\");",
        "}"
      ]
