        "        && let Some(record) = detail_evidence.record",
        "    {",
        "        content.push_str(\"\\n## Unreadable evidence record\\n\\n\");",
        "        push_code_block(&mut content, record, \"json\");",
        "    }",
        "    content",
        "}"
