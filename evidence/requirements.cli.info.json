        "    assert!(output.status.success(), \"{:?}\", output);",
        "    let matches = String::from_utf8(output.stdout).unwrap();",
        "    let pending = matches.find(\"# `requirements.pending`\").unwrap();",
        "    let ready = matches.find(\"# `requirements.ready`\").unwrap();",
