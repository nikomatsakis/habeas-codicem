        "    assert!(exact.contains(\"src/main.rs:1–1\"), \"{exact}\");",
        "    assert!(",
        "        exact.contains(\"```rust,noplayground\\nfn main() {}\"),",
        "        \"{exact}\"",
        "    );",
        "    assert!(",
        "        exact.contains(\"img.shields.io/badge/evidence-Valid-237346\"),",
        "        \"{exact}\"",
