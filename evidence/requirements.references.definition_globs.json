{
  "requirement": "A definition glob MUST match a complete full name. `*` MUST match zero or more characters, including dots; all other valid name characters MUST match literally. An empty glob MUST be invalid. The same glob matching rule MUST be used by requirements evidence inputs and CLI definition filters. All three MUST match against both requirements and named examples.",
  "determination": true,
  "rationale": "The same whole-name wildcard matcher is used in requirements inputs, status, and info. Its unit test checks that a star spans dot components and rejects partial or malformed patterns; CLI tests cover status and info selections.",
  "inputs": [
    {
      "file": "md/reference.md",
      "line_start": 81,
      "line_end": 81,
      "text": [
        "Run `habeas status [<glob>]` from within the project to list requirements and named examples needing attention and their validation findings. `--all` shows every matching definition and its evidence state. Use `habeas info <glob>` to print matching detail pages as Markdown, including current texts, rationales, inputs, and findings. Both commands match whole full names; `*` can span any number of characters, including dots. {cite}`requirements.cli.status` {cite}`requirements.cli.info` {cite}`requirements.references.definition_globs`"
      ]
    },
    {
      "requirements": "requirements.references.definition_glob_cases",
      "matches": [
        "requirements.references.definition_glob_cases"
      ],
      "text": [
        ":::{example} references.definition_glob_cases",
        "Given a requirement `foo.a.bar` and a named example `foo.a.b.bar`, `foo.*.bar` matches both, in that order. A requirements input stores both full names and their complete raw fenced declarations. Adding another matching definition invalidates the existing input. {cite}`requirements.references.definition_globs` {cite}`requirements.ci.requirements_inputs`",
        ":::"
      ]
    },
    {
      "rust_file": "src/definition_glob.rs",
      "rust_item": "fn[matches]",
      "text": [
        "// {impl}`requirements.references.definition_globs`",
        "pub(crate) fn matches(pattern: &str, name: &str) -> bool {",
        "    let bytes = name.as_bytes();",
        "    let mut previous = vec![false; bytes.len() + 1];",
        "    previous[0] = true;",
        "    for token in pattern.bytes() {",
        "        let mut next = vec![false; bytes.len() + 1];",
        "        if token == b'*' {",
        "            next[0] = previous[0];",
        "            for index in 1..=bytes.len() {",
        "                next[index] = previous[index] || next[index - 1];",
        "            }",
        "        } else {",
        "            for index in 1..=bytes.len() {",
        "                next[index] = previous[index - 1] && bytes[index - 1] == token;",
        "            }",
        "        }",
        "        previous = next;",
        "    }",
        "    previous[bytes.len()]",
        "}"
      ]
    },
    {
      "rust_file": "src/definition_glob.rs",
      "rust_item": "fn[validate]",
      "text": [
        "// {impl}`requirements.references.definition_globs`",
        "pub(crate) fn validate(pattern: &str) -> Result<(), String> {",
        "    if pattern.is_empty() {",
        "        return Err(\"definition glob must not be empty\".to_owned());",
        "    }",
        "    if let Some(character) = pattern.chars().find(|character| {",
        "        !character.is_ascii_alphanumeric() && !matches!(character, '.' | '_' | '-' | '*')",
        "    }) {",
        "        return Err(format!(",
        "            \"invalid definition glob {pattern:?}: unsupported character {character:?}\"",
        "        ));",
        "    }",
        "    Ok(())",
        "}"
      ]
    },
    {
      "rust_file": "src/definition_glob.rs",
      "rust_item": "mod[tests]/fn[wildcard_crosses_dot_segments_and_matches_the_whole_name]",
      "text": [
        "    // {test}`requirements.references.definition_globs`",
        "    // {test}`requirements.references.definition_glob_cases`",
        "    #[test]",
        "    fn wildcard_crosses_dot_segments_and_matches_the_whole_name() {",
        "        assert!(validate(\"foo.*.bar\").is_ok());",
        "        assert!(matches(\"foo.*.bar\", \"foo.x.bar\"));",
        "        assert!(matches(\"foo.*.bar\", \"foo.x.y.bar\"));",
        "        assert!(!matches(\"foo.*.bar\", \"prefix.foo.x.bar\"));",
        "        assert!(!matches(\"foo.bar.*\", \"foo.bar\"));",
        "        assert!(matches(\"foo.bar.*\", \"foo.bar.x.y\"));",
        "        assert!(validate(\"\").is_err());",
        "        assert!(validate(\"foo[bar]\").is_err());",
        "    }"
      ]
    },
    {
      "rust_file": "tests/commands.rs",
      "rust_item": "fn[commands_report_invalid_arguments_and_unmatched_selectors]",
      "text": [
        "// {test}`requirements.cli.status`",
        "// {test}`requirements.cli.info`",
        "// {test}`requirements.references.definition_globs`",
        "#[test]",
        "fn commands_report_invalid_arguments_and_unmatched_selectors() {",
        "    let temp = fixture();",
        "    for args in [",
        "        [\"status\", \"--wrong\"].as_slice(),",
        "        [\"status\", \"--all\", \"extra\", \"more\"].as_slice(),",
        "        [\"info\"].as_slice(),",
        "        [\"info\", \"ready\", \"extra\"].as_slice(),",
        "    ] {",
        "        let output = habeas(temp.path(), args);",
        "        assert!(!output.status.success(), \"{args:?}: {output:?}\");",
        "        assert!(",
        "            String::from_utf8_lossy(&output.stderr).contains(\"Usage: habeas\"),",
        "            \"{args:?}: {output:?}\"",
        "        );",
        "    }",
        "    let invalid = habeas(temp.path(), &[\"info\", \"[\"]);",
        "    assert!(!invalid.status.success());",
        "    assert!(",
        "        String::from_utf8_lossy(&invalid.stderr).contains(\"invalid definition glob\"),",
        "        \"{invalid:?}\"",
        "    );",
        "    let unmatched = habeas(temp.path(), &[\"info\", \"nothing.*\"]);",
        "    assert!(!unmatched.status.success());",
        "    assert!(",
        "        String::from_utf8_lossy(&unmatched.stderr).contains(\"no definitions match\"),",
        "        \"{unmatched:?}\"",
        "    );",
        "    let status = habeas(temp.path(), &[\"status\", \"requirements.*ready\", \"--all\"]);",
        "    assert!(status.status.success(), \"{status:?}\");",
        "    let status = String::from_utf8(status.stdout).unwrap();",
        "    assert!(",
        "        status.contains(\"`requirements.ready` (requirement)\"),",
        "        \"{status}\"",
        "    );",
        "    assert!(",
        "        status.contains(\"`requirements.xready` (requirement)\"),",
        "        \"{status}\"",
        "    );",
        "    assert!(!status.contains(\"| `requirements.pending`\"), \"{status}\");",
        "    let no_status = habeas(temp.path(), &[\"status\", \"nothing.*\"]);",
        "    assert!(!no_status.status.success());",
        "    assert!(String::from_utf8_lossy(&no_status.stderr).contains(\"no definitions match\"));",
        "}"
      ]
    }
  ]
}
