        "    ) -> impl Future<Output = Result<(), Self::Error>> + Send;",
        "",
        "    fn project_sources(&self) -> Option<SourceProject<Self>> { ... }",
        "    fn source_node(&self, item: &OutlineId) -> Result<Self::NodeId, SourceError> { ... }",
        "}",
