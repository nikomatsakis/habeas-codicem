{
  "example": "A model finishes with prose but never calls `submit_judgment`: the assessment\nfails without writing evidence. A response with two `submit_judgment` calls also\nfails, even when their payloads are identical. A single call with invalid\narguments fails without requesting a replacement submission.\n{cite}`requirements.authoring.submission`",
  "determination": true,
  "rationale": "The local CLI submission test returns prose/no call, two identical valid submissions, and invalid single submissions. Every case fails, preserves the existing evidence bytes, records a failed run, and makes no replacement submission request.",
  "inputs": [
    {
      "rust_file": "tests/authoring_cli.rs",
      "rust_item": "fn[missing_duplicate_and_invalid_submissions_preserve_existing_evidence]",
      "text": [
        "// {test}`requirements.authoring.submission_count`",
        "// {test}`requirements.authoring.submission`",
        "// {test}`requirements.authoring.usage_storage`",
        "#[test]",
        "fn missing_duplicate_and_invalid_submissions_preserve_existing_evidence() {",
        "    let valid =",
        "        json!({\"determination\":true,\"rationale\":\"The reviewed sources support the subject.\"});",
        "    for calls in [",
        "        vec![],",
        "        vec![",
        "            call(\"one\", \"submit_judgment\", valid.clone()),",
        "            call(\"two\", \"submit_judgment\", valid),",
        "        ],",
        "        vec![call(",
        "            \"bad\",",
        "            \"submit_judgment\",",
        "            json!({\"determination\":true,\"rationale\":\"\"}),",
        "        )],",
        "        vec![call(",
        "            \"empty\",",
        "            \"submit_judgment\",",
        "            json!({\"determination\":{\"FIXME\":[]},\"rationale\":\"No gap identified.\"}),",
        "        )],",
        "    ] {",
        "        for stdout in [false, true] {",
        "            let server = Server::start(vec![reply(calls.clone())]);",
        "            let fixture = Fixture::new(&server.endpoint);",
        "            let mut args = vec![\"author-evidence\", SUBJECT];",
        "            if stdout {",
        "                args.push(\"--stdout\");",
        "            }",
        "            let output = fixture.run(&args);",
        "            assert!(!output.status.success());",
        "            assert!(output.stdout.is_empty());",
        "            server.finish();",
        "            assert_eq!(",
        "                fs::read_to_string(&fixture.evidence).unwrap(),",
        "                fixture.original",
        "            );",
        "            let usage = fixture.usage();",
        "            assert_eq!(usage[\"outcome\"], \"failed\");",
        "            assert_eq!(",
        "                usage[\"evidence_output\"],",
        "                if stdout { \"stdout\" } else { \"file\" }",
        "            );",
        "            assert_eq!(usage[\"evidence_written\"], false);",
        "            assert_eq!(usage[\"request_count\"], 1);",
        "            assert!(usage[\"determination\"].is_null());",
        "        }",
        "    }",
        "}"
      ]
    }
  ]
}
