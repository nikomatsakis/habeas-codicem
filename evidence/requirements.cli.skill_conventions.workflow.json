        "```yaml",
        "language: markdown",
        "paths: [assets/skills]",
        "rule:",
        "  kind: minus_metadata",
        "match:",
        "  - \"---\\nname: example\\n---\\n\\n# Example\\n\"",
        "no_match:",
        "  - \"# Example\\n\"",
        "```",
        ":::",
