{
  "requirement": "A dedicated GitHub Actions workflow MUST run release-plz on pushes to `main` to create release pull requests and publish approved versions. Publishing MUST require a merged release-plz pull request. The release job MUST request an OIDC token for crates.io trusted publishing, and both jobs MUST use a GitHub token from a repository secret so release pull requests can trigger the normal pull request checks.",
  "determination": true,
  "rationale": "The dedicated workflow runs release-plz release and release-pr on main pushes, requests OIDC permission for publishing, and passes the RELEASE_PLZ_TOKEN secret to both commands and checkout so release PRs can trigger CI. The config limits publishing to merged release-plz PRs. README.md documents the external GitHub and crates.io settings.",
  "inputs": [
    {
      "file": ".github/workflows/release-plz.yml",
      "line_start": 1,
      "line_end": 52,
      "text": [
        "name: Release-plz",
        "",
        "on:",
        "  push:",
        "    branches:",
        "      - main",
        "",
        "jobs:",
        "  release-plz-release:",
        "    name: Release-plz release",
        "    runs-on: ubuntu-latest",
        "    if: ${{ github.repository_owner == 'nikomatsakis' }}",
        "    permissions:",
        "      contents: write",
        "      id-token: write",
        "    steps:",
        "      - &checkout",
        "        name: Checkout repository",
        "        uses: actions/checkout@v6",
        "        with:",
        "          fetch-depth: 0",
        "          persist-credentials: true",
        "          token: ${{ secrets.RELEASE_PLZ_TOKEN }}",
        "      - &install-rust",
        "        name: Install Rust toolchain",
        "        uses: dtolnay/rust-toolchain@stable",
        "      - name: Run release-plz",
        "        uses: release-plz/action@v0.5",
        "        with:",
        "          command: release",
        "        env:",
        "          GITHUB_TOKEN: ${{ secrets.RELEASE_PLZ_TOKEN }}",
        "",
        "  release-plz-pr:",
        "    name: Release-plz PR",
        "    runs-on: ubuntu-latest",
        "    if: ${{ github.repository_owner == 'nikomatsakis' }}",
        "    permissions:",
        "      pull-requests: write",
        "      contents: write",
        "    concurrency:",
        "      group: release-plz-${{ github.ref }}",
        "      cancel-in-progress: false",
        "    steps:",
        "      - *checkout",
        "      - *install-rust",
        "      - name: Run release-plz",
        "        uses: release-plz/action@v0.5",
        "        with:",
        "          command: release-pr",
        "        env:",
        "          GITHUB_TOKEN: ${{ secrets.RELEASE_PLZ_TOKEN }}"
      ]
    },
    {
      "file": "release-plz.toml",
      "line_start": 1,
      "line_end": 2,
      "text": [
        "[workspace]",
        "release_always = false"
      ]
    },
    {
      "file": ".github/workflows/ci.yml",
      "line_start": 3,
      "line_end": 6,
      "text": [
        "on:",
        "  push:",
        "    branches: [main]",
        "  pull_request:"
      ]
    }
  ]
}
