        "// {impl}`requirements.authoring.file_discovery`",
        "// {impl}`requirements.authoring.text_search`",
        "fn optional_path(args: &Map<String, Value>) -> Result<&str, String> {",
        "    if args.contains_key(\"path\") {",
        "        string(args, \"path\")",
        "    } else {",
        "        Ok(\".\")",
        "    }",
        "}"
      ]
