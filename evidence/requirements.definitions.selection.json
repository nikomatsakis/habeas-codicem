      "rust_item": "fn[preprocess_book]",
      "text": [
        "// {impl}`requirements.cli.mdbook`",
        "// {impl}`requirements.examples.definition`",
        "// {impl}`requirements.definitions.declaration`",
        "// {impl}`requirements.definitions.references`",
        "// {impl}`requirements.definitions.selection`",
        "pub fn preprocess_book(book: &mut Book, root: &Path) -> io::Result<()> {",
        "    let mut definitions = BTreeMap::new();",
        "    for chapter in book.chapters() {",
        "        let Some(source_path) = chapter.source_path.as_deref().or(chapter.path.as_deref()) else {",
        "            continue;",
        "        };",
        "        let Some(render_path) = chapter.path.as_deref() else {",
        "            continue;",
        "        };",
        "        let namespace = chapter_namespace(source_path);",
        "        for block in definition_blocks(&chapter.content) {",
        "            if !block.closed {",
        "                continue;",
        "            }",
        "            let name = full_requirement_name(&namespace, &block.name);",
        "            definitions.entry(name).or_insert_with(|| Definition {",
        "                path: render_path.to_path_buf(),",
        "                text: chapter.content[block.body_start..block.body_end]",
        "                    .trim()",
        "                    .to_owned(),",
        "                kind: block.kind,",
        "            });",
        "        }",
        "    }",
        "    let evidence_definitions = definitions",
        "        .iter()",
        "        .filter(|(_, d)| d.kind != DefinitionKind::Term)",
        "        .map(|(name, d)| {",
        "            (",
        "                name.clone(),",
        "                Definition {",
        "                    path: d.path.clone(),",
        "                    text: d.text.clone(),",
        "                    kind: d.kind,",
        "                },",
        "            )",
        "        })",
        "        .collect();",
        "    let index = index::IndexPlan::find(book, &evidence_definitions)?;",
        "    if let Some(plan) = index.as_ref() {",
        "        plan.populate(book, root, &evidence_definitions)?;",
        "    }",
        "",
        "    // {impl}`requirements.index.source_links`",
        "    book.for_each_chapter_mut(|chapter| {",
        "        if chapter.source_path.is_none()",
        "            || chapter",
        "                .path",
        "                .as_deref()",
        "                .is_some_and(|path| index.as_ref().is_some_and(|plan| plan.is_detail_path(path)))",
        "        {",
        "            if let Some(path) = chapter.path.as_deref() {",
        "                chapter.content = replace_references(&chapter.content, path, &definitions);",
        "            }",
        "            return;",
        "        }",
        "        let namespace = chapter",
        "            .source_path",
        "            .as_deref()",
        "            .or(chapter.path.as_deref())",
        "            .map(chapter_namespace)",
        "            .unwrap_or_default();",
        "        chapter.content = replace_definitions(",
        "            &chapter.content,",
        "            &namespace,",
        "            chapter.path.as_deref(),",
        "            index.as_ref(),",
        "        );",
        "        if let Some(path) = chapter.path.as_deref() {",
        "            chapter.content = replace_references(&chapter.content, path, &definitions);",
        "        }",
        "    });",
        "    Ok(())",
        "}"
      ]
    },
    {
      "rust_file": "src/terms.rs",
      "rust_item": "fn[dependencies]",
      "text": [
        "// {impl}`requirements.definitions.dependencies`",
        "// {impl}`requirements.definitions.selection`",
        "pub(crate) fn dependencies(",
        "    declarations: &BTreeMap<String, Declaration>,",
        "    record: &Map<String, Value>,",
        "    subject: Option<&str>,",
        ") -> Result<BTreeSet<String>, String> {",
        "    let mut pending = BTreeSet::new();",
        "    if let Some(text) = subject {",
        "        referenced_terms(text, true, &mut pending);",
        "    }",
        "    if let Some(inputs) = record.get(\"inputs\").and_then(Value::as_array) {",
        "        for input in inputs {",
        "            let Some(selector) = InputSelector::from_input(input) else {",
        "                continue;",
        "            };",
        "            let Some(lines) = input.get(\"text\").and_then(Value::as_array) else {",
        "                continue;",
        "            };",
        "            let text = lines",
        "                .iter()",
        "                .filter_map(Value::as_str)",
        "                .collect::<Vec<_>>()",
        "                .join(\"\\n\");",
        "            match selector {",
        "                InputSelector::Definition { definition } => {",
        "                    pending.insert(definition);",
        "                }",
        "                InputSelector::RustItem { .. } => {",
        "                    for range in crate::rust_coverage::comments(&text) {",
        "                        referenced_terms(&text[range], false, &mut pending);",
        "                    }",
        "                }",
        "                InputSelector::FileRange { file, .. } if file.ends_with(\".rs\") => {",
        "                    for range in crate::rust_coverage::comments(&text) {",
        "                        referenced_terms(&text[range], false, &mut pending);",
        "                    }",
        "                }",
        "                InputSelector::FileRange { file, .. } => {",
        "                    referenced_terms(&text, file.ends_with(\".md\"), &mut pending)",
        "                }",
        "                InputSelector::Requirements { .. } => {",
        "                    // Scan bodies, not the surrounding colon fences: Markdown code",
        "                    // protection must be evaluated in the declaration's own context.",
        "                    for block in crate::definition_blocks(&text) {",
        "                        referenced_terms(",
        "                            &text[block.body_start..block.body_end],",
        "                            true,",
        "                            &mut pending,",
        "                        );",
        "                    }",
        "                }",
        "            }",
        "        }",
        "    }",
        "    let mut required = BTreeSet::new();",
        "    while let Some(name) = pending.pop_first() {",
        "        if !required.insert(name.clone()) {",
        "            continue;",
        "        }",
        "        let definition = declarations",
        "            .get(&name)",
        "            .filter(|d| d.kind == DefinitionKind::Term)",
        "            .ok_or_else(|| format!(\"term {name}: no matching named definition\"))?;",
        "        let (_, body) = declaration(&definition.text)?;",
        "        referenced_terms(body, true, &mut pending);",
        "    }",
        "    Ok(required)",
        "}"
      ]
    },
