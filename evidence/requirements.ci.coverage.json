      "rust_item": "fn[files_with_extension]",
      "text": [
        "// {impl}`requirements.ci.coverage`",
        "fn files_with_extension(",
        "    root: &Path,",
        "    dir: &Path,",
        "    extension: &str,",
        "    errors: &mut Vec<String>,",
        ") -> Vec<PathBuf> {",
        "    let mut stack = vec![dir.to_path_buf()];",
        "    let mut files = Vec::new();",
        "",
        "    while let Some(directory) = stack.pop() {",
        "        let entries = match fs::read_dir(&directory) {",
        "            Ok(entries) => entries,",
        "            Err(error) => {",
        "                errors.push(format!(",
        "                    \"{}: cannot list directory: {error}\",",
        "                    display_path(root, &directory)",
        "                ));",
        "                continue;",
        "            }",
        "        };",
        "        for entry in entries {",
        "            let entry = match entry {",
        "                Ok(entry) => entry,",
        "                Err(error) => {",
        "                    errors.push(format!(",
        "                        \"{}: cannot read directory entry: {error}\",",
        "                        display_path(root, &directory)",
        "                    ));",
        "                    continue;",
        "                }",
        "            };",
        "            let path = entry.path();",
        "            let kind = match entry.file_type() {",
        "                Ok(kind) => kind,",
        "                Err(error) => {",
        "                    errors.push(format!(",
        "                        \"{}: cannot inspect file: {error}\",",
        "                        display_path(root, &path)",
        "                    ));",
        "                    continue;",
        "                }",
        "            };",
        "            if kind.is_dir() {",
        "                stack.push(path);",
        "            } else if kind.is_file() && path.extension().is_some_and(|value| value == extension) {",
        "                files.push(path);",
        "            }",
        "        }",
        "    }",
        "    files.sort();",
        "    files",
        "}"
      ]
    },
