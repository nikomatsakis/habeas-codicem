        "#[test]",
        "fn setup_rejects_invalid_book_configuration() {",
        "    let temp = fixture();",
        "    let project = temp.path();",
        "    let binary = env!(\"CARGO_BIN_EXE_habeas\");",
        "",
        "    for (book, expected) in [",
        "        (",
        "            \"[book]\\nsrc = \\\"../outside\\\"\\n\",",
