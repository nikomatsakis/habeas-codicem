        "            .args([\"setup\", \"--path\", env!(\"CARGO_MANIFEST_DIR\")])",
        "            .current_dir(project)",
        "            .env(\"CARGO_NET_OFFLINE\", \"true\")",
        "            .output()",
        "            .unwrap();",
        "        assert!(!output.status.success());",
        "        assert!(",
        "            String::from_utf8_lossy(&output.stderr).contains(expected),",
        "            \"{:?}: {}\",",
        "            book,",
