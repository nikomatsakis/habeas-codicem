        "pub(crate) fn project_root() -> Result<PathBuf, Box<dyn Error>> {",
        "    let cwd = std::env::current_dir()?;",
        "    find_project_root(&cwd)",
        "        .ok_or_else(|| \"cannot find a project with Cargo.toml and book.toml\".into())",
        "}"
