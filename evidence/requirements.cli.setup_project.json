      "text": [
        "// {impl}`requirements.cli.setup_project`",
        "pub(crate) fn project_root(require_book: bool) -> Result<PathBuf, Box<dyn Error>> {",
        "    let cwd = std::env::current_dir()?;",
        "    cwd.ancestors()",
        "        .find(|directory| {",
        "            directory.join(\"Cargo.toml\").is_file()",
        "                && (!require_book || directory.join(\"book.toml\").is_file())",
        "        })",
        "        .map(Path::to_path_buf)",
        "        .ok_or_else(|| {",
        "            if require_book {",
        "                \"cannot find a project with Cargo.toml and book.toml\".into()",
        "            } else {",
        "                \"cannot find a Cargo project\".into()",
        "            }",
        "        })",
        "}"
      ]
    },
    {
      "file": "src/setup.rs",
      "line_start": 53,
      "line_end": 67,
      "text": [
        "    // {impl}`requirements.cli.setup_project`",
        "    let source = book[\"book\"][\"src\"].as_str().unwrap_or(\"src\").to_owned();",
        "    let source_path = Path::new(&source);",
        "    if source.is_empty()",
        "        || !source_path",
        "            .components()",
        "            .all(|part| matches!(part, Component::Normal(_) | Component::CurDir))",
        "    {",
        "        return Err(\"book.src must be a directory inside this project\".into());",
        "    }",
        "    let source_dir = root.join(source_path);",
        "    if !source_dir.join(\"SUMMARY.md\").is_file() {",
        "        return Err(format!(\"cannot find mdBook SUMMARY.md in {}\", source_dir.display()).into());",
        "    }",
        ""
      ]
    },
    {
      "file": "tests/setup.rs",
      "line_start": 120,
      "line_end": 164,
      "text": [
        "// {test}`requirements.cli.setup_project`",
        "// {test}`requirements.cli.setup_css`",
        "#[test]",
        "fn setup_rejects_invalid_book_configuration() {",
        "    let temp = fixture();",
        "    let project = temp.path();",
        "    let binary = env!(\"CARGO_BIN_EXE_habeas\");",
        "",
        "    for (book, expected) in [",
        "        (",
        "            \"[book]\\nsrc = \\\"../outside\\\"\\n\",",
        "            \"book.src must be a directory\",",
        "        ),",
        "        (",
        "            \"[book]\\nsrc = \\\"md\\\"\\n\\n[output.html]\\nadditional-css = \\\"wrong\\\"\\n\",",
        "            \"output.html.additional-css must be an array\",",
        "        ),",
        "    ] {",
        "        fs::write(project.join(\"book.toml\"), book).unwrap();",
        "        let output = Command::new(binary)",
        "            .args([\"setup\", \"--path\", env!(\"CARGO_MANIFEST_DIR\")])",
        "            .current_dir(project)",
        "            .env(\"CARGO_NET_OFFLINE\", \"true\")",
        "            .output()",
        "            .unwrap();",
        "        assert!(!output.status.success());",
        "        assert!(",
        "            String::from_utf8_lossy(&output.stderr).contains(expected),",
        "            \"{:?}: {}\",",
        "            book,",
        "            String::from_utf8_lossy(&output.stderr)",
        "        );",
        "    }",
        "",
        "    fs::write(project.join(\"book.toml\"), \"[book]\\nsrc = \\\"md\\\"\\n\").unwrap();",
        "    fs::remove_file(project.join(\"md/SUMMARY.md\")).unwrap();",
        "    let output = Command::new(binary)",
        "        .args([\"setup\", \"--path\", env!(\"CARGO_MANIFEST_DIR\")])",
        "        .current_dir(project)",
        "        .env(\"CARGO_NET_OFFLINE\", \"true\")",
        "        .output()",
        "        .unwrap();",
        "    assert!(!output.status.success());",
        "    assert!(String::from_utf8_lossy(&output.stderr).contains(\"cannot find mdBook SUMMARY.md\"));",
        "}"
      ]
    }
  ]
}
