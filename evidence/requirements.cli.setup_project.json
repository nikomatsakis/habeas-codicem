        "pub(crate) fn find_project_root(cwd: &Path) -> Option<PathBuf> {",
        "    cwd.ancestors()",
        "        .find(|directory| {",
        "            directory.join(\"Cargo.toml\").is_file() && directory.join(\"book.toml\").is_file()",
        "        })",
