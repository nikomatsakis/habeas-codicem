        "fn check_keys(",
        "    object: &Map<String, Value>,",
        "    expected: &[&str],",
        "    label: &str,",
        "    errors: &mut Vec<String>,",
        ") {",
        "    for key in object.keys() {",
        "        if !expected.contains(&key.as_str()) {",
        "            errors.push(format!(\"{label}: unexpected field {key:?}\"));",
        "        }",
        "    }",
        "}",
