        "// {impl}`requirements.ci.schema`",
        "#[derive(Clone, Debug, PartialEq, Eq)]",
        "pub(crate) enum InputSelector {",
        "    FileRange {",
        "        file: String,",
        "        line_start: usize,",
        "        line_end: usize,",
        "    },",
        "    RustItem {",
        "        rust_file: String,",
        "        rust_item: String,",
        "    },",
        "    Requirements {",
        "        requirements: String,",
        "    },",
        "}"
