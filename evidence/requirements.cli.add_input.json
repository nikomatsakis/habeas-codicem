    {
      "rust_file": "src/add_input.rs",
      "rust_item": "fn[read_or_new]",
      "text": [
        "// {impl}`requirements.cli.add_input`",
        "fn read_or_new(path: &Path, fallback: Value) -> io::Result<Value> {",
        "    match fs::read_to_string(path) {",
        "        Ok(source) => serde_json::from_str(&source)",
        "            .map_err(|error| invalid_input(format!(\"{}: invalid JSON: {error}\", path.display()))),",
        "        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(fallback),",
        "        Err(error) => Err(error),",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/add_input.rs",
      "rust_item": "fn[selectors_for_mode]",
      "text": [
        "// {impl}`requirements.cli.add_input`",
        "// {impl}`requirements.cli.add_input_file_range`",
        "// {impl}`requirements.cli.add_input_rust_item`",
        "// {impl}`requirements.cli.add_input_requirements`",
        "fn selectors_for_mode(root: &Path, mode: InputMode) -> io::Result<Vec<InputSelector>> {",
        "    match mode {",
        "        InputMode::FileRange(specification) => {",
        "            let (file, range) = specification.rsplit_once(':').ok_or_else(|| {",
        "                invalid_input(\"file range must have the form <file>:<start>-<end>\")",
        "            })?;",
        "            let (start, end) = range.split_once('-').ok_or_else(|| {",
        "                invalid_input(\"file range must have the form <file>:<start>-<end>\")",
        "            })?;",
        "            let line_start = start",
        "                .parse::<usize>()",
        "                .map_err(|_| invalid_input(\"file range start must be a positive integer\"))?;",
        "            let line_end = end",
        "                .parse::<usize>()",
        "                .map_err(|_| invalid_input(\"file range end must be a positive integer\"))?;",
        "            Ok(vec![InputSelector::FileRange {",
        "                file: file.to_owned(),",
        "                line_start,",
        "                line_end,",
        "            }])",
        "        }",
        "        InputMode::RustItemsAtLine(specification) => {",
        "            let (rust_file, line) = specification.rsplit_once(':').ok_or_else(|| {",
        "                invalid_input(\"Rust item location must have the form <rust-file>:<line>\")",
        "            })?;",
        "            let line = line",
        "                .parse::<usize>()",
        "                .map_err(|_| invalid_input(\"Rust item line must be a positive integer\"))?;",
        "            if !rust_file.ends_with(\".rs\") {",
        "                return Err(invalid_input(\"Rust item location requires a .rs file\"));",
        "            }",
        "            let (path, source) = read_project_file(root, rust_file).map_err(invalid_input)?;",
        "            let rust_file = path",
        "                .strip_prefix(root)",
        "                .unwrap()",
        "                .to_str()",
        "                .ok_or_else(|| invalid_input(\"Rust file path must be UTF-8\"))?;",
        "            let items = parse_items(&source).map_err(|error| {",
        "                invalid_input(format!(\"{rust_file}: cannot parse Rust source: {error}\"))",
        "            })?;",
        "            let selected = items",
        "                .into_iter()",
        "                .filter(|item| item.declaration_line == line)",
        "                .map(|item| InputSelector::RustItem {",
        "                    rust_file: rust_file.to_owned(),",
        "                    rust_item: item.selector,",
        "                })",
        "                .collect::<Vec<_>>();",
        "            if selected.is_empty() {",
        "                return Err(invalid_input(format!(",
        "                    \"{rust_file}:{line}: no Rust item is declared on this line\"",
        "                )));",
        "            }",
        "            Ok(selected)",
        "        }",
        "        InputMode::Requirements(requirements) => {",
        "            Ok(vec![InputSelector::Requirements { requirements }])",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/add_input.rs",
      "rust_item": "fn[update_inputs]",
      "text": [
        "// {impl}`requirements.cli.add_input`",
        "fn update_inputs(",
        "    record: &mut Value,",
        "    inputs: Vec<(InputSelector, Value, Vec<String>)>,",
        ") -> io::Result<(String, bool)> {",
        "    let Some(object) = record.as_object_mut() else {",
        "        return Err(invalid_input(\"evidence record must be a JSON object\"));",
        "    };",
        "    let Some(existing) = object.get_mut(\"inputs\").and_then(Value::as_array_mut) else {",
        "        return Err(invalid_input(\"evidence inputs must be an array\"));",
        "    };",
        "    let mut output = String::new();",
        "    let mut changed = false;",
        "    for (selector, input, matches) in inputs {",
        "        let position = existing",
        "            .iter()",
        "            .position(|old| InputSelector::from_input(old).as_ref() == Some(&selector));",
        "        let action = if let Some(position) = position {",
        "            if existing[position] == input {",
        "                \"unchanged\"",
        "            } else {",
        "                existing[position] = input;",
        "                changed = true;",
        "                \"refreshed\"",
        "            }",
        "        } else {",
        "            existing.push(input);",
        "            changed = true;",
        "            \"added\"",
        "        };",
        "        output.push_str(&format!(\"- {action}: {selector:?}\"));",
        "        if !matches.is_empty() {",
        "            output.push_str(&format!(\" matching {}\", matches.join(\", \")));",
        "        }",
        "        output.push('\\n');",
        "    }",
        "    if changed {",
        "        object.insert(\"determination\".to_owned(), Value::Bool(false));",
        "        object.insert(",
        "            \"rationale\".to_owned(),",
        "            Value::String(",
        "                \"Review pending: reassess the changed input, all applicable definitions and citations, and the behavior they jointly specify.\".to_owned(),",
        "            ),",
        "        );",
        "    }",
        "    Ok((output, changed))",
        "}"
      ]
    },
    {
      "rust_file": "src/inputs.rs",
      "rust_item": "impl[InputSelector]/fn[to_input]",
      "text": [
        "    // {impl}`requirements.cli.add_input`",
        "    pub(crate) fn to_input(&self, resolved: &ResolvedInput) -> Value {",
        "        match self {",
        "            Self::FileRange {",
        "                file,",
        "                line_start,",
        "                line_end,",
        "            } => json!({",
        "                \"file\": file,",
        "                \"line_start\": line_start,",
        "                \"line_end\": line_end,",
        "                \"text\": resolved.text,",
        "            }),",
        "            Self::RustItem {",
        "                rust_file,",
        "                rust_item,",
        "            } => json!({",
        "                \"rust_file\": rust_file,",
        "                \"rust_item\": rust_item,",
        "                \"text\": resolved.text,",
        "            }),",
        "            Self::Requirements { requirements } => json!({",
        "                \"requirements\": requirements,",
        "                \"matches\": resolved.matches,",
        "                \"text\": resolved.text,",
        "            }),",
        "        }",
        "    }"
      ]
    },
    {
      "rust_file": "src/main.rs",
      "rust_item": "fn[main]",
      "text": [
        "fn main() -> Result<(), Box<dyn Error>> {",
        "    // {impl}`requirements.cli.clap`",
        "    match Cli::parse().command {",
        "        // {impl}`requirements.cli.mdbook`",
        "        Command::Mdbook { command: None } => {",
        "            let (context, mut book) = mdbook_preprocessor::parse_input(io::stdin())?;",
        "            habeas::preprocess_book(&mut book, &context.root)?;",
        "            serde_json::to_writer(io::stdout().lock(), &book)?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.invocation`",
        "        Command::Mdbook {",
        "            command: Some(MdbookCommand::Supports { renderer }),",
        "        } => {",
        "            if renderer == \"html\" {",
        "                Ok(())",
        "            } else {",
        "                std::process::exit(1)",
        "            }",
        "        }",
        "        // {impl}`requirements.cli.setup`",
        "        Command::Setup { path } => setup::run(path.as_deref()),",
        "        // {impl}`requirements.cli.status`",
        "        Command::Status { all, glob } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout().lock().write_all(",
        "                habeas::status_markdown_filtered(&root, all, glob.as_deref())?.as_bytes(),",
        "            )?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.cli.info`",
        "        Command::Info { selector } => {",
        "            let root = setup::project_root()?;",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::info_markdown(&root, &selector)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "        // {impl}`requirements.integration.symposium_setup_hook`",
        "        Command::Hook {",
        "            command: HookCommand::SessionStart,",
        "        } => hook::session_start(),",
        "        // {impl}`requirements.cli.add_input`",
        "        Command::AddInput {",
        "            for_requirement,",
        "            for_example,",
        "            for_rust_item,",
        "            file_range,",
        "            rust_item,",
        "            requirements,",
        "        } => {",
        "            let root = setup::project_root()?;",
        "            let target = if let Some(name) = for_requirement {",
        "                habeas::InputTarget::Requirement(name)",
        "            } else if let Some(name) = for_example {",
        "                habeas::InputTarget::Example(name)",
        "            } else {",
        "                let parts = for_rust_item.expect(\"clap requires a target\");",
        "                habeas::InputTarget::RustFunction {",
        "                    rust_file: parts[0].clone(),",
        "                    rust_item: parts[1].clone(),",
        "                }",
        "            };",
        "            let mode = if let Some(specification) = file_range {",
        "                habeas::InputMode::FileRange(specification)",
        "            } else if let Some(specification) = rust_item {",
        "                habeas::InputMode::RustItemsAtLine(specification)",
        "            } else {",
        "                habeas::InputMode::Requirements(requirements.expect(\"clap requires an input mode\"))",
        "            };",
        "            io::stdout()",
        "                .lock()",
        "                .write_all(habeas::add_input(&root, target, mode)?.as_bytes())?;",
        "            Ok(())",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "tests/commands.rs",
      "rust_item": "fn[add_input_modes_capture_raw_sources_and_refresh_idempotently]",
      "text": [
        "// {test}`requirements.cli.add_input`",
        "// {test}`requirements.cli.add_input_file_range`",
        "// {test}`requirements.cli.add_input_rust_item`",
        "// {test}`requirements.cli.add_input_requirements`",
        "// {test}`requirements.references.selector_same_line`",
        "// {test}`requirements.references.selector_raw_lines`",
        "#[test]",
        "fn add_input_modes_capture_raw_sources_and_refresh_idempotently() {",
        "    let temp = TempDir::new().unwrap();",
        "    fs::create_dir_all(temp.path().join(\"md\")).unwrap();",
        "    fs::create_dir_all(temp.path().join(\"src\")).unwrap();",
        "    fs::write(",
        "        temp.path().join(\"Cargo.toml\"),",
        "        \"[package]\\nname = \\\"fixture\\\"\\n\",",
        "    )",
        "    .unwrap();",
        "    fs::write(temp.path().join(\"book.toml\"), \"[book]\\nsrc = \\\"md\\\"\\n\").unwrap();",
        "    fs::write(",
        "        temp.path().join(\"md/rules.md\"),",
        "        \":::{req} ready\\nReady.\\n:::\\n\\n:::{example} case\\nGiven ready, it works. CITE`rules.ready`\\n:::\\n\".replace(\"CITE\", \"{cite}\"),",
        "    )",
        "    .unwrap();",
        "    fs::write(",
        "        temp.path().join(\"src/main.rs\"),",
        "        \"/// user docs\\n#[allow(dead_code)]\\n// IMPL`rules.ready`\\nfn main() { fn nested() {} }\\n\"",
        "            .replace(\"IMPL\", \"{impl}\"),",
        "    )",
        "    .unwrap();",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--file-range\",",
        "            \"src/main.rs:1-2\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--rust-item\",",
        "            \"src/main.rs:4\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let stdout = String::from_utf8(output.stdout).unwrap();",
        "    assert!(stdout.contains(\"fn[main]\"), \"{stdout}\");",
        "    assert!(stdout.contains(\"fn[main]/fn[nested]\"), \"{stdout}\");",
        "    let requirement_path = temp.path().join(\"evidence/rules.ready.json\");",
        "    let first = fs::read(&requirement_path).unwrap();",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--rust-item\",",
        "            \"src/main.rs:4\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    assert!(String::from_utf8_lossy(&output.stdout).contains(\"unchanged\"));",
        "    assert_eq!(fs::read(&requirement_path).unwrap(), first);",
        "    let requirement: serde_json::Value = serde_json::from_slice(&first).unwrap();",
        "    assert_eq!(requirement[\"inputs\"].as_array().unwrap().len(), 3);",
        "    assert_eq!(",
        "        requirement[\"inputs\"][1][\"text\"],",
        "        json!([",
        "            \"/// user docs\",",
        "            \"#[allow(dead_code)]\",",
        "            \"// IMPL`rules.ready`\".replace(\"IMPL\", \"{impl}\"),",
        "            \"fn main() { fn nested() {} }\"",
        "        ])",
        "    );",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-example\",",
        "            \"rules.case\",",
        "            \"--requirements\",",
        "            \"rules.*\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let example: serde_json::Value =",
        "        serde_json::from_slice(&fs::read(temp.path().join(\"evidence/rules.case.json\")).unwrap())",
        "            .unwrap();",
        "    assert_eq!(",
        "        example[\"example\"],",
        "        \"Given ready, it works. CITE`rules.ready`\".replace(\"CITE\", \"{cite}\")",
        "    );",
        "    assert_eq!(",
        "        example[\"inputs\"][0][\"matches\"],",
        "        json!([\"rules.case\", \"rules.ready\"])",
        "    );",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--requirements\",",
        "            \"rules.*\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-rust-item\",",
        "            \"src/main.rs\",",
        "            \"fn[main]\",",
        "            \"--requirements\",",
        "            \"rules.*\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let stdout = String::from_utf8(output.stdout).unwrap();",
        "    assert!(stdout.contains(\"rules.case, rules.ready\"), \"{stdout}\");",
        "    assert!(stdout.contains(\"remains pending\"), \"{stdout}\");",
        "    let output = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-rust-item\",",
        "            \"src/main.rs\",",
        "            \"fn[main]\",",
        "            \"--rust-item\",",
        "            \"src/main.rs:4\",",
        "        ],",
        "    );",
        "    assert!(output.status.success(), \"{output:?}\");",
        "    let attestation: serde_json::Value = serde_json::from_slice(",
        "        &fs::read(temp.path().join(\"evidence/rust/src/main.rs.json\")).unwrap(),",
        "    )",
        "    .unwrap();",
        "    assert_eq!(attestation[\"functions\"][0][\"determination\"], false);",
        "    assert_eq!(",
        "        attestation[\"functions\"][0][\"citations\"],",
        "        json!([{\"role\": \"impl\", \"name\": \"rules.ready\"}])",
        "    );",
        "    assert_eq!(",
        "        attestation[\"functions\"][0][\"inputs\"]",
        "            .as_array()",
        "            .unwrap()",
        "            .len(),",
        "        3",
        "    );",
        "    assert_eq!(",
        "        attestation[\"functions\"][0][\"inputs\"][0][\"matches\"],",
        "        json!([\"rules.case\", \"rules.ready\"])",
        "    );",
        "    let detail = habeas(temp.path(), &[\"info\", \"rules.ready\"]);",
        "    assert!(detail.status.success(), \"{detail:?}\");",
        "    let detail = String::from_utf8(detail.stdout).unwrap();",
        "    assert!(",
        "        detail.contains(\"Rust item src/main.rs fn[main]\"),",
        "        \"{detail}\"",
        "    );",
        "    assert!(detail.contains(\"src/main.rs:1–4\"), \"{detail}\");",
        "    assert!(detail.contains(\"requirements glob rules.*\"), \"{detail}\");",
        "    assert!(detail.contains(\"md/rules.md:5–7\"), \"{detail}\");",
        "",
        "    let invalid = habeas(",
        "        temp.path(),",
        "        &[",
        "            \"add-input\",",
        "            \"--for-requirement\",",
        "            \"rules.ready\",",
        "            \"--requirements\",",
        "            \"missing.*\",",
        "        ],",
        "    );",
        "    assert!(!invalid.status.success());",
        "    assert!(String::from_utf8_lossy(&invalid.stderr).contains(\"matches no requirement or example\"));",
        "}"
      ]
    }
  ]
}
