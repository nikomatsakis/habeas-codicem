        "            .to_string(),",
        "        )",
        "        .unwrap();",
        "        let sources = AssessmentSources::prepare(root.path(), \"requirements.ready\").unwrap();",
        "        let inputs = sources.mandatory_inputs();",
        "        assert!(sources.recorded_inputs().is_empty());",
        "        assert!(",
        "            inputs",
