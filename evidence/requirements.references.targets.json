        "            \"Requirements\",",
        "            source,",
        "            \"requirements.md\",",
        "            Vec::new(),",
        "        ));",
        "        book.push_item(Chapter::new(",
        "            \"Guide\",",
        "            \"TEST`requirements.something.foo`\".replace(\"TEST\", \"{test}\"),",
        "            \"guides/deep.md\",",
        "            Vec::new(),",
        "        ));",
        "        preprocess_book(&mut book, Path::new(\".\")).unwrap();",
        "        let chapters = book.chapters().collect::<Vec<_>>();",
        "        assert!(",
        "            chapters[0]",
        "                .content",
        "                .contains(\"id=\\\"habeas-req-requirements.ready\\\"\")",
