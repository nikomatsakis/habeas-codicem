        "            \"{args:?}: {output:?}\"",
        "        );",
        "    }",
        "    for command in [\"info\", \"status\"] {",
        "        let invalid = habeas(temp.path(), &[command, \"[\"]);",
        "        assert!(!invalid.status.success());",
