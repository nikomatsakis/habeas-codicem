        "// {impl}`requirements.integration.report_api`",
        "#[derive(Debug)]",
        "pub struct EvidenceReport {",
        "    pub requirements: usize,",
        "    pub examples: usize,",
        "    pub evidence_files: usize,",
        "    pub errors: Vec<String>,",
        "}"
