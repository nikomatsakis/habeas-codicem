        "            Vec::new(),",
        "        ));",
        "        book.push_item(Chapter::new(",
        "            \"Guide\",",
        "            \"TEST`requirements.something.foo`\".replace(\"TEST\", \"{test}\"),",
        "            \"guides/deep.md\",",
        "            Vec::new(),",
        "        ));",
        "        let root = book_root();",
        "        preprocess_book(&mut book, root.path()).unwrap();",
        "        // Generated detail pages are titled by full name.",
        "        let chapters = book",
        "            .chapters()",
        "            .filter(|chapter| !chapter.name.contains('.'))",
        "            .collect::<Vec<_>>();",
        "        assert!(",
        "            chapters[0]",
