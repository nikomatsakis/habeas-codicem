        "fn replace_definitions(",
        "    content: &str,",
        "    namespace: &str,",
        "    current_path: Option<&Path>,",
        "    index: Option<&index::IndexPlan>,",
        ") -> String {",
        "    let mut result = String::with_capacity(content.len());",
        "    let mut cursor = 0;",
