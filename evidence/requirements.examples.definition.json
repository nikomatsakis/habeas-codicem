        "// {impl}`requirements.examples.definition`",
        "#[derive(Clone, Copy, Debug, PartialEq, Eq)]",
        "pub(crate) enum DefinitionKind {",
        "    Requirement,",
        "    Example,",
        "    Term,",
        "}"
      ]
