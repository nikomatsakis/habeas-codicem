        "fn text_field(",
        "    object: &Map<String, Value>,",
        "    label: &str,",
        "    errors: &mut Vec<String>,",
        ") -> Option<Vec<String>> {",
        "    let values = array_field(object, \"text\", label, errors)?;",
        "    if values.is_empty() {",
        "        errors.push(format!(\"{label}: text must be a nonempty array\"));",
